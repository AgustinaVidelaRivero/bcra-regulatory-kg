  "cla::5.1.1.1": {
   "unidad": "5.1.1.1",
   "titulo": "Los créditos para consumo o vivienda.",
   "paginas": [
    16
   ],
   "sha256_propio": "88cf5a437682880dfd9d92f76d648f0652d5896d4a3943cd6008c1867d0a9013",
   "texto_campo": "5.1.1.1. Los créditos para consumo o vivienda.\nLos créditos de esta clase que superen el equivalente a dos veces el importe de\nreferencia establecido en el punto 3.7. y cuyo repago no se encuentre vinculado\na ingresos fijos o periódicos del cliente sino a la evolución de su actividad pro-\nductiva o comercial se incluirán dentro de la cartera comercial.",
   "texto": "5.1.1.1. Los créditos para consumo o vivienda. Los créditos de esta clase que superen el equivalente a dos veces el importe de referencia establecido en el punto 3.7. y cuyo repago no se encuentre vinculado a ingresos fijos o periódicos del cliente sino a la evolución de su actividad productiva o comercial se incluirán dentro de la cartera comercial.",
   "palabras_reunidas": [
    "pro-ductiva → productiva"
   ]
  },
  "cla::3.7": {
   "unidad": "3.7",
   "titulo": "Importe de referencia.",
   "paginas": [
    14
   ],
   "sha256_propio": "a862e52384de2a535303bb8f678dad3f4605352dad3eb58bd4ea138f5055a222",
   "texto_campo": "3.7. Importe de referencia.\nEl importe a considerar será el nivel máximo del valor de ventas totales anuales para la\ncategoría “Micro” correspondiente al sector “Comercio” que determine la autoridad de\naplicación de la Ley 24.467 (y sus modificatorias).",
   "texto": "3.7. Importe de referencia. El importe a considerar será el nivel máximo del valor de ventas totales anuales para la categoría “Micro” correspondiente al sector “Comercio” que determine la autoridad de aplicación de la Ley 24.467 (y sus modificatorias).",
   "palabras_reunidas": []
  },
  "frase_resaltada": "dos veces el importe de referencia establecido en el punto 3.7."
 },
