*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific data — el corpus descargado (PDFs/HTMLs) NO se versiona.
# El patrón anterior `data/raw/*.pdf` sólo cubría el primer nivel; los PDFs
# viven en subdirectorios (02_comunicaciones_A/, etc.) — usar ** para cubrirlos.
# SÍ se versiona la metadata del corpus: manifiesto.csv, checkpoint.json, log.txt.
data/raw/**/*.pdf
data/raw/**/*.html
data/experiment/**/*.pdf
data/raw/_backups/
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Secrets
.env
.env.local
*.env

# Logs
*.log
logs/

# Distribution / packaging
*.egg-info/
dist/
build/

# Fase 2.3+ — salida del runner instrumentado: NO commitear el .db de la caché
# (crudos completos de la API) ni las trazas con razonamiento/tool calls.
data/experiment/evaluacion/cache/
data/experiment/evaluacion/posthoc_run/*
!data/experiment/evaluacion/posthoc_run/revision_prompt_v4/
