+                        "x0": round(unida.x0, 1), "tops": [round(x.top, 1) for x in g],
+                        "unidades_de_las_letras": sorted({_nombre_r5e(ubic[id(x)][0]) for x in g}),
+                        "unidad_destino": _nombre_r5e(dueno)})
