+            continue
+        for sg in t["segmentos"]:
+            zonas.setdefault(sg["pagina"], []).append((sg["bbox"][1] - TOL_TOP_TABLA, sg["bbox"][3] - TOL_TOP_TABLA))
+
+    def excluir(l) -> bool:
+        return any(y0 <= l.top <= y1 for y0, y1 in zonas.get(l.pagina, ()))
+    return excluir
