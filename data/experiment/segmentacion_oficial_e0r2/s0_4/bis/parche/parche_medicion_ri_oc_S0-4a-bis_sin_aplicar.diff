+def _sin_regimen_pagina_1(lim: list) -> list:
+    reg = next((b["prefijo"] for b in lim if b["forma"] == "regimen" and b["pagina"] == 1), None)
+    if reg is None:
+        return lim
+    out = []
+    for b in lim:
+        if b["forma"] == "regimen" and b["pagina"] == 1:
+            continue
+        b = dict(b)
+        if b["prefijo"].startswith(reg):
+            b["prefijo"] = b["prefijo"][len(reg):]
+        if b["padre"] == reg:
+            b["padre"] = None
+        elif b["padre"] is not None and b["padre"].startswith(reg):
+            b["padre"] = b["padre"][len(reg):]
+        out.append(b)
+    return out
