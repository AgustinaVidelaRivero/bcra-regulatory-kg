+def _rotulo_de_celda_r9(fila: list):
+    m = RE_CELDA_ROTULO_R9.match((fila[0] or "").strip()) if fila else None
+    return m if m and int(m.group(1).split(".")[0]) <= E0.MAX_RAIZ else None
+
