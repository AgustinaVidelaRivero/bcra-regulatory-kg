+            for s in n.segmentos:
+                quedan = [l for l in s if _pos(l) < pos]
+                van = [l for l in s if _pos(l) >= pos and l is not d.linea_label]
+                if quedan:
+                    nuevos.append(quedan)
+                if van:
+                    movidos.append(van)
