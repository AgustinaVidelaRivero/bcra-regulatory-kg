+def _texto_banda_a(renglones: list[str]) -> list[str]:
+    """A de S0-6a: los renglones de la banda sin «B.C.R.A.» (la línea que E0 leyó como sección no se registra)."""
+    out = []
+    for t in renglones:
+        t = re.sub(r"\bB\.C\.R\.A\.", "", t).strip()
+        if t:
+            out.append(" ".join(t.split()))
+    return out
