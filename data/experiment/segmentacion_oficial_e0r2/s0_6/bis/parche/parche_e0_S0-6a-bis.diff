+            if h is t or h.hijos or h.tipo != "punto":
+                continue
+            lh = _lineas_item_116(h)
+            medidas += [l.x0 for l in (lh[1:] if _con_rotulo_116(h, lh) else lh) if l.ngaps == 0]
