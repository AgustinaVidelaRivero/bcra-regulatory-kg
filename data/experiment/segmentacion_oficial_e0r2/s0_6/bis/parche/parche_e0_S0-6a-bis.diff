+            # S0-6a-bis: un párrafo del grupo no comparte columna (D21, regla 3: decide el contenido): no sale ninguno
+            eventos.append({"tipo": "grupo_sin_columna_comun_c", "de": _nombre_c(t), "pagina": grupo[0][0].pagina,
