    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Prohibición de crear expectativa de recompra",
      "properties": {
        "descripcion": "Para que una acción sea considerada dentro del CO la entidad financiera se debe abstener de crear, en ocasión de su emisión, cualquier expectativa de que la acción será recomprada, rescatada o amortizada, y los términos contractuales no deberán contener cláusula alguna que pudiera originar tal expectativa.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Suscripción de instrumentos capital",
      "properties": {
        "tipo": "suscripción e integración de instrumentos capital"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Instrumentos deben estar suscritos e integrados",
      "properties": {
        "descripcion": "Estar totalmente suscriptos e integrados.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Subordinación a depositantes y acreedores",
      "properties": {
        "descripcion": "Estar subordinados a depositantes, acreedores quirografarios y a deuda subordinada de la entidad financiera.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Prohibición de aseguración y garantía",
      "properties": {
        "descripcion": "No estar asegurados ni cubiertos por alguna garantía del emisor o de un vinculado, ni ser objeto de cualquier otro acuerdo que mejore jurídica o económicamente el orden de prelación en el cobro para el caso de quiebra de la entidad.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res5",
      "type": "Restriccion",
      "label": "Prohibición de pago de capital anticipado",
      "properties": {
        "descripcion": "No prever pago de ningún tipo en concepto de capital, excepto en caso de liquidación de la entidad, cuando así correspondiese. No podrán tener cláusulas de remuneración escalonada creciente ni otros incentivos para su amortización anticipada.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Rescate de instrumentos capital",
      "properties": {
        "tipo": "rescate de instrumentos capital"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Obtener autorización para rescate",
      "properties": {
        "descripcion": "La entidad financiera podrá rescatarlos –transcurridos un mínimo de cinco años desde su emisión–, siempre que cuente con autorización de la SEFyC en forma previa al ejercicio de la opción de compra.",
        "tipo": "otra",
        "plazo": "transcurridos mínimo 5 años desde emisión"
      }
    },
    {
      "local_id": "res6",
      "type": "Restriccion",
      "label": "Prohibición de generar expectativa de rescate",
      "properties": {
        "descripcion": "Se abstenga de generar expectativas de que ejercitará la opción de compra.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Sustituir instrumento o demostrar solvencia",
      "properties": {
        "descripcion": "Sustituya el instrumento con capital regulatorio de igual o mayor calidad y en condiciones que sean sostenibles para su capacidad de generación de ingresos, o demuestre que –una vez ejercida la opción de compra– su RPC supera ampliamente –al menos en un 20 %– los requerimientos mínimos de capital.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Obtener autorización para restitución",
      "properties": {
        "descripcion": "Cualquier restitución de capital requerirá la autorización previa de la SEFyC y la entidad financiera no deberá tener la expectativa ni crearla en el mercado de que obtendrá dicha autorización.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Discrecionalidad en pago de dividendos",
      "properties": {
        "descripcion": "La entidad financiera podrá –en todo momento y a su entera discreción– cancelar pagos en concepto de dividendos o intereses.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "res7",
      "type": "Restriccion",
      "label": "Prohibición de aseguración de instrumentos",
      "properties": {
        "descripcion": "No haber sido comprados por la entidad financiera –ni por alguna entidad que ella controle o sobre la que ejerza influencia significativa–.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res8",
      "type": "Restriccion",
      "label": "Prohibición de financiación de compra",
      "properties": {
        "descripcion": "No haber sido comprados con la financiación directa o indirecta de la entidad financiera.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res9",
      "type": "Restriccion",
      "label": "Prohibición de características dificultosas",
      "properties": {
        "descripcion": "No poseer características que dificulten la recapitalización, tales como requerir que la entidad financiera compense al inversor si se emite un nuevo instrumento a un precio menor durante un período de tiempo especificado.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Absorción de pérdidas al nivel de CO",
      "properties": {
        "descripcion": "Los instrumentos que son parte del pasivo deberán absorber pérdidas cuando el coeficiente de CO sea inferior al 5,125 % de los APR a través de su conversión en acciones ordinarias o mediante un mecanismo que asigne pérdidas en forma definitiva al instrumento.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Conversión en acciones ordinarias",
      "properties": {
        "tipo": "conversión de instrumentos en acciones ordinarias"
      }
    },
    {
      "local_id": "res10",
      "type": "Restriccion",
      "label": "Prohibición de dividendo ajustable por riesgo",
      "properties": {
        "descripcion": "No incorporar un dividendo/cupón que se reajuste periódicamente en función, en todo o en parte, del riesgo de crédito de la entidad financiera.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res11",
      "type": "Restriccion",
      "label": "Plazo mínimo de vencimiento",
      "properties": {
        "descripcion": "Plazo de vencimiento original no inferior a cinco años.",
        "tipo": "limite_cuantitativo",
        "umbral": "5 años"
      }
    },
    {
      "local_id": "res12",
      "type": "Restriccion",
      "label": "Prohibición de incentivos de amortización",
      "properties": {
        "descripcion": "No existir cláusulas de remuneración escalonada creciente u otros incentivos para su amortización anticipada.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res13",
      "type": "Restriccion",
      "label": "Disminución de monto computable",
      "properties": {
        "descripcion": "A partir del comienzo de cada uno de los últimos cinco años de vida de cada emisión, el importe computable será disminuido en el 20 % del valor nominal emitido.",
        "tipo": "limite_cuantitativo",
        "umbral": "20%"
      }
    },
    {
      "local_id": "res14",
      "type": "Restriccion",
      "label": "Prohibición de aceleración de devolución",
      "properties": {
        "descripcion": "El inversor no tendrá ningún derecho a acelerar la devolución de los pagos futuros previstos (cupón de renta o amortización), excepto en caso de quiebra o liquidación.",
        "tipo": "prohibicion"
      }
    }
