      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Informar CRO mensualmente",
      "properties": {
        "descripcion": "Se determinará mensualmente la exigencia de capital por riesgo operacional (CRO) mediante la expresión CRO = BIC x ILM para entidades del Grupo 1",
        "tipo": "presentacion_informativa",
        "plazo": "mensual"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Informar componentes BIC",
      "properties": {
        "descripcion": "La partida correspondiente al BIC se informará por el importe calculado en función de los coeficientes marginales que corresponda",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Informar términos 3 componentes",
      "properties": {
        "descripcion": "Cada término dentro de los 3 componentes y el resultado monetario debe ser informado, respecto de cada uno de los 3 períodos de 12 meses, reexpresados por inflación",
        "tipo": "presentacion_informativa",
        "plazo": "períodos de 12 meses"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Reexpresar saldos por inflación",
      "properties": {
        "descripcion": "En cuanto a los activos que generan intereses, será el importe que surja de reexpresar los saldos al cierre de cada uno de los 3 períodos de 12 meses, desde esa fecha hasta el cierre del período de cálculo de los 36 meses (n-1)",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Determinar partidas netas períodos",
      "properties": {
        "descripcion": "Primero se debe determinar el valor de las partidas netas que correspondan (por ejemplo, ingresos menos egresos) para cada período de 12 meses consecutivos y después se calcula el promedio de los 3 períodos",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Determinar CRO mensualmente Grupo 2",
      "properties": {
        "descripcion": "Se determinará mensualmente por la expresión: CRO = (a*IB) / n, donde a es 15%, n es número de períodos de 12 meses consecutivos con IB positivo, máximo 3",
        "tipo": "calculo",
        "plazo": "mensual"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Máximo períodos IB positivo Grupo 2",
      "properties": {
        "descripcion": "Número de períodos de 12 meses consecutivos en los cuales el IB es positivo, tomando en cuenta los últimos 36 meses anteriores al mes de cálculo. Máximo de n = 3",
        "tipo": "limite_cuantitativo",
        "umbral": "3"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Límite reducción exigencia Grupo A",
      "properties": {
        "descripcion": "Se informará la correspondiente reducción de exigencia cuando los límites aplicables sobre el promedio de las exigencias por riesgo crediticio de los 36 meses anteriores resulte inferior al informado en el código 70300000, con porcentaje de 20% para Grupo A",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Límite reducción exigencia Grupo B",
      "properties": {
        "descripcion": "Límite de reducción para entidades del Grupo B: 17% en condición general, 11% o 7% en condiciones especiales según calificación",
        "tipo": "limite_cuantitativo",
        "umbral": "17%"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Límite reducción exigencia Grupo C",
      "properties": {
        "descripcion": "Límite de reducción para entidades del Grupo C: 14% en condición general, 8% o 5% en condiciones especiales según calificación",
        "tipo": "limite_cuantitativo",
        "umbral": "14%"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción N=0 Grupo 2",
      "properties": {
        "descripcion": "Si n = 0 (ningún período con IB positivo), deberá observarse una exigencia equivalente al límite previsto en el punto 7.3 de las normas sobre Capitales mínimos de las entidades financieras"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción G-SIB para reducción",
      "properties": {
        "descripcion": "La presente reducción de exigencia no rige para entidades del Grupo 2 que sean subsidiarias o sucursales de entidades de importancia sistémica global (G-SIB)"
      }
    }
  ],
