    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Calcular posición abierta neta",
      "properties": {
        "tipo": "calculo",
        "description": "La posición abierta neta en cada moneda se calculará como la suma de la posición neta al contado, posición neta a plazo, garantías otorgadas, ingresos y egresos futuros netos cubiertos, y equivalente delta neto de cartera de opciones sobre divisas"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Cuantificar exposición por moneda",
      "properties": {
        "tipo": "calculo",
        "description": "El cálculo de la exigencia de capital por riesgo de tipo de cambio requiere primero cuantificar la exposición en cada moneda y luego estimar los riesgos inherentes a la combinación de posiciones compradas y vendidas en diferentes monedas"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Incluir intereses devengados posición",
      "properties": {
        "tipo": "calculo",
        "description": "Los intereses y otros ingresos devengados a cobrar y a pagar se incluirán en la posición, ya sea que correspondan a instrumentos de la cartera de negociación o de inversión"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Adoptar decisión ingresos egresos futuros",
      "properties": {
        "tipo": "otra",
        "description": "La decisión de incluir ingresos y egresos futuros se deberá adoptar de modo consistente, ya que no se permitirá seleccionar sólo los flujos futuros esperados que reduzcan la posición"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Valuación posiciones a término",
      "properties": {
        "tipo": "calculo",
        "description": "Las posiciones a término en moneda extranjera y en oro se valuarán a los tipos de cambio de contado corrientes en el mercado, salvo que la entidad emplee para la gestión de dichas posiciones el valor actual neto, en cuyo caso se utilizarán las tasas de interés y los tipos de cambio de contado corrientes"
      }
    },
    {
      "local_id": "oblig6",
      "type": "Obligacion",
      "label": "Vigilar correspondencia límites posiciones",
      "properties": {
        "tipo": "otra",
        "description": "Las entidades deberán proveer evidencia de que permanentemente vigilan la correspondencia entre los límites y las posiciones reales"
      }
    },
    {
      "local_id": "oblig7",
      "type": "Obligacion",
      "label": "Convertir posiciones netas a pesos",
      "properties": {
        "tipo": "calculo",
        "description": "El importe nominal o el valor actual neto de la posición neta en cada moneda y en oro se convertirá a pesos al tipo de cambio de contado, utilizando el tipo de cambio de referencia del dólar estadounidense difundido por esta Institución"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Exclusión flujos seleccionados reducción posición",
      "properties": {
        "tipo": "prohibicion",
        "description": "No se permitirá seleccionar sólo los flujos futuros esperados que reduzcan la posición"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Capital mínimo riesgo tipo cambio",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "8%",
        "description": "La exigencia de capital será el 8% de la posición neta total"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Exclusión ingresos egresos futuros no devengados",
      "properties": {
        "description": "Las entidades podrán excluir los ingresos y egresos futuros esperados pero aún no devengados salvo que las cantidades sean ciertas y las hayan cubierto"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Exclusión posiciones deducibles patrimonio",
      "properties": {
        "description": "Para determinar el importe de la posición abierta neta en cada moneda extranjera las entidades podrán excluir las posiciones comprendidas en las partidas deducibles para determinar la responsabilidad patrimonial computable"
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Sustitución posiciones no significativas",
      "properties": {
        "description": "A los efectos de la consolidación, las posiciones no significativas de las sucursales y subsidiarias en el exterior podrán sustituirse por el límite que la entidad haya fijado internamente para cada moneda"
      }
    },
    {
      "local_id": "exc4",
      "type": "Excepcion",
      "label": "Valor actual neto en gestión posiciones",
      "properties": {
        "description": "Las posiciones a término en moneda extranjera y en oro se valuarán a los tipos de cambio de contado corrientes en el mercado, salvo que la entidad emplee para la gestión de dichas posiciones el valor actual neto"
      }
    }
