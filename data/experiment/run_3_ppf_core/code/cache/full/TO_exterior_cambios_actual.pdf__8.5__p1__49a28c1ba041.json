    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Contar con documentación de despacho",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "Factura o factura proforma del proveedor del bien importado temporariamente, por el monto del despacho a plaza correspondiente, en la que conste que el bien fue enviado sin cargo"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Contar con certificación de afectación",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "La certificación de afectación emitida por la entidad encargada del seguimiento en el SEPAIMPO (Sección 11.) del despacho de importación temporal para transformación"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Contar con documentación de deficiencias",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "En aquellos casos en que el importador original de la mercadería haya rechazado los bienes en virtud de la existencia de deficiencias y el exportador haya revendido la mercadería a otro comprador del exterior a un valor menor, se podrá imputar el monto que surge de la diferencia"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Acreditar carácter genuino de operación",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "Cuando el monto total a imputar supera USD 25.000, la entidad cuente con declaración jurada del exportador y copia certificada de la documentación intercambiada con el importador de la cual surja el concepto y el monto no ingresado"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Contar con documentación técnica de pérdida",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "La entidad deberá contar con una declaración jurada del exportador indicando que por los bienes no reimportados no ha recibido ni recibirá algún tipo de contraprestación y con la documentación técnica que le permita certificar la pérdida de valor comercial"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Contar con documentación de siniestro",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "La entidad interviniente cuente con la declaración jurada del exportador, la documentación de transporte, la denuncia del siniestro ante la entidad aseguradora y la liquidación del seguro"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Acreditar liquidación en moneda extranjera",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "De haberse realizado el pago en moneda extranjera, se requerirá certificación de la liquidación del cobro en el mercado de cambios"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Presentar comprobante de depósito",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "Si el siniestro fue liquidado en moneda local, copia del resumen de cuenta de depósito en entidad financiera en el cual figure el cobro del siniestro"
      }
    },
    {
      "local_id": "obl9",
      "type": "Obligacion",
      "label": "Declaración jurada de carácter genuino",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "Por el valor de los descuentos y gastos de servicios pagaderos en el exterior que consten en el permiso de embarque en la medida que la entidad cuente con la declaración jurada del exportador respecto al carácter genuino de la operación"
      }
    },
    {
      "local_id": "obl10",
      "type": "Obligacion",
      "label": "Contar con documentación de gastos de colocación",
      "properties": {
        "tipo": "presentacion_informativa",
        "descripcion": "En la medida que la entidad cuente con la declaración jurada del exportador respecto al carácter genuino de la operación y con la documentación de la cual surjan los montos correspondientes a gastos de colocación"
      }
    },
    {
      "local_id": "obl11",
      "type": "Obligacion",
      "label": "Verificar multas en contrato internacional",
      "properties": {
        "tipo": "otra",
        "descripcion": "La aplicación de las multas está específicamente prevista en el contrato de compraventa internacional celebrado entre las partes, y la firma de dicho contrato sea anterior a la fecha de embarque"
      }
    }
