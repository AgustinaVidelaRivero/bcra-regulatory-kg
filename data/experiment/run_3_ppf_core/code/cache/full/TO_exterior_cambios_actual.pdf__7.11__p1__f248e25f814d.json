      "label": "Demostrar registro ingreso aduanero",
      "properties": {
        "descripcion": "El requisito de ingreso y liquidación de las divisas se considerará cumplimentado en la medida que se demuestre el registro de ingreso aduanero de bienes por un valor equivalente a la financiación recibida.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig7",
      "type": "Obligacion",
      "label": "Liquidar fondos excedentes",
      "properties": {
        "descripcion": "Los fondos excedentes por encima del 125% deberán ser ingresados y liquidados en el mercado de cambios dentro de los plazos previstos en las normas generales en la materia.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Cancelación de intereses por cobros posteriores",
      "properties": {
        "descripcion": "En el caso de operaciones comprendidas en el punto 7.11.1.6, se admitirá la cancelación de intereses mediante la aplicación de cobros de exportaciones de bienes concretadas a partir de la fecha en que se completó el ingreso de la financiación."
