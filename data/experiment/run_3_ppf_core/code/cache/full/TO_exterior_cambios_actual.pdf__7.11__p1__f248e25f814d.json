      "properties": {
        "descripcion": "Se deberán confeccionar boletos de compra y venta sin movimiento de fondos con identificación del acreedor y número APX para incorporación al seguimiento.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Registrar boletos en fecha de origen",
      "properties": {
        "descripcion": "Los boletos deberán ser registrados en la fecha en que se originó la financiación, independientemente de cuál sea el momento en que el cliente solicita su registro ante la entidad financiera.",
        "tipo": "presentacion_informativa"
      }
    },
    {
