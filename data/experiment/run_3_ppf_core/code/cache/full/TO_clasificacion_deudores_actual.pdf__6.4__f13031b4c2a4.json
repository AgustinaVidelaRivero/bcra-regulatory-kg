    {
      "local_id": "e12",
      "type": "Excepcion",
      "label": "Excepción por discrepancia multientidad",
      "properties": {
        "descripcion": "Cuando exista una discrepancia de más de un nivel entre la clasificación dada por la entidad financiera y las otorgadas por al menos otras dos entidades o fideicomisos financieros en categorías inferiores a la asignada por aquella, cuyas acreencias en conjunto representen por lo menos el 20% y sean inferiores al 40% del total informado por todos los acreedores"
      }
    }
