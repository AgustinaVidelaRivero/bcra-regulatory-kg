      "label": "Declaración sobre acuerdos de precios",
      "properties": {
        "descripcion": "La entidad cuenta con una declaración jurada del exportador en la que deje constancia de que, en caso de haber sido convocado a un acuerdo de precios por el Gobierno Nacional, no ha rechazado participar ni ha incumplido lo acordado",
        "tipo": "presentacion_informativa"
      }
    },
