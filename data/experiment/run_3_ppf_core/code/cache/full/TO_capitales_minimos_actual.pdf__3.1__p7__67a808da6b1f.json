        "descripcion": "El cumplimiento estará sujeto a que se realicen verificaciones cada vez que se incorporen nuevos activos subyacentes",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Contar información desempeño activos verificable",
      "properties": {
        "descripcion": "Se deberá contar con información verificable sobre pérdidas e incumplimientos respecto de activos con características de riesgo sustancialmente similares a los que integran la titulización y por un período de tiempo lo suficientemente prolongado",
        "tipo": "presentacion_informativa"
      }
    },
