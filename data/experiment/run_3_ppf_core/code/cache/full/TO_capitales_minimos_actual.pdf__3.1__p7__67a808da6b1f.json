        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Inversor realizar evaluaciones propias",
      "properties": {
        "descripcion": "El inversor deberá realizar sus propias evaluaciones respecto del cumplimiento de estos criterios previo a la aplicación del enfoque estandarizado",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Originante determinar cumplimiento criterios",
      "properties": {
        "descripcion": "Para las posiciones retenidas en las que el originante haya transferido el riesgo, la determinación respecto del cumplimiento de los criterios será efectuada únicamente por la entidad originante",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Inversores evaluar modificaciones documentación",
      "properties": {
        "descripcion": "Los inversores y tenedores de las posiciones de titulización deberán tener en cuenta las modificaciones que puedan invalidar las evaluaciones de cumplimiento previas",
        "tipo": "otra"
      }
    },
    {
