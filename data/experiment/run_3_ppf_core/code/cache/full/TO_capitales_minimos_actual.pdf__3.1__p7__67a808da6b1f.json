      "label": "Titulización debe ser simple, transparente y comparable",
      "properties": {
        "descripcion": "Una titulización se considerará simple, transparente y comparable (STC) si: se trata de una titulización tradicional que no constituye un programa ABCP; involucra una transferencia real de activos; y cumple con la totalidad de los criterios STC previstos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Titulización no puede ser programa ABCP",
      "properties": {
        "descripcion": "Una titulización se considerará simple, transparente y comparable (STC) si se trata de una titulización tradicional que no constituye un programa ABCP",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Titulización requiere transferencia real de activos",
      "properties": {
        "descripcion": "Una titulización debe involucrar una transferencia real de activos en los términos del acápite v) del punto 3.1.14.1",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "Criterios STC deben cumplirse continuamente",
      "properties": {
        "descripcion": "Los criterios STC deberán cumplirse en todo momento",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r5",
      "type": "Restriccion",
      "label": "Activos subyacentes deben ser homogéneos",
      "properties": {
        "descripcion": "Los activos subyacentes deberán estar constituidos por documentos a cobrar o derechos de crédito de carácter homogéneo en cuanto a su tipo, jurisdicción, legislación aplicable y moneda",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r6",
      "type": "Restriccion",
      "label": "Flujos fondos contractualmente identificados",
      "properties": {
        "descripcion": "Los flujos de fondos deberán estar contractualmente identificados, ser periódicos y consistir exclusivamente en pagos del principal e intereses o de arrendamientos financieros",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r7",
      "type": "Restriccion",
      "label": "Tasas referencia deben ser tasas mercado",
      "properties": {
        "descripcion": "Las tasas de interés o de descuento de referencia deberán ser tasas de interés de mercado y de fácil consulta, evitándose referencias a fórmulas complejas o derivados exóticos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r8",
      "type": "Restriccion",
      "label": "Reembolso inversores proviene activos subyacentes",
      "properties": {
        "descripcion": "El reembolso a los inversores en la titulización deberá provenir principalmente del producido de los activos subyacentes y no deberá depender de modo sustancial de la refinanciación de los créditos",
        "tipo": "limite_cualitativo"
      }
    },
