      "local_id": "e1",
      "type": "EntidadFinanciera",
      "label": "Entidades del grupo 1",
      "properties": {
        "categoria": "entidades financieras grupo 1"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Cálculo capital riesgo operacional",
      "properties": {
        "tipo": "cálculo",
        "description": "Determinación mensual de la exigencia de capital por riesgo operacional mediante la fórmula C_RO = BIC x ILM"
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Determinar indicador negocio (BI)",
      "properties": {
        "tipo": "calculo",
        "description": "El BI es una aproximación al riesgo operacional a partir de la información de los estados financieros. Se determinará por la siguiente expresión: BI = VA (ILDC + SC + FC + RM), donde cada componente debe calcularse como el promedio de los valores de los 3 últimos períodos consecutivos de 12 meses anteriores al mes en que se efectúa el cálculo",
        "plazo": "mensual"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Calcular componente ILDC",
      "properties": {
        "tipo": "calculo",
        "description": "Componente de intereses, arrendamientos y dividendos. Se determinará por: Mín. [VA (ingresos por intereses – egresos por intereses); 5% x activos que devengan intereses] + ingresos por dividendos"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Calcular componente servicios (SC)",
      "properties": {
        "tipo": "calculo",
        "description": "Componente de servicios. Se determinará por: Máx. [otros ingresos por operaciones; otros egresos por operaciones] + Máx. [ingresos por honorarios y comisiones; egresos por honorarios y comisiones]"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Calcular componente financiero (FC)",
      "properties": {
        "tipo": "calculo",
        "description": "Componente financiero. Se determinará por: VA (resultado neto de cartera de negociación) + VA (resultado neto de cartera de inversión)"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Calcular resultado monetario (RM)",
      "properties": {
        "tipo": "calculo",
        "description": "Resultado monetario total como componente del indicador de negocio, expresado en moneda homogénea al cierre del período de cálculo de 36 meses"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Promediar valores últimos 3 períodos",
      "properties": {
        "tipo": "calculo",
        "description": "Cada término dentro de los 3 componentes y el resultado monetario debe ser calculado como el promedio de los valores de los 3 últimos períodos consecutivos de 12 meses anteriores al mes en que se efectúa el cálculo, expresados en moneda homogénea al cierre del período de cálculo de 36 meses: t, t-1 y t-2"
      }
    },
    {
