  "location": "Punto 6.1. Normas de procedimiento (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Régimen Informativo Contable Mensual",
      "properties": {
        "materia": "Responsabilidad Patrimonial Computable",
        "archivo": "TO_regimen_informativo_contable_mensual_actual.pdf",
        "version": "6a"
      }
    },
    {
      "local_id": "e1",
      "type": "EntidadFinanciera",
      "label": "Entidades financieras",
      "properties": {
        "categoria": "entidad financiera"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Determinación de responsabilidad patrimonial",
      "properties": {
        "tipo": "calculo",
        "description": "La responsabilidad patrimonial computable se determinará en función de los saldos de las partidas admitidas, registrados al último día del mes bajo informe."
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Consignar importe patrimonio neto",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se consignará el importe total del Patrimonio Neto (rubro 400000 del balance), excluyendo las acciones con preferencia patrimonial y la reserva especial para instrumentos de deuda."
      }
    },
    {
      "local_id": "e4",
      "type": "Restriccion",
      "label": "Exclusión de otros resultados integrales",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "No se considerarán los otros resultados integrales acumulados, cuya parte computable se informará en las partidas 28100000 y 28200000."
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Integrar partidas según período",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se integrarán las partidas que corresponda, según el período informado. De corresponder, se incluirán en la partida 20600000 los quebrantos no contabilizados provenientes de conceptos de otros resultados integrales."
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Informar otros resultados integrales computables",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se consignarán los otros resultados integrales provenientes de 'revaluación de propiedad, planta y equipo e intangibles' y de 'ganancias o pérdidas por instrumentos financieros a valor razonable con cambios en ORI' que resulten computables conforme lo establecido en el punto 8.2."
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Informar saldo deudor resultados integrales",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se consignará el saldo deudor proveniente del resto de los conceptos componentes de otros resultados integrales, excepto los contemplados en la partida 28100000."
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Incluir acciones ordinarias en consolidación",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "En los casos de consolidación (códigos 2, 3 y 9) se incluirán las acciones ordinarias emitidas por subsidiarias sujetas a supervisión consolidada y en poder de terceros, que cumplan con los criterios establecidos."
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Calcular diferencia previsión contable regulatoria",
      "properties": {
        "tipo": "calculo",
        "description": "Diferencia –positiva o negativa, según corresponda- entre la previsión contable según el punto 5.5. de la NIIF 9 y la previsión 'regulatoria' según las normas sobre 'Previsiones mínimas por riesgo de incobrabilidad'."
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Informar existencias títulos no físicamente poseídos",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informarán las existencias de títulos valores, certificados de depósitos a plazo fijo, otros títulos de crédito, etc., que no se encuentren físicamente en poder de la entidad, de acuerdo con el punto 8.4.1.3."
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Consignar mayor saldo títulos subordinados",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se incluirá el mayor saldo registrado durante el mes a que corresponde la determinación de la responsabilidad patrimonial computable, de la tenencia de títulos valores y otros instrumentos de deuda, contractualmente subordinados a los demás pasivos, emitidos por otras entidades financieras."
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Informar mayor saldo corresponsalía con exterior",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se consignará el mayor saldo registrado durante el mes a que corresponde la determinación de la responsabilidad patrimonial computable, de las cuentas de corresponsalía con entidades financieras del exterior que no cuenten con calificación 'investment grade'."
      }
    },
    {
      "local_id": "e13",
      "type": "Restriccion",
      "label": "Calificación mínima títulos gobiernos extranjeros",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Se incluirá el mayor saldo registrado durante el mes de los títulos emitidos por gobiernos de países extranjeros, cuya calificación internacional sea inferior a la asignada a títulos públicos nacionales de la República Argentina, y que no cuenten con mercados donde se transen en forma habitual."
      }
    },
    {
      "local_id": "e14",
      "type": "Obligacion",
      "label": "Detallar valor bienes inmuebles para uso propio",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se detallará el 100 % del valor -neto de la depreciación acumulada- de los bienes inmuebles para uso propio y diversos, cuya registración contable no se encuentre respaldada con la pertinente escritura traslativa de dominio debidamente inscripta."
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Informar activos intangibles netos",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se incluirán los activos intangibles netos de sus respectivas amortizaciones acumuladas. Comprende la llave de negocio que cumpla los requisitos establecidos."
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Informar diferencias insuficiencia previsiones",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Comprende las diferencias por insuficiencia de constitución de las previsiones mínimas por riesgo de incobrabilidad determinada por la Superintendencia, en la medida en que no hayan sido contabilizadas."
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Informar llave negativa adquisiciones",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Comprende el valor -neto de desafectaciones- de la llave negativa registrada en adquisiciones de participaciones por un costo inferior a su valor patrimonial proporcional. Esta partida se computará únicamente en la información consolidada o individual del ente combinado."
      }
    },
    {
      "local_id": "e18",
      "type": "Restriccion",
      "label": "Límite saldo impuesto ganancia mínima presunta",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "Comprende el saldo a favor por aplicación del impuesto a la ganancia mínima presunta -neto de las previsiones- que exceda el 10% del patrimonio neto básico correspondiente al mes anterior.",
        "umbral": "10%"
      }
    },
    {
      "local_id": "e19",
      "type": "Obligacion",
      "label": "Informar aportes capitalización no autorizada",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informarán los aportes registrados contablemente como tales cuya capitalización aún no haya sido autorizada por la SEFyC."
      }
    },
    {
      "local_id": "e20",
      "type": "Obligacion",
      "label": "Informar excesos afectación activos garantía",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se consignarán los excesos a los límites para la afectación de activos en garantía, según lo dispuesto en la Sección 3 de las normas sobre 'Afectación de activos en garantía'."
      }
    },
    {
