    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Exhibir cuadro comparativo de comisiones",
      "properties": {
        "descripcion": "Cuando se modifique el valor de las comisiones, el cuerpo de las notificaciones deberá exhibir un cuadro comparativo para esos importes que será elaborado y oportunamente puesto a disposición por la Superintendencia de Entidades Financieras y Cambiarias (SEFYC)",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Reintegro de importes cobrados indebidamente",
      "properties": {
        "descripcion": "Todo importe cobrado o adeudado de cualquier forma al usuario por conceptos como tasas de interés, comisiones y/o cargos sin cumplimiento de lo previsto, deberá serle reintegrado dentro de los diez (10) días hábiles siguientes al momento de la presentación del reclamo ante el sujeto obligado, o los cinco (5) días hábiles siguientes al momento de constatarse tal circunstancia por el sujeto obligado o por la fiscalización de la SEFYC",
        "tipo": "otra",
        "plazo": "10 días hábiles o 5 días hábiles según corresponda"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Aplicar intereses compensatorios en reintegros",
      "properties": {
        "descripcion": "El sujeto obligado deberá aplicar 1,5 veces la tasa promedio correspondiente al período comprendido entre el momento en que la diferencia hubiera sido exigible y el de su efectiva cancelación, computado a partir de la encuesta diaria de tasas de interés de depósitos a plazo fijo de 30 a 59 días",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Acreditar reintegro en cuenta a la vista",
      "properties": {
        "descripcion": "Cuando el usuario posea en la entidad financiera obligada una cuenta a la vista que se halle abierta a su nombre, ésta deberá acreditar ese importe en dicha cuenta en forma automática sin necesidad de requerimiento expreso",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Notificar acreditación del reintegro",
      "properties": {
        "descripcion": "Deberá notificarse la acreditación del reintegro o su puesta a disposición mediante aviso efectuado a través de medios electrónicos (cajeros automáticos, banca por Internet, etc.) y/o servicios telefónicos (mensajes de texto y/o voz), y mediante documento escrito dirigido a su domicilio o a su correo electrónico",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "oblig6",
      "type": "Obligacion",
      "label": "Verificar situaciones de reintegro en usuarios",
      "properties": {
        "descripcion": "El sujeto obligado deberá verificar si situaciones que generan la obligación de reintegros ha ocurrido respecto de los usuarios que se encuentren en la misma situación y, de corresponder, proceder a su reintegro según el procedimiento previsto, notificando de tal circunstancia y resultados a su Responsable de Atención al Usuario de Servicios Financieros",
        "tipo": "otra"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Prohibición cobro sin cumplimiento de requisitos",
      "properties": {
        "descripcion": "No se puede cobrar tasas de interés, comisiones y/o cargos sin el cumplimiento de lo previsto en los puntos 2.3.2. a 2.3.4.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Prohibición cobro en exceso de costos",
      "properties": {
        "descripcion": "No se pueden cobrar cargos en exceso de los costos de los servicios que terceros les cobraron a los sujetos obligados",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Límite máximo de comisiones",
      "properties": {
        "descripcion": "No se pueden cobrar comisiones en exceso de las máximas fijadas por el BCRA",
        "tipo": "limite_cuantitativo"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Prohibición tasa interés máxima en tarjetas",
      "properties": {
        "descripcion": "No se puede incumplir el nivel de la tasa de interés máxima aplicable a financiaciones vinculadas a tarjetas de crédito",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Prohibición cobro excepto lo pactado",
      "properties": {
        "descripcion": "No se pueden cobrar importes en exceso de lo oportunamente pactado entre el usuario y el sujeto obligado",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest6",
      "type": "Restriccion",
      "label": "Prohibición generación impropia de importes",
      "properties": {
        "descripcion": "Se prohíben otros importes generados en forma impropia por su naturaleza, tales como intereses compensatorios por saldos deudores generados en cuentas de depósito distintas de la cuenta corriente bancaria",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest7",
      "type": "Restriccion",
      "label": "Prohibición liquidación incorrecta de beneficios",
      "properties": {
        "descripcion": "Se prohíbe la liquidación en forma incorrecta de promociones, descuentos u otro tipo de beneficios que no se ajusten a los términos, condiciones y/o modalidades que hubieran sido ofrecidos, publicitados o convenidos",
        "tipo": "prohibicion"
      }
    }
  ],
