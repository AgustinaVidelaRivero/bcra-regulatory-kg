    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Asentar consultas que requieren análisis",
      "properties": {
        "descripcion": "Las consultas y/o reclamos que para su respuesta requieren del análisis de documentación obrante en el sujeto obligado y/o del pedido de información a otros sujetos u organismos deben ser asentados en el RCCR",
        "tipo": "asignacion",
        "plazo": "inmediata"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Asentar reclamos por incumplimiento",
      "properties": {
        "descripcion": "Deben ser asentados en el RCCR aquellos reclamos que representan una queja por presunto incumplimiento, prestación defectuosa o falta de prestación de un producto o servicio ofrecido por el sujeto obligado, aun cuando pueda dárseles respuesta en forma inmediata",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Consignar datos mínimos en registro",
      "properties": {
        "descripcion": "Deberán consignarse como mínimo los siguientes datos: número de consulta o reclamo; fecha, canal y motivo de la presentación; tipo y número de documento de identificación del presentante; casa receptora y afectada/s; otra/s entidad/es involucrada/s y el estado del trámite",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Mantener numeración correlativa",
      "properties": {
        "descripcion": "Los números asignados a las presentaciones deberán ser correlativos y la base de datos sólo podrá ser modificada para la incorporación de nuevas consultas o reclamos, o para el agregado de nueva información sobre el estado actualizado de los trámites",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Proveer número de consulta inmediatamente",
      "properties": {
        "descripcion": "Cuando la consulta o el reclamo sea iniciada/o llamando a una línea o central telefónica o ingresando datos en una página de Internet, el número de consulta o reclamo deberá ser provisto en el acto al presentante, respetando la correlatitividad",
        "tipo": "comunicacion_a_cliente",
        "plazo": "inmediato"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Notificar número de consulta en plazo",
      "properties": {
        "descripcion": "Para los casos en que el presentante no reciba automáticamente el número de su consulta o reclamo, se deberá establecer un procedimiento que prevea la notificación del número o código que le sea asignado dentro de los tres (3) días hábiles de iniciada la presentación",
        "tipo": "comunicacion_a_cliente",
        "plazo": "tres días hábiles"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Conservar información registral",
      "properties": {
        "descripcion": "La información incorporada a esta base de datos deberá conservarse por el término de diez (10) años",
        "tipo": "otra",
        "plazo": "diez años"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Asentar reintegros en registro",
      "properties": {
        "descripcion": "En el Registro de Reintegros de Importes (RRI) se deberán asentar los montos reintegrados a los usuarios, identificando en cada caso al usuario afectado, la causal generadora del evento, los productos y casas involucradas",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl9",
      "type": "Obligacion",
      "label": "Asentar denuncias judiciales",
      "properties": {
        "descripcion": "En el Registro de Denuncias ante las Instancias Judiciales y/o Administrativas de Defensa del Consumidor (RDJA) se asentarán todas las intervenciones originadas en denuncias efectuadas ante instancias judiciales y/o administrativas de defensa del consumidor, identificando al usuario afectado y especificando el importe involucrado",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl10",
      "type": "Obligacion",
      "label": "Habilitar múltiples canales de presentación",
      "properties": {
        "descripcion": "Las presentaciones de los usuarios de servicios financieros deberán poder realizarse por teléfono, Internet, por escrito, fax, correo postal y electrónico (e-mail), etc.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl11",
      "type": "Obligacion",
      "label": "Contemplar atención personalizada",
      "properties": {
        "descripcion": "Se deberá contemplar un procedimiento de atención personalizado para aquellos clientes que lo soliciten",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl12",
      "type": "Obligacion",
      "label": "Resolver consulta o reclamo",
      "properties": {
        "descripcion": "Toda consulta o reclamo deberá ser definitivamente resuelta/o dentro del plazo máximo de diez (10) días hábiles, excepto para la situación prevista en el punto 2.3.5 o cuando reglamentariamente se hayan otorgado al sujeto obligado mayores plazos",
        "tipo": "otra",
        "plazo": "diez días hábiles"
      }
    },
    {
      "local_id": "obl13",
      "type": "Obligacion",
      "label": "Notificar resolución por escrito",
      "properties": {
        "descripcion": "La resolución de la presentación deberá ser notificada por escrito al usuario de servicios financieros, admitiéndose –además de los tradicionales medios de notificación fehaciente– la utilización del correo electrónico cuando el presentante haya aceptado dicho canal",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Plazo mayor por reglamentación",
      "properties": {
        "descripcion": "cuando reglamentariamente se hayan otorgado al sujeto obligado mayores plazos para adecuarse normativamente"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Causas ajenas justificadas",
      "properties": {
        "descripcion": "cuando medien causas ajenas al sujeto obligado debidamente justificadas"
      }
    }
  ],
