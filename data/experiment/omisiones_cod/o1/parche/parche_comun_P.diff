+def cuantia_del_elemento(el: dict) -> str:
+    """U-OMISIONES-COD, grupo L: la cuantía del elemento, que ya no es su `tramo` (el ensamblado guarda ahí el tramo de
+    E1 del que sale). Se toma de las cuantías que `reglas_comparacion.detectar_cuantias` encuentra en el tramo, por el
+    valor y la unidad del elemento (y, si ninguna coincide en los dos, por el valor). En un grafo anterior al grupo L
+    el tramo es la cuantía y devuelve lo mismo; un elemento del validador, o uno cuyo tramo no tiene una cuantía con
+    ese valor, devuelve el tramo."""
+    t = el.get("tramo") or ""
+    if es_validador(el):
+        return t
+    cs = rcmp().detectar_cuantias(t)
+    for c in cs:
+        if c.valor == el.get("valor") and c.unidad == el.get("unidad"):
+            return c.texto
+    for c in cs:
+        if el.get("valor") is not None and c.valor == el.get("valor"):
+            return c.texto
+    return t
+
