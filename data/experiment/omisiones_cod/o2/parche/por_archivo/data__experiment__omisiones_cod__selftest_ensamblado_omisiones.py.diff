+def s_grupo_G_r() -> None:
+    g = "S G-r"
+    pol = 2
+    ch = chunk("syn::5.1.2", "5.1.2", "5.1.2. Las boletas deben incluir lugar y fecha.",
+               [{"unidad_origen": "5.1", "tipo": "encabezado", "texto": "5.1. Boletas de depósito."},
