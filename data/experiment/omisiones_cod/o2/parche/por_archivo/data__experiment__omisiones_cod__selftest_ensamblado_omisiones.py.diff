+        nuevo, estado = ENS.tramo_de_e1(e, comp, [("c", f"Las financiaciones {comp}.")], V, RCMP, pol, M)
+        check(g, f"L+ tramo compartido: el {c.valor} guarda el tramo entero", estado == "exacta" and nuevo["tramo"] == comp)
+
