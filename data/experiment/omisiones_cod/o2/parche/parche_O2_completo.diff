+         "esqueleto": 0}
+    for e in kg["edges"]:
+        if e["relation"] == "remite_a" or (e["relation"] == "referencia" and rf(e) == "referencia_cruzada"):
+            c["remite_a"] += 1
+        elif e["relation"] == "referencia":
