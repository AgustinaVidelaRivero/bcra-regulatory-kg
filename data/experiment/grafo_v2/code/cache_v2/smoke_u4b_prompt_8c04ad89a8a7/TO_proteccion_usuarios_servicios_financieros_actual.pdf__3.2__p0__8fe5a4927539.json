    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Designar Directivo Responsable de Protección",
      "properties": {
        "descripcion": "Las entidades financieras, las empresas no financieras emisoras de tarjetas de crédito y/o compra y los otros proveedores no financieros de crédito deberán designar a un miembro del Directorio o autoridad equivalente como 'Directivo Responsable de Protección de los Usuarios de Servicios Financieros' ante el BCRA.",
        "tipo": "asignacion",
        "plazo": "sin plazo especificado"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Vigilar funcionamiento procesos protección usuario",
      "properties": {
        "descripcion": "El Directivo Responsable deberá vigilar el adecuado funcionamiento de los procesos relacionados con la protección de los usuarios de los servicios financieros según las disposiciones establecidas en estas normas.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Contribuir mejora procesos y controles",
      "properties": {
        "descripcion": "Contribuir a la mejora de los mencionados procesos, los controles relacionados y el esquema de gestión de riesgo asociado con la protección de los usuarios de servicios financieros, en coordinación con las áreas de cumplimiento normativo, gestión de riesgo operativo y asuntos legales.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Proponer responsable atención usuario",
      "properties": {
        "descripcion": "Proponer al Directorio o autoridad equivalente a los funcionarios para el desempeño de la función de Responsable de atención al usuario de servicios financieros.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Participar en definición productos y servicios",
      "properties": {
        "descripcion": "Participar en el proceso de definición y aprobación de nuevos productos y servicios y en la modificación de los existentes, vigilando que se hayan considerado adecuadamente los derechos de los usuarios de servicios financieros.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig6",
      "type": "Obligacion",
      "label": "Verificar funcionamiento análisis reclamos",
      "properties": {
        "descripcion": "Verificar el adecuado funcionamiento del proceso de análisis de las causas generadoras de los eventos de reclamos previsto en el punto 3.1.1.6.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig7",
      "type": "Obligacion",
      "label": "Evaluar reportes responsable atención usuario",
      "properties": {
        "descripcion": "Evaluar los reportes trimestrales que genere el Responsable de atención al usuario de servicios financieros, aprobar las propuestas correctivas y efectuar el seguimiento de su implementación.",
        "tipo": "presentacion_informativa",
        "plazo": "trimestral"
      }
    },
    {
      "local_id": "oblig8",
      "type": "Obligacion",
      "label": "Evaluar informes auditoría y observaciones SEFyC",
      "properties": {
        "descripcion": "Evaluar los informes emitidos por la auditoría interna, la auditoría externa y las observaciones comunicadas por la SEFyC con relación al proceso de protección de los usuarios de servicios financieros, y velar por la ejecución de acciones para regularizar debilidades.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig9",
      "type": "Obligacion",
      "label": "Velar cumplimiento requerimientos informativos BCRA",
      "properties": {
        "descripcion": "Velar por el cumplimiento de los requerimientos informativos del BCRA que son materia de su incumbencia.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig10",
      "type": "Obligacion",
      "label": "Elevar reporte análisis al Directorio",
      "properties": {
        "descripcion": "Elevar al Directorio o autoridad equivalente, como mínimo trimestralmente, un reporte de análisis con las acciones realizadas en el marco de sus responsabilidades, con énfasis en la evaluación del informe del Responsable de atención al usuario. El reporte deberá ser evaluado por el órgano directivo y constar en el Libro de Actas.",
        "tipo": "presentacion_informativa",
        "plazo": "trimestral"
      }
    },
    {
      "local_id": "oblig11",
      "type": "Obligacion",
      "label": "Conformar Comité Protección Usuarios (alternativa)",
      "properties": {
        "descripcion": "Cuando la dimensión, operatoria y/o clientela de la entidad así lo aconsejaran, los sujetos obligados podrán conformar un Comité integrado por al menos un miembro del Directorio o autoridad equivalente y los responsables de cumplimiento normativo, gestión de riesgo operativo y asuntos legales, con las mismas funciones que el Directivo Responsable.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig12",
      "type": "Obligacion",
      "label": "Evaluar reportes Responsable atención usuario",
      "properties": {
        "descripcion": "Para el caso de los sujetos obligados no alcanzados por la obligación del punto 3.2.1.1, el Directorio o autoridad equivalente deberá evaluar los reportes que le eleve el responsable de atención al usuario de servicios financieros de conformidad con el punto 3.1.1.8.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig13",
      "type": "Obligacion",
      "label": "Auditoría Interna: evaluación anual servicio atención usuario",
      "properties": {
        "descripcion": "Como mínimo una vez al año, el Servicio de Atención al Usuario de Servicios Financieros y los procesos implementados para el cumplimiento de las obligaciones establecidas en estas normas deberán ser objeto de evaluación integral y reporte escrito por parte de la auditoría interna.",
        "tipo": "presentacion_informativa",
        "plazo": "anual"
      }
    },
    {
      "local_id": "oblig14",
      "type": "Obligacion",
      "label": "Auditoría Interna: verificar entrega documentos",
      "properties": {
        "descripcion": "La auditoría interna deberá verificar que se proporciona a los usuarios de servicios financieros copia de los formularios que firman y ejemplares de los contratos formalizados con el sujeto obligado, en tiempo y forma previstos.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig15",
      "type": "Obligacion",
      "label": "Auditoría Interna: verificar notificación comisiones cargos",
      "properties": {
        "descripcion": "La auditoría interna deberá verificar que se ha notificado en el cuerpo del contrato cuáles son los conceptos sobre los cuales se aplicarán comisiones y cargos y de sus respectivos importes o porcentajes, así como de derechos y obligaciones emergentes de la contratación.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig16",
      "type": "Obligacion",
      "label": "Auditoría Interna: verificar notificación condiciones modificables",
      "properties": {
        "descripcion": "La auditoría interna deberá verificar que se ha notificado en el contrato a los usuarios sobre las condiciones que pueden ser objeto de modificación, así como la facultad de rescisión tanto del usuario como del sujeto obligado.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig17",
      "type": "Obligacion",
      "label": "Auditoría Interna: verificar comisiones y cargos aplicados",
      "properties": {
        "descripcion": "La auditoría interna deberá verificar que las comisiones y cargos aplicados a los usuarios de servicios financieros se ajusten a las disposiciones del punto 2.3.2.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig18",
      "type": "Obligacion",
      "label": "Auditoría Interna: verificar administración registros centralizados",
      "properties": {
        "descripcion": "La auditoría interna deberá verificar que los Registros Centralizados de Consultas y Reclamos (RCCR), de Reintegros de Importes (RRI) y de Denuncias ante Instancias Judiciales y/o Administrativas (RDJA) sean adecuadamente administrados y actualizados de acuerdo con los requisitos previstos en estas normas.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig19",
      "type": "Obligacion",
      "label": "Informar estado trámite al usuario",
      "properties": {
        "descripcion": "El sujeto obligado deberá informar al usuario de servicios financieros el estado del trámite cada vez que lo requiera.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "oblig20",
      "type": "Obligacion",
      "label": "Extender constancia consulta o reclamo",
      "properties": {
        "descripcion": "El sujeto obligado deberá, ante la solicitud del usuario de servicios financieros, extender una constancia con la identificación de su consulta o reclamo y el estado actualizado de su trámite.",
        "tipo": "comunicacion_a_cliente"
      }
    },
