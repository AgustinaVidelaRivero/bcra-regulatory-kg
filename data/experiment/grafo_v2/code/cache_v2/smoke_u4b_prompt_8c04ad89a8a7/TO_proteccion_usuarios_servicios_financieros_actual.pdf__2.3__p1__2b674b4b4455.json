      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Proporcionar contrato firmado al usuario",
      "properties": {
        "descripcion": "proporcionar o poner a disposición del usuario de servicios financieros un ejemplar del contrato con la firma autorizada del sujeto obligado, dentro de los diez (10) días hábiles de realizada la contratación o de la disponibilidad efectiva del producto o servicio, lo que suceda último",
        "tipo": "presentacion_informativa",
        "plazo": "10 días hábiles"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Utilizar documentación habitual de contratos presenciales",
      "properties": {
        "descripcion": "utilizar la documentación habitual que emplean en los contratos presenciales",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Otorgar medios técnicos para detectar errores antes de contratación electrónica",
      "properties": {
        "descripcion": "otorgar al usuario los medios técnicos necesarios para que, antes de la contratación, pueda detectar y subsanar eventuales errores u omisiones en la carga de los datos",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Proporcionar mecanismo de confirmación expresa",
      "properties": {
        "descripcion": "proporcionarle al usuario un mecanismo de confirmación expresa de la decisión de efectuar la contratación, de forma tal que su silencio no sea considerado como consentimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Asegurar términos descargables e inalterables",
      "properties": {
        "descripcion": "asegurar que los términos de la contratación puedan ser leídos, descargados y guardados por el usuario de manera inalterable",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Entregar resumen informativo del contrato",
      "properties": {
        "descripcion": "entregar a los usuarios antes de su formalización un resumen del contrato en el que se sinteticen, en un lenguaje llano y coloquial, los términos y alcances de las principales cuestiones que rigen la contratación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Comisiones y cargos deben tener origen en costo real",
      "properties": {
        "descripcion": "Todas las comisiones, cargos, costos, gastos, seguros y/o cualquier otro concepto que los sujetos obligados perciban o pretendan percibir de los usuarios de servicios financieros deben tener origen en un costo real, directo y demostrable y estar debidamente justificados desde el punto de vista técnico y económico",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Comisiones y cargos limitados a servicios solicitados y autorizados",
      "properties": {
        "descripcion": "La aplicación de comisiones y/o cargos debe quedar circunscripta a la efectiva prestación de un servicio que haya sido previamente solicitado, pactado y/o autorizado por el usuario",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Cargos no pueden exceder precio del tercero prestador",
      "properties": {
        "descripcion": "el importe de los cargos que el sujeto obligado transfiera a los usuarios no podrá ser superior al que el tercero prestador perciba de particulares, sin intermediarios y en similares condiciones",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "Prohibición de comisiones en precancelación total con plazo vencido",
      "properties": {
        "descripcion": "En el caso de precancelación total, no se admitirá la aplicación de comisiones cuando al momento de efectuarla haya transcurrido al menos la cuarta parte del plazo original de la financiación o 180 días corridos desde su otorgamiento, de ambos el mayor",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r5",
      "type": "Restriccion",
      "label": "Prohibición de cobro de conceptos no admitidos",
      "properties": {
        "descripcion": "No corresponde el cobro a los usuarios de conceptos que no observen las condiciones enunciadas en el punto 2.3.2.1 y/o que deriven de la prestación de un servicio cuya comisión o cargo, según corresponda, ya se encuentre incluida en otros conceptos cobrados por el sujeto obligado",
        "tipo": "prohibicion"
      }
    }
  ],
