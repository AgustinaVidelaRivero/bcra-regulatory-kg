      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Prohibición de cobro en exceso de costos",
      "properties": {
        "descripcion": "Prohibición de cargos en exceso de los costos de los servicios que terceros cobraron a los sujetos obligados en relación con servicios prestados a usuarios",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Prohibición de comisiones superiores a máximas",
      "properties": {
        "descripcion": "Prohibición de comisiones en exceso de las máximas fijadas por el BCRA",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Prohibición de cargos sobre tasas máximas de financiación",
      "properties": {
        "descripcion": "Prohibición de cargos en incumplimiento al nivel de la tasa de interés máxima aplicable a financiaciones vinculadas a tarjetas de crédito",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Prohibición de cargos no pactados",
      "properties": {
        "descripcion": "Prohibición de cargos en exceso de lo pactado entre el usuario y el sujeto obligado",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest6",
      "type": "Restriccion",
      "label": "Prohibición de cargos impropios",
      "properties": {
        "descripcion": "Prohibición de cargos generados en forma impropia por su naturaleza, tales como intereses compensatorios por saldos deudores generados en cuentas de depósito distintas de la cuenta corriente bancaria",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest7",
      "type": "Restriccion",
      "label": "Prohibición de liquidación incorrecta de promociones",
      "properties": {
        "descripcion": "Prohibición de importes adeudados al usuario por haber liquidado en forma incorrecta promociones, descuentos u otro tipo de beneficios que no se ajusten a los términos, condiciones y/o modalidades ofrecidos, publicitados o convenidos",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Mantener información en régimen de transparencia",
      "properties": {
        "descripcion": "Los sujetos obligados deben proporcionarle información al BCRA a fin de que este elabore el Régimen de Transparencia sobre costos, características y requisitos de los productos y servicios financieros",
        "tipo": "presentacion_informativa",
        "plazo": "continuado"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Exhibir cuadro comparativo en modificación de comisiones",
      "properties": {
        "descripcion": "Cuando se modifique el valor de comisiones, el cuerpo de las notificaciones deberá exhibir un cuadro comparativo que será elaborado por la SEFYC",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Reintegrar importes cobrados indebidamente",
      "properties": {
        "descripcion": "El sujeto obligado debe reintegrar todo importe cobrado o adeudado indebidamente al usuario dentro de diez (10) días hábiles siguientes a la presentación del reclamo o cinco (5) días hábiles desde su constatación",
        "tipo": "otra",
        "plazo": "10 días hábiles tras reclamo o 5 días hábiles tras constatación"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Aplicar intereses compensatorios en reintegros",
      "properties": {
        "descripcion": "El sujeto obligado deberá aplicar 1,5 veces la tasa promedio de depósitos a plazo fijo de 30 a 59 días como intereses compensatorios desde la fecha del cobro indebido hasta su devolución",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Acreditar reintegro automáticamente",
      "properties": {
        "descripcion": "Si el usuario posee una cuenta a la vista abierta a su nombre, la entidad deberá acreditar el reintegro automáticamente sin necesidad de requerimiento expreso",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Notificar acreditación de reintegro",
      "properties": {
        "descripcion": "Deberá notificarse la acreditación del reintegro mediante aviso por medios electrónicos, servicios telefónicos, documento escrito dirigido al domicilio o correo electrónico expresamente aceptado",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Verificar situaciones de reintegro masivo",
      "properties": {
        "descripcion": "El sujeto obligado deberá verificar si situaciones que generan obligación de reintegros han ocurrido respecto de otros usuarios en la misma situación y proceder a su reintegro, notificando al Responsable de Atención al Usuario",
        "tipo": "otra"
      }
    }
  ],
