    {
      "local_id": "e4",
      "type": "Excepcion",
      "label": "Exclusión créditos consumo o vivienda",
      "properties": {
        "descripcion": "Los créditos para consumo o vivienda están excluidos de la cartera comercial"
      }
    },
    {
      "local_id": "e5",
      "type": "Excepcion",
      "label": "Inclusión créditos grandes vinculados a actividad",
      "properties": {
        "descripcion": "Los créditos para consumo o vivienda que superen el equivalente a dos veces el importe de referencia establecido en el punto 3.7. y cuyo repago no se encuentre vinculado a ingresos fijos o periódicos del cliente sino a la evolución de su actividad productiva o comercial se incluirán dentro de la cartera comercial"
      }
    },
    {
      "local_id": "e6",
      "type": "Excepcion",
      "label": "Opción agrupación créditos comerciales pequeños",
      "properties": {
        "descripcion": "A opción de la entidad, las financiaciones de naturaleza comercial de hasta el equivalente a dos veces el importe de referencia establecido en el punto 3.7., cuenten o no con garantías preferidas, podrán agruparse junto con los créditos para consumo o vivienda"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Sumar financiaciones para determinar encuadramiento",
      "properties": {
        "descripcion": "Cuando el cliente mantenga financiaciones por ambos conceptos, los créditos para consumo o vivienda se sumarán a los de la cartera comercial para determinar su encuadramiento en una o en otra cartera en función del importe indicado, a cuyo fin los créditos con garantías preferidas se ponderarán al 50 %",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Prever opción en Manual de procedimientos",
      "properties": {
        "descripcion": "De ejercerse, esta opción deberá aplicarse con carácter general a toda la cartera y encontrarse prevista en el Manual de procedimientos de clasificación y previsión",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Preavisar cambio de opción a SEFyC",
      "properties": {
        "descripcion": "Sólo podrá cambiarse con un preaviso de 6 meses a la Superintendencia de Entidades Financieras y Cambiarias (SEFyC)",
        "tipo": "comunicacion_a_cliente",
        "plazo": "6 meses"
      }
    },
