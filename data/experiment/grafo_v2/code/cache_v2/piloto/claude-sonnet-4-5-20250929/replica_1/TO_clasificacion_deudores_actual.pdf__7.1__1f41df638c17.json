    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Clasificación de deudores de cartera consumo o vivienda",
      "properties": {
        "tipo": "clasificacion",
        "descripcion": "Clasificación de clientes de la cartera para consumo o vivienda considerando pautas objetivas vinculadas al grado de cumplimiento de las correspondientes obligaciones o su situación jurídica"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Realizar análisis previos al otorgamiento",
      "properties": {
        "tipo": "calculo",
        "descripcion": "Los análisis previos al otorgamiento de las financiaciones y refinanciaciones también deben guardar relación con la capacidad de pago de los deudores, evaluando la afectación de sus ingresos periódicos por la totalidad de los compromisos de crédito asumidos",
        "frecuencia": "previo al otorgamiento"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Efectuar clasificación mensual con pautas objetivas",
      "properties": {
        "tipo": "calculo",
        "descripcion": "La clasificación de estos clientes se efectuará considerando -al cabo de cada mes- exclusivamente pautas objetivas vinculadas al grado de cumplimiento de las correspondientes obligaciones o su situación jurídica, las informaciones que surjan de la Central de deudores del sistema financiero, de la base de Deudores en situación irregular de ex entidades financieras y la situación que surja de la aplicación de las pautas de refinanciación",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Considerar pauta de mayor riesgo",
      "properties": {
        "tipo": "calculo",
        "descripcion": "En caso de discrepancias, se deberá considerar la pauta que indique el mayor nivel de riesgo de incobrabilidad"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Aplicar pautas específicas para mejora de clasificación",
      "properties": {
        "tipo": "calculo",
        "descripcion": "A fin de determinar una mejora en la clasificación del deudor, corresponderá tener en cuenta las pautas específicas previstas en cada una de las categorías"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Considerar mora en emergencia agropecuaria",
      "properties": {
        "tipo": "calculo",
        "descripcion": "A los fines de la clasificación, deberá tenerse en cuenta la mora en el atraso de sus obligaciones para el momento en que concluya la vigencia de la emergencia declarada"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Prohibición de mejora en clasificación con atraso >31 días",
      "properties": {
        "tipo": "prohibicion",
        "descripcion": "No se podrán efectuar mejoras en las clasificaciones de los clientes, si los mismos registran un atraso mayor a 31 días en el pago de sus obligaciones refinanciadas",
        "umbral": "31 días"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Prohibición de mejoramiento por emergencia agropecuaria",
      "properties": {
        "tipo": "prohibicion",
        "descripcion": "El tratamiento que se dispense en ese marco no podrá implicar mejoramiento de la clasificación asignada al cliente en función de su situación individual, preexistente a la emergencia, ni su aplicación extenderse más allá de la vigencia fijada para ella"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción por Ley de Emergencia Agropecuaria",
      "properties": {
        "descripcion": "No se considerarán dentro de ese concepto las refinanciaciones otorgadas a productores cuando ello resulte de la aplicación de disposiciones vinculadas a la Ley de Emergencia Agropecuaria"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción facilidades adicionales hasta 10%",
      "properties": {
        "descripcion": "No se considerarán comprendidas en esas definiciones las facilidades adicionales que se otorguen respecto de los márgenes vigentes acordados, siempre que el nuevo apoyo crediticio implique nuevos desembolsos de fondos y no supere el 10% del cupo asignado en oportunidad de la última evaluación crediticia del cliente hasta que corresponda ser evaluado nuevamente"
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Excepción renovaciones y expansión de actividades",
      "properties": {
        "descripcion": "No se considerarán comprendidas en esas definiciones las renovaciones periódicas de crédito para capital de trabajo ni las nuevas financiaciones y las refinanciaciones asociadas a una mayor inversión derivada de la expansión de las actividades, en la medida en que sean consistentes con el curso normal de los negocios y exista capacidad para atender el resto de las obligaciones financieras"
      }
    },
    {
      "local_id": "exc4",
      "type": "Excepcion",
      "label": "Excepción exceso de márgenes específicos",
      "properties": {
        "descripcion": "Cuando se hayan asignado al deudor márgenes de crédito por líneas de préstamo específicas y éstos se excedan, tales situaciones no serán consideradas refinanciaciones siempre que no se supere el límite de la asistencia máxima que le haya sido acordada por todo concepto en función de su capacidad de pago"
      }
    },
    {
      "local_id": "exc5",
      "type": "Excepcion",
      "label": "Excepción evaluación capacidad de pago",
      "properties": {
        "descripcion": "No será obligatoria la evaluación de la capacidad de pago en función de los ingresos del prestatario, en la medida en que se utilicen métodos específicos de evaluación o se trate de deudores por préstamos de monto reducido en los términos del punto 1.1.3.3. de las normas sobre Gestión crediticia"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Otorgamiento de financiaciones y refinanciaciones",
      "properties": {
        "tipo": "financiacion",
        "descripcion": "Otorgamiento de financiaciones y refinanciaciones a deudores de la cartera para consumo o vivienda"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Mejora de clasificación de deudor",
      "properties": {
        "tipo": "clasificacion",
        "descripcion": "Mejora en la clasificación del deudor que, como consecuencia de haber incurrido en atraso en el pago de sus obligaciones refinanciadas, haya sido recategorizado en niveles inferiores"
      }
    }
  ],
