        "frecuencia": "trimestral"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Calcular ratio de apalancamiento",
      "properties": {
        "descripcion": "Surgirá de aplicar la expresión prevista en el punto 1.2. de las citadas normas: Ratio de apalancamiento = [Medida del capital / Medida de la exposición] * 100 = [PNb / ∑ Códigos (45110000 a 45140000)] * 100",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Informar exposiciones en el activo",
      "properties": {
        "descripcion": "Se informarán las exposiciones en el activo siguiendo lo dispuesto en los puntos 2.1. y 2.2.1. de las normas sobre Ratio de apalancamiento, sin computar los conceptos correspondientes a derivados y operaciones de financiación con títulos valores (SFT), a ser informados en las partidas 45120000 y 45130000",
        "tipo": "presentacion_informativa"
      }
    },
    {
