  "location": "Punto 11.1. Seguimiento de oficializaciones de importación. (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Exterior y Cambios",
      "properties": {
        "materia": "Régimen de exterior y operaciones de cambio",
        "archivo": "TO_exterior_cambios_actual.pdf",
        "version": "vigente"
      }
    },
    {
      "local_id": "e1",
      "type": "Obligacion",
      "label": "Nominar entidad responsable de seguimiento",
      "properties": {
        "descripcion": "Por cada oficialización del despacho de importación, el importador deberá nominar una entidad para que se haga responsable del seguimiento de la oficialización.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Seguimiento de oficialización de importación",
      "properties": {
        "tipo": "seguimiento_oficializacion_importacion"
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Verificar documentación del importador",
      "properties": {
        "descripcion": "Verificar que la documentación presentada por el importador sea consistente con los registros aduaneros considerando las normas de declaración aduanera aplicables al respecto.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Controlar monto de pagos",
      "properties": {
        "descripcion": "Controlar que el monto de los pagos y otros movimientos registrados con imputación al despacho no supere el monto facturado según la condición de compra pactada.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Reportar monto convalidado en SEPAIMPO",
      "properties": {
        "descripcion": "La entidad deberá reportar en el SEPAIMPO cuando se convalide un monto comprendido en el valor facturado según la condición de compra pactada y que no conste en los registros aduaneros por la aplicación de las normas de declaración aduanera.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Verificar encuadre operaciones financiadas",
      "properties": {
        "descripcion": "Verificar, en el caso de operaciones financiadas, que la misma queda encuadrada como una deuda por importaciones de bienes según lo dispuesto en el punto 10.2.4.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Emitir certificaciones para acceso mercado cambios",
      "properties": {
        "descripcion": "Emitir a pedido del importador las certificaciones que habilitarán el acceso al mercado de cambios para el pago de deudas comerciales de importaciones con imputación a oficializaciones de importación bajo su seguimiento.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Verificar requisitos previo a certificación",
      "properties": {
        "descripcion": "La entidad deberá verificar, previamente a emitir cada certificación, el cumplimiento de los requisitos establecidos a la fecha de emisión de la certificación.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Contar con declaración jurada importaciones hasta 31/10/19",
      "properties": {
        "descripcion": "En el caso de una importación oficializada hasta el 31/10/19, previamente a la emisión de la primera certificación con posterioridad a la fecha indicada, la entidad nominada deberá contar con una declaración jurada consignando el detalle de los pagos realizados con imputación por dicha oficialización y el saldo de deuda pendiente a la fecha para la misma.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Emitir certificaciones afectación a pago pendiente",
      "properties": {
        "descripcion": "Emitir a pedido del importador las certificaciones para afectar la oficialización del despacho de importación bajo seguimiento a un pago de importaciones con registro aduanero pendiente.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Verificar correspondencia pago con operación",
      "properties": {
        "descripcion": "La entidad deberá verificar, previamente a emitir cada certificación, la correspondencia del pago con la operación oficializada.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Emitir certificaciones deudas no comerciales",
      "properties": {
        "descripcion": "Emitir a pedido del importador las certificaciones que habilitarán el acceso al mercado de cambios para la cancelación al exterior de deudas originadas en la importación argentina de bienes que no encuadran como deudas comerciales.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Emitir certificaciones para suscripción BOPREAL",
      "properties": {
        "descripcion": "Emitir a pedido del importador las certificaciones que habilitarán la suscripción de Bonos para la Reconstrucción de una Argentina Libre (BOPREAL) por los despachos con registro de ingreso aduanero hasta el 12/12/23 cuando se cumplan los requisitos previstos en el punto 4.4.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e14",
      "type": "Obligacion",
      "label": "Inhabilitar ZFI y reportar ZFE",
      "properties": {
        "descripcion": "Por los bienes ingresados a zona franca sin una venta de bienes de un no residente a un residente, la entidad deberá inhabilitar el ZFI para la realización de pagos y reportar en el SEPAIMPO los ZFE con transferencia aduanera de dominio, asociados al ZFI por los cuales se le ha solicitado la emisión de una certificación.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Emitir certificaciones para seguimiento ingreso divisas exportación",
      "properties": {
        "descripcion": "Emitir a pedido del importador certificaciones con el detalle correspondiente para que la entidad encargada del seguimiento del ingreso de divisas de exportaciones de bienes pueda realizar la imputación al cumplimiento del permiso de embarque en función de la normativa aplicable.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Emitir certificaciones anticipos exportación",
      "properties": {
        "descripcion": "Emitir a pedido del importador certificaciones con el detalle correspondiente para que la entidad encargada del Seguimiento de anticipos y otras financiaciones de exportación de bienes pueda convalidar la aplicación de divisas en el marco del mecanismo dispuesto en el punto 7.11.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Reportar circunstancias que modifiquen obligaciones",
      "properties": {
        "descripcion": "Reportar al BCRA todas las otras circunstancias de las que tomen conocimiento y que modifiquen las obligaciones con el exterior del importador por el despacho.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Registrar baja de diferencia valor aduanero",
      "properties": {
        "descripcion": "Registrar en el SEPAIMPO la baja del valor correspondiente a la diferencia entre el valor aduanero del despacho correspondiente a la condición de compra pactada, y el valor que consta en la factura de compra, cuando este último sea menor.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e19",
      "type": "Obligacion",
      "label": "Mantener registro de certificaciones emitidas",
      "properties": {
        "descripcion": "Mantener un registro de las certificaciones emitidas, de las anuladas y otros movimientos con imputación al despacho. Este registro será considerado información a disposición del BCRA.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e20",
      "type": "Obligacion",
      "label": "Archivar documentación de seguimiento",
      "properties": {
        "descripcion": "Archivar a disposición del BCRA toda la documentación utilizada en el marco del seguimiento del despacho.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e21",
      "type": "Restriccion",
      "label": "Exclusión entidades que optaron por no operar comercio exterior",
      "properties": {
        "descripcion": "Serán elegibles para el importador, quedando obligadas a llevar a cabo las responsabilidades asociadas al presente seguimiento, todas las entidades financieras y casas de cambio salvo aquellas que hayan notificado al BCRA que han optado por no operar en comercio exterior.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e22",
      "type": "Operacion",
      "label": "Emisión de certificación",
      "properties": {
        "tipo": "emision_certificacion"
      }
    },
    {
      "local_id": "e23",
      "type": "Restriccion",
      "label": "Emisión certificaciones ZF tras inhabilitar ZFI",
      "properties": {
        "descripcion": "La emisión de estas certificaciones sólo se podrá realizar una vez inhabilitado el ZFI.",
        "tipo": "limite_cualitativo"
      }
    },
