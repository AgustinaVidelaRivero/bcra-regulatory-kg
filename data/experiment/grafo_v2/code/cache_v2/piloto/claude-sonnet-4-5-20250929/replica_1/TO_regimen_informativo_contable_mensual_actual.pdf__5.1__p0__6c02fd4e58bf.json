    {
      "local_id": "o1",
      "type": "Obligacion",
      "label": "Determinar exigencia de capital por riesgo operacional",
      "properties": {
        "descripcion": "Se determinará mensualmente por la expresión: CRO = BIC x ILM, donde CRO es la exigencia de capital por riesgo operacional para entidades del Grupo 1",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Cálculo exigencia riesgo operacional Grupo 1",
