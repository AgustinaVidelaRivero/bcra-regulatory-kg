      "label": "Régimen Informativo Contable Mensual",
      "properties": {
        "materia": "Régimen informativo contable mensual",
        "archivo": "TO_regimen_informativo_contable_mensual_actual.pdf",
        "version": "actual"
      }
    },
    {
      "local_id": "e1",
      "type": "Obligacion",
      "label": "Determinar exigencia por riesgo operacional Grupo 1",
      "properties": {
        "descripcion": "Se determinará mensualmente por la siguiente expresión: CRO = BIC x ILM",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Cálculo exigencia riesgo operacional Grupo 1",
      "properties": {
        "tipo": "calculo_de_exigencia_de_capital"
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Informar componente BIC",
      "properties": {
        "descripcion": "La partida correspondiente al BIC, se informará por el importe calculado en función de los coeficientes marginales que corresponda",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Informar importes de cada componente",
      "properties": {
        "descripcion": "En las partidas correspondientes a cada componente, se informarán los importes que surjan de realizar los cálculos para su determinación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Informar cada término reexpresado por inflación",
      "properties": {
        "descripcion": "Cada término dentro de los 3 componentes y el resultado monetario debe ser informado, respecto de cada uno de los 3 períodos de 12 meses, reexpresados por inflación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Determinar exigencia por riesgo operacional Grupo 2",
      "properties": {
        "descripcion": "Se determinará mensualmente por la siguiente expresión: CRO = suma de (a*IB) dividido n, donde a es 15% y n es el número de períodos de 12 meses consecutivos en los cuales el IB es positivo",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "e7",
      "type": "Operacion",
      "label": "Cálculo exigencia riesgo operacional Grupo 2",
      "properties": {
        "tipo": "calculo_de_exigencia_de_capital"
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Exigencia mínima cuando n=0",
      "properties": {
        "descripcion": "Si n = 0: deberá observarse una exigencia equivalente al límite previsto en el punto 7.3. de las normas sobre Capitales mínimos de las entidades financieras",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Informar resultados reexpresados",
      "properties": {
        "descripcion": "A efectos de informar los resultados de cada uno de los períodos de 12 meses, corresponderá realizar la reexpresión de cada concepto comprendido desde su mes de origen hasta el cierre del período de cálculo de los 36 meses",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Informar reducción de exigencia",
      "properties": {
        "descripcion": "Se informará la correspondiente reducción de exigencia en las partidas 36000001 ó 36000004 cuando los límites aplicables sobre el promedio de las exigencias por riesgo crediticio de los 36 meses anteriores al bajo informe, resulte inferior al informado en el código 70300000",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e11",
      "type": "Operacion",
      "label": "Cálculo reducción de exigencia",
      "properties": {
        "tipo": "calculo_de_reduccion"
      }
    },
    {
      "local_id": "e12",
      "type": "Restriccion",
      "label": "Alcance reducción Grupo A, B, C",
      "properties": {
        "descripcion": "La presente reducción de exigencia regirá para entidades del Grupo 2 que pertenezcan a los Grupos A, B y C y no sean subsidiarias o sucursales de entidades de importancia sistémica global (G-SIB)",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Informar reducción límites especiales",
      "properties": {
        "descripcion": "Cuando la calificación de la entidad en todos los aspectos previstos en las pertinentes disposiciones normativas permita la aplicación de porcentajes menores a los indicados en el punto 5.1.3.2., las reducciones de exigencia resultantes se reflejarán en las partidas 36000002, 36000003, 36000005 o 36000006",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e14",
      "type": "Obligacion",
      "label": "Informar una sola partida 3600000Y",
      "properties": {
        "descripcion": "Se informará una sola partida 3600000Y, reflejando la situación de la entidad respecto de su calificación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Determinar exigencia para nuevas entidades",
      "properties": {
        "descripcion": "La exigencia mensual de capital mínimo por riesgo operacional se determinará teniendo en cuenta lo dispuesto en las normas sobre Capitales mínimos de las entidades financieras",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
