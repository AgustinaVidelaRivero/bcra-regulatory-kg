      "label": "Cálculo exigencia riesgo de crédito",
      "properties": {
        "descripcion": "Exigencia por riesgo de crédito sin incluir el término INC: Código 70100000 (n) = k x 0,08 [ ∑(A x p) + ∑ (PFB x CCF x p) + ∑ (12300000 x p) + (∑ 13X00000 + 14000000 + 86300000) x 12,5 + 15000000 ]",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e2",
      "type": "Obligacion",
      "label": "Cálculo riesgo tasa de interés",
      "properties": {
        "descripcion": "Cálculo del riesgo de tasa de interés en la cartera de inversión - Medida de riesgo EVE estandarizada. Se consignará el importe máximo de los registrados en las partidas 3650000X, es decir, se toma la máxima pérdida registrada para los 6 escenarios posibles.",
        "tipo": "calculo",
        "frecuencia": "último mes de cada trimestre"
      }
    },
    {
      "local_id": "e3",
      "type": "Restriccion",
      "label": "Umbral entidad atípica por riesgo",
      "properties": {
        "descripcion": "Cuando esta medida supere el 15 % del nivel de capital 1, se identificará a la entidad como una entidad atípica",
        "tipo": "limite_cuantitativo",
        "umbral": "15% del nivel de capital 1"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Informar valores en custodia FGS",
      "properties": {
        "descripcion": "Los bancos comerciales que ejerzan la función de custodia de los títulos representativos de las inversiones del Fondo de Garantía de Sustentabilidad del Sistema Integrado Previsional Argentino (FGS), informarán el importe total de esos valores en custodia, sobre la base de los saldos al cierre de cada mes.",
        "tipo": "presentacion_informativa",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Informar letras hipotecarias escriturales",
      "properties": {
        "descripcion": "Los bancos comerciales que ejerzan la función de agente de registro de letras hipotecarias escriturales informarán el importe total de esas letras, neto de las amortizaciones efectivizadas.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Cálculo responsabilidad patrimonial computable",
      "properties": {
        "descripcion": "Responsabilidad patrimonial computable: (CO -CD ) + (CA -CD ) + (PNc-CD )",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Cálculo exigencia riesgo operacional",
