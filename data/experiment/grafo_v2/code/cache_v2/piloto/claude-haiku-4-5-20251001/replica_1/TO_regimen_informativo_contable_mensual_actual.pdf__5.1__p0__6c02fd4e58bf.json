{
  "chunk_id": "TO_regimen_informativo_contable_mensual_actual.pdf::5.1__p0",
  "doc": "TO_regimen_informativo_contable_mensual_actual.pdf",
  "location": "Punto 5.1. Normas de procedimiento (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Régimen Informativo Contable Mensual",
      "properties": {
        "materia": "Régimen Informativo Contable Mensual",
        "archivo": "TO_regimen_informativo_contable_mensual_actual.pdf",
        "version": "actual"
      }
    },
    {
      "local_id": "e1",
      "type": "Operacion",
      "label": "Determinación de exigencia por riesgo operacional",
      "properties": {
        "tipo": "cálculo de exigencia de capital",
        "description": "Se determinará mensualmente la exigencia de capital por riesgo operacional (CRO) mediante la expresión: CRO = BIC x ILM, donde BIC es el componente del indicador de negocio y ILM es el multiplicador de pérdida interna."
      }
    },
    {
      "local_id": "e2",
      "type": "Obligacion",
      "label": "Informar cálculo de CRO por coeficientes marginales",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "La partida correspondiente al BIC se informará por el importe calculado en función de los coeficientes marginales que corresponda, considerando los tramos del BI en categorías de 1, 2 y 3."
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Informar componentes de cálculo reexpresados",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "En las partidas correspondientes a cada componente (ILDC, SC, FC, RM), se informarán los importes que surjan de realizar los cálculos para su determinación, respecto de cada uno de los 3 períodos de 12 meses, reexpresados por inflación."
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Reexpresar resultados por inflación",
      "properties": {
        "tipo": "calculo",
        "plazo": "mensual",
        "description": "Cada término dentro de los 3 componentes y el resultado monetario debe ser informado, reexpresado desde el mes de origen de cada concepto hasta el cierre del período de cálculo de los 36 meses."
      }
    },
    {
      "local_id": "e5",
      "type": "Operacion",
      "label": "Cálculo de exigencia Grupo 2",
      "properties": {
        "tipo": "cálculo de exigencia de capital",
        "description": "Se determinará mensualmente para entidades del Grupo 2 mediante la expresión: CRO = ∑(a*IBt)/n, donde a = 15%, n es el número de períodos de 12 meses consecutivos con IB positivo (máximo 3), e IBt es el ingreso bruto de esos períodos."
      }
    },
    {
      "local_id": "e6",
      "type": "Restriccion",
      "label": "Exigencia mínima cuando n = 0",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Si n = 0, deberá observarse una exigencia equivalente al límite previsto en el punto 7.3 de las normas sobre Capitales mínimos de las entidades financieras."
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Informar resultados de períodos de 12 meses",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "A efectos de informar los resultados de cada uno de los períodos de 12 meses, corresponderá realizar la reexpresión de cada concepto comprendido desde su mes de origen hasta el cierre del período de cálculo de los 36 meses."
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Aplicabilidad a Grupo 2 sin G-SIB",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La presente reducción de exigencia regirá para entidades del Grupo 2 que pertenezcan a los Grupos A, B y C y no sean subsidiarias o sucursales de entidades de importancia sistémica global (G-SIB)."
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Informar reducción de exigencia por límite general",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "Se informará la correspondiente reducción de exigencia en las partidas 36000001 ó 36000004 cuando los límites aplicables sobre el promedio de las exigencias por riesgo crediticio de los 36 meses anteriores al bajo informe resulte inferior al informado en el código 70300000, aplicando los porcentajes por entidad (A: 20%, B: 17%, C: 14%)."
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Informar reducciones por límites especiales",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "Cuando la calificación de la entidad permita la aplicación de porcentajes menores a los indicados en el punto 5.1.3.2, las reducciones de exigencia resultantes se reflejarán en las partidas 36000002, 36000003, 36000005 o 36000006, siempre que su importe resulte inferior al registrado en la partida 70300000."
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Aplicar calificación para cálculo de exigencia",
      "properties": {
        "tipo": "calculo",
        "plazo": "al tercer mes siguiente a notificación",
        "description": "Se considerará la última calificación informada para el cálculo de la exigencia que corresponda integrar al tercer mes siguiente a aquel en que tenga lugar la notificación."
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Informar una única partida por calificación",
      "properties": {
        "tipo": "presentacion_informativa",
        "plazo": "mensual",
        "description": "Se informará una sola partida 3600000Y, reflejando la situación de la entidad respecto de su calificación; el promedio de las exigencias por riesgo de crédito se calculará en esta Institución en base a los datos sobre exigencia por riesgo de crédito informada en los períodos previos."
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Determinar exigencia para nuevas entidades",
      "properties": {
        "tipo": "calculo",
        "description": "La exigencia mensual de capital mínimo por riesgo operacional para nuevas entidades se determinará teniendo en cuenta lo dispuesto en las normas sobre 'Capitales mínimos de las entidades financieras'."
      }
    },
    {
