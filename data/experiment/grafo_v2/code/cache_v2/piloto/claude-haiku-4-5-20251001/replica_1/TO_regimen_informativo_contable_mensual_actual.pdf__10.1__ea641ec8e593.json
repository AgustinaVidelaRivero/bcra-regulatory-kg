      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Informe con frecuencia trimestral",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Los datos se informarán con frecuencia trimestral, sobre base individual y consolidada trimestral",
        "frecuencia": "trimestral"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Cálculo medida del capital",
      "properties": {
        "tipo": "calculo",
        "description": "PNb = Códigos [70210000 – 70220000 + 70230000 – 70240000], según lo previsto en la Sección 6. Responsabilidad Patrimonial Computable"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Cálculo medida de exposición",
      "properties": {
        "tipo": "calculo",
        "description": "Ratio de apalancamiento = [Medida del capital / Medida de la exposición] * 100 = [PNb / ∑ Códigos (45110000 a 45140000)] * 100"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Informe exposiciones activo",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informarán las exposiciones en el activo siguiendo lo dispuesto en los puntos 2.1. y 2.2.1. de las normas sobre 'Ratio de apalancamiento', sin computar derivados y operaciones de financiación con títulos valores"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Informe exposiciones por derivados",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informarán las exposiciones por derivados siguiendo lo dispuesto en los puntos 2.1. y 2.2.2. de las normas sobre 'Ratio de apalancamiento'"
      }
    },
    {
      "local_id": "obl7",
