      "label": "Informe ratio de apalancamiento",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informará el ratio de apalancamiento y sus componentes según el modelo de información previsto en el punto 10.2., de conformidad con lo dispuesto en las normas sobre 'Ratio de apalancamiento'"
      }
    },
    {
