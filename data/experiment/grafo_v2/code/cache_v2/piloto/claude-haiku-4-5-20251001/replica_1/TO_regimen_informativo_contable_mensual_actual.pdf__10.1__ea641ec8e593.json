      "label": "Informe exposiciones por operaciones SFT",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informarán las exposiciones por financiación con valores conforme a lo dispuesto en los puntos 2.1. y 2.2.3. de las normas sobre 'Ratio de apalancamiento'"
      }
    },
    {
