      "label": "Cumplimiento informativo por entidades financieras",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "El presente requerimiento deberá ser cumplido por todas las entidades financieras",
        "plazo": "trimestral"
      }
    },
