      }
    },
    {
      "local_id": "o4",
      "type": "Operacion",
      "label": "Mejora de clasificación del deudor",
      "properties": {
        "tipo": "mejora de clasificación"
      }
    },
    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Evaluación de capacidad de pago de deudores",
      "properties": {
        "descripcion": "Los análisis previos al otorgamiento de las financiaciones y refinanciaciones deben guardar relación con la capacidad de pago de los deudores, evaluando la afectación de sus ingresos periódicos por la totalidad de los compromisos de crédito asumidos.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Consideración de pauta de mayor riesgo en discrepancias",
      "properties": {
        "descripcion": "En caso de discrepancias entre pautas de clasificación, se deberá considerar la pauta que indique el mayor nivel de riesgo de incobrabilidad.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Consideración de pautas específicas para mejora clasificatoria",
      "properties": {
        "descripcion": "A fin de determinar una mejora en la clasificación del deudor que haya sido recategorizado en niveles inferiores por atraso, corresponderá tener en cuenta las pautas específicas previstas en cada una de las categorías, en función de la cancelación de las cuotas mínimas o del porcentaje de cancelación del saldo.",
        "tipo": "calculo"
      }
    }
  ],
