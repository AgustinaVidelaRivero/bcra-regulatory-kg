    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Clasificación por cumplimiento objetivo",
      "properties": {
        "descripcion": "La clasificación de clientes se efectuará considerando -al cabo de cada mes- exclusivamente pautas objetivas vinculadas al grado de cumplimiento de las correspondientes obligaciones o su situación jurídica, las informaciones de la Central de deudores del sistema financiero, de la base de Deudores en situación irregular de ex entidades financieras y la situación que surja de la aplicación de las pautas de refinanciación.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Prohibición de mejora clasificatoria en atraso mayor a 31 días",
      "properties": {
        "descripcion": "No se podrán efectuar mejoras en las clasificaciones de los clientes, si los mismos registran un atraso mayor a 31 días en el pago de sus obligaciones refinanciadas.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Exclusión de nuevas financiaciones en cumplimiento obligatorio",
      "properties": {
        "descripcion": "El cumplimiento de las obligaciones tiene lugar cuando no se recurra a nuevas financiaciones o refinanciaciones destinadas a cancelar obligaciones preexistentes, cualquiera sea la modalidad (prórrogas, esperas, ampliaciones de plazo o márgenes, disminuciones en los importes de las cuotas o pagos, renovaciones, reestructuraciones, etc.).",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e1",
      "type": "Excepcion",
      "label": "Excepción para refinanciaciones bajo Ley de Emergencia Agropecuaria",
      "properties": {
        "descripcion": "No se considerarán como nuevas financiaciones las refinanciaciones otorgadas a productores cuando ello resulte de la aplicación de disposiciones vinculadas a la Ley de Emergencia Agropecuaria, sin perjuicio de lo cual, a los fines de la clasificación, deberá tenerse en cuenta la mora en el atraso de sus obligaciones para el momento en que concluya la vigencia de la emergencia declarada."
      }
    },
    {
      "local_id": "e2",
      "type": "Excepcion",
      "label": "Excepción para facilidades adicionales y renovaciones de crédito",
      "properties": {
        "descripcion": "No se considerarán comprendidas en la definición de nuevas financiaciones: i) las facilidades adicionales respecto de márgenes vigentes, siempre que impliquen nuevos desembolsos y no superen el 10% del cupo asignado; ii) las renovaciones periódicas de crédito para capital de trabajo ni las nuevas financiaciones asociadas a expansión de actividades, siempre que sean consistentes con el curso normal de los negocios y exista capacidad para atender el resto de obligaciones."
      }
    },
    {
      "local_id": "e3",
      "type": "Excepcion",
      "label": "Excepción para exceso de márgenes de crédito por líneas específicas",
      "properties": {
        "descripcion": "Cuando se hayan asignado márgenes de crédito por líneas específicas y éstos se excedan, tales situaciones no serán consideradas refinanciaciones siempre que no se supere el límite de la asistencia máxima acordada por todo concepto."
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Clasificación de deudor",
      "properties": {
        "tipo": "clasificación de deudor"
      }
    },
    {
      "local_id": "o2",
