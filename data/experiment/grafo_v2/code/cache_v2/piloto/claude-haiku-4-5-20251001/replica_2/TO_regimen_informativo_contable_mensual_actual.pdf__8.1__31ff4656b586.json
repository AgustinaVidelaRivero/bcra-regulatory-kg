      "local_id": "op1",
      "type": "Operacion",
      "label": "Cálculo de exigencia por riesgo de crédito",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo de la exigencia por riesgo de crédito sin incluir el término INC mediante la fórmula: Código 70100000 (n) = k x 0,08 [ ∑(A x p) + ∑ (PFB x CCF x p) + ∑ (12300000 x p) + (∑ 13X00000 + 14000000 + 86300000) x 12,5 + 15000000 ]"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Cálculo riesgo tasa interés cartera",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo del riesgo de tasa de interés en la cartera de inversión mediante Medida de riesgo EVE estandarizada. Se consigna el importe máximo de los registrados en las partidas 3650000X, tomando la máxima pérdida para los 6 escenarios posibles (sólo se informa el último mes de cada trimestre)."
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Límite de riesgo de tasa interés",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "15%",
        "description": "Cuando la medida de riesgo EVE supere el 15 % del nivel de capital 1, se identificará a la entidad como una 'entidad atípica'"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Adoptar medidas específicas riesgo",
      "properties": {
        "tipo": "otra",
        "description": "Cuando la entidad supere el 15 % del nivel de capital 1, la SEFyC podrá exigirle la adopción de medidas específicas según lo establecido en el punto 5.6. de las normas sobre 'Lineamientos para la gestión de riesgos en las entidades financieras'"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Informe de capital mínimo básico",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Informe del Capital Mínimo Básico según punto 1.2. de las normas sobre 'Capitales mínimos de las entidades financieras' (Código 70700000)"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Informe custodia títulos FGS",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Informe del importe total de títulos representativos de las inversiones del Fondo de Garantía de Sustentabilidad del Sistema Integrado Previsional Argentino (FGS) en custodia, sobre la base de los saldos al cierre de cada mes (Código 70400000)"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Informar custodia títulos FGS",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Los bancos comerciales que ejerzan la función de custodia de los títulos representativos de las inversiones del FGS deberán informar el importe total de esos valores en custodia"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Informe letras hipotecarias",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Informe del importe total de letras hipotecarias escriturales, neto de las amortizaciones efectivizadas (Código 70600000)"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Informar letras hipotecarias",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Los bancos comerciales que ejerzan la función de agente de registro de letras hipotecarias escriturales deberán informar el importe total de esas letras, neto de las amortizaciones efectivizadas"
      }
    },
    {
      "local_id": "op6",
      "type": "Operacion",
      "label": "Cálculo responsabilidad patrimonial",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo de Responsabilidad patrimonial computable: (CO - CD) + (CA - CD) + (PNc - CD) donde CO es capital ordenario, CA es capital adicional, PNc es patrimonio neto contable, todos al nivel n1 (Código 70200000)"
      }
    },
    {
      "local_id": "op7",
      "type": "Operacion",
      "label": "Cálculo exigencia riesgo operacional",
      "properties": {
        "tipo": "calculo",
        "description": "Exigencia por riesgo operacional según el punto 5.1. de las normas sobre 'Lineamientos para la gestión de riesgos' (Código 70300000)"
      }
    },
    {
      "local_id": "op8",
      "type": "Operacion",
      "label": "Cálculo riesgo de mercado",
      "properties": {
        "tipo": "calculo",
        "description": "Exigencia según riesgo de mercado para las posiciones del último día del mes, calculada según el punto 4.1.1. (Código 70800000)"
      }
    },
    {
      "local_id": "op9",
      "type": "Operacion",
      "label": "Informe activos ponderados riesgo",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Informe de los activos ponderados por riesgo (parámetro para el cálculo de los límites mínimos aplicables a los componentes de la RPC), determinados según la expresión: APR = 70100000 /(k * 0,08) + (70300000 - 3600000Y + 70800000) * 12,5"
      }
    }
