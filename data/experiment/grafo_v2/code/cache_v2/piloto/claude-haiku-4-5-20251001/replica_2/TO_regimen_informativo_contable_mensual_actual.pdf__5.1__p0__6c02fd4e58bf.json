{
  "chunk_id": "TO_regimen_informativo_contable_mensual_actual.pdf::5.1__p0",
  "doc": "TO_regimen_informativo_contable_mensual_actual.pdf",
  "location": "Punto 5.1. Normas de procedimiento (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Régimen Informativo Contable Mensual",
      "properties": {
        "materia": "Régimen Informativo Contable Mensual",
        "archivo": "TO_regimen_informativo_contable_mensual_actual.pdf",
        "version": "actual"
      }
    },
    {
      "local_id": "e1",
      "type": "Operacion",
      "label": "Determinación de exigencia CRO",
      "properties": {
        "tipo": "calculo",
        "description": "Se determinará mensualmente la exigencia de capital por riesgo operacional (CRO) mediante la expresión: CRO = BIC x ILM"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Cálculo del componente BIC",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo del componente del indicador de negocio (BIC) = ∑ BI_i x α_i, donde α es coeficiente marginal en función del tramo de BI"
      }
    },
    {
      "local_id": "e3",
      "type": "Operacion",
      "label": "Cálculo de componentes de BI",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo de BI = VA (ILDC_Prom + SC_Prom + FC_Prom + RM_Prom), donde: ILDC = componente de intereses/arrendamientos/dividendos, SC = componente de servicios, FC = componente financiero, RM = resultado monetario"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Informar partida BIC",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La partida correspondiente al BIC se informará por el importe calculado en función de los coeficientes marginales que corresponda"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Informar componentes y términos",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "En las partidas correspondientes a cada componente, se informarán los importes que surjan de realizar los cálculos para su determinación"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Reexpresar términos por inflación",
      "properties": {
        "tipo": "calculo",
        "description": "Cada término dentro de los 3 componentes y el resultado monetario debe ser informado, respecto de cada uno de los 3 períodos de 12 meses, reexpresados por inflación"
      }
    },
    {
      "local_id": "e7",
      "type": "Operacion",
      "label": "Determinación de exigencia para Grupo 2",
      "properties": {
        "tipo": "calculo",
        "description": "Se determinará mensualmente la exigencia por riesgo operacional mediante la expresión: CRO = (∑ a*IB_t) / n, donde a = 15%, n = número de períodos de 12 meses consecutivos con IB positivo (máximo 3)"
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Aplicación de exigencia mínima cuando n=0",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Si n = 0: deberá observarse una exigencia equivalente al límite previsto en el punto 7.3. de las normas sobre Capitales mínimos de las entidades financieras"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Reexpresar resultados por períodos",
      "properties": {
        "tipo": "calculo",
        "description": "A efectos de informar los resultados de cada uno de los períodos de 12 meses, corresponderá realizar la reexpresión de cada concepto desde su mes de origen hasta el cierre del período de cálculo de los 36 meses"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Limitación de aplicabilidad para reducción",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La presente reducción de exigencia regirá para entidades del Grupo 2 que pertenezcan a los Grupos A, B y C y no sean subsidiarias o sucursales de entidades de importancia sistémica global (G-SIB)"
      }
    },
    {
      "local_id": "e11",
      "type": "Operacion",
      "label": "Cálculo de reducción de exigencia límite general",
      "properties": {
        "tipo": "calculo",
        "description": "Cálculo de reducción de exigencia cuando el promedio de exigencias por riesgo crediticio de 36 meses sea inferior al informado en código 70300000: Partida = 70300000 - [coeficiente % * (ERC(n-1) + ... + ERC(n-36)) / 36]"
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Informar reducción de exigencia",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informará la correspondiente reducción de exigencia en las partidas 36000001 ó 36000004 cuando los límites aplicables sobre el promedio de las exigencias por riesgo crediticio resulte inferior al informado en el código 70300000"
      }
    },
    {
      "local_id": "e13",
      "type": "Restriccion",
      "label": "Limitación de reducción por importe",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Las reducciones de exigencia resultantes se reflejarán siempre que su importe resulte inferior al registrado en la partida 70300000"
      }
    },
    {
      "local_id": "e14",
      "type": "Obligacion",
      "label": "Informar una sola partida de exigencia",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se informará una sola partida 3600000Y, reflejando la situación de la entidad respecto de su calificación"
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Determinar exigencia para nuevas entidades",
      "properties": {
        "tipo": "calculo",
        "description": "La exigencia mensual de capital mínimo por riesgo operacional para nuevas entidades se determinará teniendo en cuenta lo dispuesto en las normas sobre Capitales mínimos de las entidades financieras"
      }
    }
  ],
