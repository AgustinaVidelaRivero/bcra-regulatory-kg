    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Cálculo exigencia riesgo operacional Grupo 1",
      "properties": {
        "descripcion": "Se determinará mensualmente por la siguiente expresión: CRO = BIC x ILM, donde CRO es exigencia de capital por riesgo operacional, ILM es multiplicador de pérdida interna igual a 1, BIC es componente del indicador de negocio calculado con coeficientes marginales según tramos de BI",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Determinación exigencia por riesgo operacional",
      "properties": {
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Informar partida BIC",
      "properties": {
        "descripcion": "La partida correspondiente al BIC, se informará por el importe calculado en función de los coeficientes marginales que corresponda",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Informar importes de componentes",
      "properties": {
        "descripcion": "En las partidas correspondientes a cada componente, se informarán los importes que surjan de realizar los cálculos para su determinación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Informar términos reexpresados por inflación",
      "properties": {
        "descripcion": "Cada término dentro de los 3 componentes y el resultado monetario debe ser informado, respecto de cada uno de los 3 períodos de 12 meses, reexpresados por inflación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Cálculo exigencia riesgo operacional Grupo 2",
      "properties": {
        "descripcion": "Se determinará mensualmente por la expresión CRO = (a*IB)/n donde a=15%, n=número de períodos de 12 meses consecutivos con IB positivo (máximo 3), considerando los últimos 36 meses anteriores al mes de cálculo",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Exigencia alternativa si n=0",
      "properties": {
        "descripcion": "Si n = 0: deberá observarse una exigencia equivalente al límite previsto en el punto 7.3. de las normas sobre Capitales mínimos de las entidades financieras",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Reexpresión de resultados para informe",
      "properties": {
        "descripcion": "A efectos de informar los resultados de cada uno de los períodos de 12 meses, corresponderá realizar la reexpresión de cada concepto comprendido desde su mes de origen hasta el cierre del período de cálculo de los 36 meses",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Reducción exigencia Grupos A, B y C",
      "properties": {
        "descripcion": "Reducción de exigencia para entidades del Grupo 2 que pertenezcan a los Grupos A, B y C y no sean subsidiarias o sucursales de entidades de importancia sistémica global (G-SIB)"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Informar reducción de exigencia",
      "properties": {
        "descripcion": "Se informará la correspondiente reducción de exigencia en las partidas 36000001 ó 36000004 cuando los límites aplicables sobre el promedio de las exigencias por riesgo crediticio de los 36 meses anteriores al bajo informe, resulte inferior al informado en el código 70300000",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl9",
      "type": "Obligacion",
      "label": "Informar reducciones por límites especiales",
      "properties": {
        "descripcion": "Cuando la calificación de la entidad en todos los aspectos previstos en las pertinentes disposiciones normativas permita la aplicación de porcentajes menores, las reducciones de exigencia resultantes se reflejarán en las partidas 36000002, 36000003, 36000005 o 36000006",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl10",
      "type": "Obligacion",
      "label": "Informar partida única de reducción",
      "properties": {
        "descripcion": "Se informará una sola partida 3600000Y, reflejando la situación de la entidad respecto de su calificación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl11",
      "type": "Obligacion",
      "label": "Exigencia capital mínimo nuevas entidades",
      "properties": {
        "descripcion": "La exigencia mensual de capital mínimo por riesgo operacional se determinará teniendo en cuenta lo dispuesto en las normas sobre Capitales mínimos de las entidades financieras",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    }
  ],
