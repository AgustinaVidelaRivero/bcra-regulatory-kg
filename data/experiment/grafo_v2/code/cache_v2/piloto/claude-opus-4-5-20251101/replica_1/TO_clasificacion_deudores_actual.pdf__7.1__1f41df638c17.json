      "properties": {
        "tipo": "evaluación crediticia"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Evaluar capacidad de pago antes de otorgar financiaciones",
      "properties": {
        "descripcion": "Los análisis previos al otorgamiento de las financiaciones y refinanciaciones también deben guardar relación con la capacidad de pago de los deudores, evaluando la afectación de sus ingresos periódicos por la totalidad de los compromisos de crédito asumidos.",
        "tipo": "calculo"
      }
    }
