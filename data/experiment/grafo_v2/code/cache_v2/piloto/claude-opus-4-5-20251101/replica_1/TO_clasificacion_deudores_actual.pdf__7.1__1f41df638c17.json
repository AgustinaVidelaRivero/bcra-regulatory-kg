    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Clasificación mensual por pautas objetivas",
      "properties": {
        "descripcion": "La clasificación de estos clientes se efectuará considerando -al cabo de cada mes- exclusivamente pautas objetivas vinculadas al grado de cumplimiento de las correspondientes obligaciones o su situación jurídica, las informaciones que surjan de la Central de deudores del sistema financiero, de la base de Deudores en situación irregular de ex entidades financieras y la situación que surja de la aplicación de las pautas de refinanciación.",
        "tipo": "calculo",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Considerar mayor nivel de riesgo en discrepancias",
      "properties": {
        "descripcion": "En caso de discrepancias, se deberá considerar la pauta que indique el mayor nivel de riesgo de incobrabilidad.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Considerar mora al concluir emergencia agropecuaria",
      "properties": {
        "descripcion": "A los fines de la clasificación, deberá tenerse en cuenta la mora en el atraso de sus obligaciones para el momento en que concluya la vigencia de la emergencia declarada.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Prohibición mejora clasificación con atraso mayor a 31 días",
      "properties": {
        "descripcion": "No se podrán efectuar mejoras en las clasificaciones de los clientes, si los mismos registran un atraso mayor a 31 días en el pago de sus obligaciones refinanciadas.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Prohibición mejora clasificación por emergencia agropecuaria",
      "properties": {
        "descripcion": "El tratamiento que se dispense en ese marco no podrá implicar mejoramiento de la clasificación asignada al cliente en función de su situación individual, preexistente a la emergencia, ni su aplicación extenderse más allá de la vigencia fijada para ella.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Límite facilidades adicionales 10% del cupo",
      "properties": {
        "descripcion": "Las facilidades adicionales que se otorguen respecto de los márgenes vigentes acordados, siempre que el nuevo apoyo crediticio implique nuevos desembolsos de fondos y no supere el 10% del cupo asignado en oportunidad de la última evaluación crediticia del cliente hasta que corresponda ser evaluado nuevamente.",
        "tipo": "limite_cuantitativo",
        "umbral": "10%"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción refinanciaciones por emergencia agropecuaria",
      "properties": {
        "descripcion": "No se considerarán dentro de ese concepto las refinanciaciones otorgadas a productores cuando ello resulte de la aplicación de disposiciones vinculadas a la Ley de Emergencia Agropecuaria."
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción facilidades adicionales y renovaciones",
      "properties": {
        "descripcion": "A fin de verificar el cumplimiento de las obligaciones de naturaleza comercial comprendidas en esta cartera sin recurrir a nuevas financiaciones o a refinanciaciones, no se considerarán comprendidas en esas definiciones: i) las facilidades adicionales que se otorguen respecto de los márgenes vigentes acordados; ii) las renovaciones periódicas de crédito para capital de trabajo ni las nuevas financiaciones y las refinanciaciones asociadas a una mayor inversión derivada de la expansión de las actividades."
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Excepción evaluación capacidad de pago préstamos reducidos",
      "properties": {
        "descripcion": "No será obligatoria la evaluación de la capacidad de pago en función de los ingresos del prestatario, en la medida en que se utilicen métodos específicos de evaluación o se trate de deudores por préstamos de monto reducido en los términos del punto 1.1.3.3. de las normas sobre Gestión crediticia."
      }
    },
    {
      "local_id": "op1",
