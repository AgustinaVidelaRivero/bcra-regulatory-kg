      "properties": {
        "descripcion": "Emitir a pedido del importador las certificaciones que habilitarán el acceso al mercado de cambios para el pago de deudas comerciales de importaciones con imputación a oficializaciones de importación bajo su seguimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Verificar requisitos antes de certificar",
