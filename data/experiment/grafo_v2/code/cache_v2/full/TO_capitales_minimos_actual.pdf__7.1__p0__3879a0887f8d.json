      "label": "Com. A 8204",
      "properties": {
        "codigo": "A-8204",
        "tipo": "A",
        "numero": "8204"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Cálculo de exigencia capital por riesgo operacional",
      "properties": {
        "tipo": "calculo_capital_regulatorio",
        "description": "Determinación mensual de la exigencia de capital por riesgo operacional mediante la expresión C_RO = BIC x ILM"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Determinación del indicador de negocio",
      "properties": {
        "tipo": "calculo_indicador",
        "description": "Cálculo del indicador de negocio (BI) como aproximación al riesgo operacional a partir de información de estados financieros, mediante la expresión BI = VA_Prom(ILDC + SC + FC + RM)"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Cálculo del componente de intereses, arrendamientos y dividendos",
      "properties": {
        "tipo": "calculo_componente",
        "description": "Cálculo del componente ILDC que determina el mínimo entre los ingresos/egresos por intereses y el 5% de activos que devengan intereses, sumado a ingresos por dividendos"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Cálculo del componente de servicios",
      "properties": {
        "tipo": "calculo_componente",
        "description": "Cálculo del componente SC como máximo entre otros ingresos/egresos por operaciones y máximo entre ingresos/egresos por honorarios y comisiones"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Cálculo del componente financiero",
      "properties": {
        "tipo": "calculo_componente",
        "description": "Cálculo del componente FC mediante el resultado neto de cartera de negociación e inversión en valor absoluto"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Calcular promedio de períodos de 12 meses",
      "properties": {
        "tipo": "calculo",
        "description": "Cada término dentro de los 3 componentes y el resultado monetario debe ser calculado como el promedio de los valores de los 3 últimos períodos consecutivos de 12 meses anteriores al mes en que se efectúa el cálculo, expresados en moneda homogénea al cierre del período de cálculo de 36 meses: t, t-1 y t-2",
        "plazo": "mensual"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Determinar partidas netas por período",
      "properties": {
        "tipo": "calculo",
        "description": "Se debe determinar, en primer lugar, el valor de las partidas netas que correspondan (por ejemplo, ingresos por intereses menos egresos por intereses) para cada período de 12 meses consecutivos y, luego, el promedio de los 3 períodos",
        "plazo": "mensual"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Incluir intereses de instrumentos derivados como cobertura",
      "properties": {
        "tipo": "calculo",
        "description": "Se incluyen los intereses de instrumentos financieros derivados contabilizados como coberturas, siempre que sean identificables"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Incluir ingresos por honorarios y comisiones de servicios",
      "properties": {
        "tipo": "calculo",
        "description": "Se incluyen los ingresos por asesoramiento y prestación de servicios, incluso a través de terceros, tales como servicios por cuenta de clientes relacionados con emisión de instrumentos financieros, compensación y pago, gestión de activos, custodia, servicios de pagos, financiaciones estructuradas, titulizaciones, líneas de crédito y garantías"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Excluir egresos por servicios no financieros",
      "properties": {
        "tipo": "calculo",
        "description": "Quedan excluidos los gastos por la contratación externa de servicios no financieros tales como servicios logísticos, informáticos o de recursos humanos"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Incluir ganancias de activos no corrientes",
      "properties": {
        "tipo": "calculo",
        "description": "Se incluyen ganancias que produzcan los activos no corrientes y grupos de activos mantenidos para la venta que no califiquen como operaciones discontinuadas en otros ingresos por operaciones"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Incluir pérdidas de activos no corrientes y eventos operacionales",
      "properties": {
        "tipo": "calculo",
        "description": "Se incluyen pérdidas que produzcan los activos no corrientes, grupos de activos mantenidos para la venta que no califiquen como operaciones discontinuadas, pérdidas por eventos operacionales tales como multas, sanciones, acuerdos extrajudiciales y costo de reemplazo de activos dañados no provisionados en años anteriores"
      }
    }
  ],
