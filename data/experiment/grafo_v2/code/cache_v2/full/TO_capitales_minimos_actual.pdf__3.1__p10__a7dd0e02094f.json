      "label": "Capitales Mínimos",
      "properties": {
        "materia": "Capitales mínimos de las entidades financieras",
        "archivo": "TO_capitales_minimos_actual.pdf",
        "version": "1a"
      }
    },
    {
      "local_id": "com1",
      "type": "Comunicacion",
      "label": "Com. A 6470",
      "properties": {
        "codigo": "A-6470",
        "tipo": "A",
        "numero": "6470"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Prohibición de liquidación inmediata de activos",
      "properties": {
        "descripcion": "No deberán existir disposiciones que requieran la inmediata liquidación de los activos subyacentes a valores de mercado.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Liquidación inmediata de activos subyacentes",
      "properties": {
        "tipo": "liquidación de activos"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Poner a disposición modelo de flujos de fondos",
      "properties": {
        "descripcion": "El originante o fiduciario deberá poner a disposición de los inversores, tanto antes de determinar el precio de los títulos valores como durante la vida de la titulización, el modelo de flujos de fondos de los compromisos o la información que permita a los inversores modelizar apropiadamente la cascada de pagos de la titulización.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Proporcionar políticas y procedimientos de atrasos",
      "properties": {
        "descripcion": "Deberán proporcionarse, en términos claros y consistentes, las políticas y procedimientos, las definiciones, las acciones y los recursos asociados a atrasos, impagos o reestructuraciones de los deudores subyacentes.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Transferir derechos de inversión",
      "properties": {
        "descripcion": "Todos los derechos inherentes a los documentos a cobrar y créditos deberán ser transferidos a la titulización, a los efectos de garantizar a los tenedores de los títulos valores claridad sobre sus derechos y su capacidad de ejercerlos sobre los activos subyacentes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Definir claramente derechos del inversor",
      "properties": {
        "descripcion": "Los derechos del inversor deberán estar claramente definidos en toda circunstancia, incluidos los concernientes a los tenedores con preferencia respecto de los subordinados.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Proveer documentación de titulización",
      "properties": {
        "descripcion": "La documentación provisional inicial –oferta o prospecto provisional– y de apoyo deberá ser provista con anticipación suficiente y de manera clara y efectiva para todos los programas y ofertas.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Revisar documentación con consultores legales",
      "properties": {
        "descripcion": "Toda la documentación deberá ser apropiadamente revisada por consultores legales independientes con anterioridad a su publicación.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Notificar cambios en documentación",
      "properties": {
        "descripcion": "Los inversores deberán ser notificados con la debida anticipación respecto de cualquier cambio en la documentación que pueda afectar los riesgos estructurales de la titulización.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Retener exposición significativa en activos",
      "properties": {
        "descripcion": "El que origine o activamente promocione una titulización deberá retener una exposición significativa en dichos activos que demuestre que tiene un incentivo financiero concreto respecto de su desempeño.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Demostrar habilidades en administración de activos",
      "properties": {
        "descripcion": "Los fiduciarios y administradores deberán demostrar que cuentan con habilidades y experiencia en la administración de los activos subyacentes y del SPE, respaldados por un equipo de gestión con amplia experiencia.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob10",
      "type": "Obligacion",
      "label": "Actuar razonable y prudentemente",
      "properties": {
        "descripcion": "El fiduciario o administrador deberá en todo momento actuar en forma razonable, prudente y oportuna, persiguiendo el mejor interés para los tenedores de los títulos valores.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob11",
      "type": "Obligacion",
      "label": "Documentar políticas de gestión de riesgos",
      "properties": {
        "descripcion": "Las políticas, procedimientos y controles de gestión de riesgos deberán estar bien documentados, adherir a buenas prácticas de mercado y cumplir con la regulación aplicable.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob12",
      "type": "Obligacion",
      "label": "Evaluar sistemas de información y reporte",
      "properties": {
        "descripcion": "Se deberá evaluar si los sistemas de información y las funciones de reporte son adecuados, pudiéndose basar en revisiones de terceros independientes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob13",
      "type": "Obligacion",
      "label": "Incluir disposiciones de resolución de conflictos",
      "properties": {
        "descripcion": "Tanto en la oferta inicial como en la documentación contractual debería incluirse disposiciones que favorezcan la resolución temprana de los conflictos que surjan entre las diferentes clases de tenedores.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob14",
      "type": "Obligacion",
      "label": "Establecer remuneración con incentivos adecuados",
      "properties": {
        "descripcion": "La forma de la remuneración de quienes tengan responsabilidad fiduciaria debería generar incentivos adecuados de modo tal que la ejecución de sus tareas se haga en forma adecuada y oportuna.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob15",
      "type": "Obligacion",
      "label": "Definir claramente obligaciones de participantes",
      "properties": {
        "descripcion": "Las obligaciones contractuales, deberes y responsabilidades de los participantes de la titulización deberán estar claramente definidos en la oferta inicial y en los documentos de apoyo.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob16",
      "type": "Obligacion",
      "label": "Incluir cláusulas de sustitución de fiduciario",
      "properties": {
        "descripcion": "El contrato de fideicomiso deberá incluir el modo de sustitución del fiduciario en el caso de que cese por algunas de las causales previstas.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob17",
      "type": "Obligacion",
      "label": "Contemplar reemplazo de administradores",
      "properties": {
        "descripcion": "Deberían incluirse disposiciones que contemplen el reemplazo de los administradores, los proveedores de cuentas bancarias, las contrapartes en derivados y proveedores de liquidez en caso de incumplimiento o insolvencia.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob18",
      "type": "Obligacion",
      "label": "Informar ingresos y egresos de titulización",
      "properties": {
        "descripcion": "Los reportes de desempeño para los inversores deben distinguir e informar los ingresos y egresos de la titulización, tales como: pagos programados de principal e intereses, rescates, amortizaciones anticipadas, comisiones, cargos, montos en mora y reestructurados.",
        "tipo": "presentacion_informativa"
      }
    }
  ],
