{
  "chunk_id": "TO_proteccion_usuarios_servicios_financieros_actual.pdf::2.2",
  "doc": "TO_proteccion_usuarios_servicios_financieros_actual.pdf",
  "location": "Punto 2.2. Casos especiales.",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Protección de Usuarios Servicios Financieros",
      "properties": {
        "materia": "Protección de los usuarios de servicios financieros",
        "archivo": "TO_proteccion_usuarios_servicios_financieros_actual.pdf",
        "version": "5a/6a"
      }
    },
    {
      "local_id": "com1",
      "type": "Comunicacion",
      "label": "Com. A 7744",
      "properties": {
        "codigo": "A-7744",
        "tipo": "A",
        "numero": "7744"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Prohibición de cobro diferencial por discapacidad visual",
      "properties": {
        "descripcion": "No se podrán cobrar comisiones y/o cargos diferenciales a usuarios con dificultades visuales por ninguna de las prestaciones especiales previstas",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Atención prioritaria a personas con movilidad reducida",
      "properties": {
        "descripcion": "Deberán recibir atención prioritaria en las casas operativas y quedar eximidos de formar la fila correspondiente al resto de los usuarios de servicios financieros",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Provisión de asientos adecuados para personas con movilidad reducida",
      "properties": {
        "descripcion": "En el caso de que deban aguardar para ser atendidos, se les deberá proveer de asientos adecuados",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Equipamiento de cajeros automáticos para usuarios con dificultades visuales",
      "properties": {
        "descripcion": "Los cajeros automáticos destinados a los usuarios con dificultades visuales deberán contar con software reproductor de texto-a-voz, auriculares con conector estándar, teclado con sistema Braille o estándar con relieve resaltado y mecanismo audible y perceptible",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Alcanzar cobertura de cajeros accesibles del 10%",
      "properties": {
        "descripcion": "Los sujetos obligados deberán alcanzar la cobertura del servicio con cajeros automáticos accesibles en al menos el 10 % del total de los equipos instalados, comenzando con aquellos emplazados en las localidades de mayor población",
        "tipo": "otra",
        "plazo": "sin especificar"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Proveer documentación en sistema Braille",
      "properties": {
        "descripcion": "Se deberá dar a estos usuarios la opción de obtener en sistema Braille la documentación asociada a los productos que contratan (condiciones pactadas en los contratos y los resúmenes de cuenta)",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Conservar constancia del ejercicio del derecho a documentación en Braille",
      "properties": {
        "descripcion": "El sujeto obligado deberá conservar constancia de haber permitido el ejercicio de este derecho",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Incluir opciones de accesibilidad en home banking y banca móvil",
      "properties": {
        "descripcion": "Los servicios de banca por Internet (home banking) y banca móvil deberán incluir opciones que permitan a personas con dificultades visuales operar tales sistemas sin el auxilio de terceros",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Implementar reproductor de texto-a-voz en canales digitales",
      "properties": {
        "descripcion": "Los sujetos obligados deberán contar con reproductor de texto-a-voz en el home banking y en la banca móvil para permitir la adecuada lectura de su contenido",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl9",
      "type": "Obligacion",
      "label": "Proporcionar texto alternativo descriptivo en comunicaciones con imágenes",
      "properties": {
        "descripcion": "Las comunicaciones, avisos y/o publicidades que realicen –por sí o a través de terceros– conteniendo imágenes deberán contar con texto alternativo descriptivo mediante reproductor de texto-a-voz",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "obl10",
      "type": "Obligacion",
      "label": "Garantizar acceso igualitario a plataformas operativas sin discriminación",
      "properties": {
        "descripcion": "Cualquiera sea la tecnología y/o el software que se utilice, deberá garantizar que los usuarios con dificultad visual tengan acceso a las mencionadas plataformas operativas, en condiciones de igualdad, evitando cualquier tipo de discriminación",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl11",
      "type": "Obligacion",
      "label": "Promover capacitación en perspectiva de discapacidad y Lengua de Señas",
      "properties": {
        "descripcion": "Las entidades financieras, los PSPCP y los PSI deberán promover la capacitación del personal de atención al público en materia de perspectiva de discapacidad –basada en el principio de accesibilidad– y en la Lengua de Señas Argentina (LSA)",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl12",
      "type": "Obligacion",
      "label": "Facilitar atención con personal capacitado para usuarios con discapacidad auditiva",
      "properties": {
        "descripcion": "Deberán facilitar atención en las casas operativas por medio de personal capacitado y/o de videollamadas con equipos de interpretación de lengua de señas argentina con distribución eficiente de recursos",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl13",
      "type": "Obligacion",
      "label": "Garantizar accesibilidad física en puntos de atención",
      "properties": {
        "descripcion": "La accesibilidad a los puntos de atención al usuario (casas operativas y cajeros automáticos) deberá respetar características apropiadas incluyendo eliminación de escalones, desniveles u obstáculos físicos, instalación de rampas, mantenimiento de espacios amplios y elementos de orientación",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl14",
      "type": "Obligacion",
      "label": "Considerar necesidades de usuarios con discapacidad en renovaciones",
      "properties": {
        "descripcion": "Toda renovación de equipos y/o de instalaciones en los puntos de atención al usuario del sujeto obligado deberá contemplar previamente que las necesidades de usuarios de servicios financieros en estos segmentos poblacionales se encuentren suficientemente atendidas",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl15",
      "type": "Obligacion",
      "label": "Cumplir pautas de accesibilidad Web 2.0 en páginas de Internet",
      "properties": {
        "descripcion": "Las entidades financieras, los PSPCP y los PSI deberán observar lo previsto en la Disposición N° 6/19 de la Oficina Nacional de Tecnología de la Información sobre Pautas de accesibilidad para el contenido Web 2.0 y Criterios de conformidad",
        "tipo": "otra"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Atención al usuario en punto de atención",
      "properties": {
        "tipo": "atención presencial"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Cobro de comisiones por prestaciones especiales",
      "properties": {
        "tipo": "cobro de comisiones"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Provisión de cajeros automáticos",
      "properties": {
        "tipo": "provisión de cajero automático"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Entrega de documentación de productos",
      "properties": {
        "tipo": "entrega de documentación"
      }
    },
    {
