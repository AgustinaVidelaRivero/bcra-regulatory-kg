      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Cálculo de ponderador de riesgo promedio",
      "properties": {
        "tipo": "Cálculo",
        "description": "Calcular el ponderador de riesgo promedio del fondo (PR Prom fondo) dividiendo el total de activos ponderados por riesgo por el total de activos del fondo"
      }
    },
    {
      "local_id": "rest1",
