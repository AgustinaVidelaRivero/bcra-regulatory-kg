      "label": "Capitales Mínimos",
      "properties": {
        "materia": "Capitales Mínimos de las Entidades Financieras",
        "archivo": "TO_capitales_minimos_actual.pdf",
        "version": "6a"
      }
    },
    {
      "local_id": "com1",
      "type": "Comunicacion",
      "label": "Com. A 7443",
      "properties": {
        "codigo": "A-7443",
        "tipo": "A",
        "numero": "7443"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Deducción previsión diferida",
      "properties": {
        "descripcion": "La diferencia positiva resultante de comparar el importe de la previsión regulatoria o la contable correspondiente al balance de saldos al 30.11.19, la mayor de ambas, y la previsión contable por aplicación del punto 5.5 de NIIF 9.",
        "tipo": "limite_cuantitativo"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Deducción saldos a favor impuesto ganancia",
      "properties": {
        "descripcion": "Saldo a favor por aplicación del impuesto a la ganancia mínima presunta –neto de previsiones– que excedan el 10 % del PNb correspondiente al mes anterior y saldos a favor provenientes de activos por impuestos diferidos.",
        "tipo": "limite_cuantitativo",
        "umbral": "10%"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Deducción saldos corresponsalía bancos exterior",
      "properties": {
        "descripcion": "Saldos en cuentas de corresponsalía respecto de bancos del exterior que no cumplan con lo previsto en el punto 3.1. de las normas sobre Evaluaciones crediticias. A los efectos del cumplimiento se deberá contar con calificación internacional de riesgo comprendida en la categoría investment grade.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "No deducción saldos casa matriz bancos exterior",
      "properties": {
        "descripcion": "No se deducirán los saldos en cuentas de corresponsalía registrados respecto de la casa matriz de las sucursales locales de bancos del exterior o de sus sucursales y subsidiarias en otros países.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r5",
      "type": "Restriccion",
      "label": "No deducción saldos bancos controladores",
      "properties": {
        "descripcion": "No se deducirán los saldos en cuentas de corresponsalía registrados respecto de los bancos u otras instituciones financieras del exterior que ejerzan el control de entidades financieras locales constituidas bajo la forma de sociedades anónimas.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r6",
      "type": "Restriccion",
      "label": "No deducción saldos bancos convenios pagos",
      "properties": {
        "descripcion": "No se deducirán los saldos en cuentas de corresponsalía registrados respecto de otros bancos del exterior autorizados a intervenir en los regímenes de convenios de pagos y créditos recíprocos a los que haya adherido el BCRA, así como sus sucursales y subsidiarias.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r7",
      "type": "Restriccion",
      "label": "No deducción sucursales subsidiarias locales",
      "properties": {
        "descripcion": "No se deducirán los saldos en cuentas de corresponsalía registrados respecto de sucursales y subsidiarias de entidades financieras locales.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r8",
      "type": "Restriccion",
      "label": "No deducción saldos operaciones circunstanciales",
      "properties": {
        "descripcion": "No se deducirán los saldos que, con carácter transitorio y circunstancial, se originen por operaciones de clientes, tales como las vinculadas a operaciones de comercio exterior u otro tipo de acreditación ordenada por terceros que no impliquen responsabilidad patrimonial para la entidad.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r9",
      "type": "Restriccion",
      "label": "Deducción títulos no en poder entidad",
      "properties": {
        "descripcion": "Títulos de crédito (títulos valores, certificados de depósitos a plazo fijo y otros) que físicamente no se encuentren en poder de la entidad, salvo que su registro o custodia se encuentre a cargo de BCRA, agentes autorizados por CNV, Clearstream, Euroclear o DTC.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Registro en nota estados financieros",
      "properties": {
        "tipo": "presentación informativa"
      }
    },
    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Dejar constancia de activos deducibles",
      "properties": {
        "descripcion": "En caso de que se mantengan activos deducibles conforme a esta disposición, la entidad deberá dejar constancia de la existencia de tales conceptos en nota a los estados financieros trimestrales y anual, cuantificando el importe que no se admite considerar a los fines de determinar la RPC.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "r10",
      "type": "Restriccion",
      "label": "Deducción títulos gobiernos países extranjeros",
      "properties": {
        "descripcion": "Títulos emitidos por gobiernos de países extranjeros que no cumplan con lo previsto en el punto 3.3. de las normas sobre Evaluaciones crediticias. Esta deducción se efectuará por el importe del mayor saldo registrado durante el mes al que corresponda la determinación de la RPC.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r11",
      "type": "Restriccion",
      "label": "No deducción inversiones obligatorias supervisión consolidada",
      "properties": {
        "descripcion": "No se considerarán las inversiones obligatorias que deban realizar las sucursales o subsidiarias –sujetas al régimen de supervisión consolidada– de entidades financieras locales con motivo de exigencias impuestas por la autoridad monetaria o de control del país donde actúan.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r12",
      "type": "Restriccion",
      "label": "Deducción títulos subordinados otras entidades",
      "properties": {
        "descripcion": "Títulos valores e instrumentos de deuda no contemplados en los puntos 8.4.1.19. y 8.4.2., contractualmente subordinados a los demás pasivos, emitidos por otras entidades financieras. Esta deducción se efectuará por el importe del mayor saldo registrado durante el mes.",
        "tipo": "limite_cuantitativo"
      }
    },
    {
      "local_id": "r13",
      "type": "Restriccion",
      "label": "Deducción accionistas",
      "properties": {
        "descripcion": "Accionistas. Esta es una línea de deducción conforme punto 8.4.1.7.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r14",
      "type": "Restriccion",
      "label": "Deducción inmuebles sin escritura inscripta",
      "properties": {
        "descripcion": "Inmuebles, cualquiera sea la fecha de su incorporación al patrimonio, destinados o no al funcionamiento de la entidad, cuya registración contable no se encuentre respaldada con la pertinente escritura traslativa de dominio debidamente inscripta en el respectivo Registro de la Propiedad Inmueble, excepto los adquiridos mediante subasta judicial.",
        "tipo": "limite_cuantitativo",
        "umbral": "100%"
      }
    },
    {
      "local_id": "r15",
      "type": "Restriccion",
      "label": "Deducción activos intangibles netos",
      "properties": {
        "descripcion": "Activos intangibles, netos de la respectiva depreciación acumulada. Incluye la llave de negocio integrante de la valuación de inversiones significativas en el capital de entidades financieras no sujetas a supervisión consolidada.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r16",
      "type": "Restriccion",
      "label": "Deducción partidas pendientes imputación",
      "properties": {
        "descripcion": "Partidas pendientes de imputación - Saldos deudores - Otras, conforme punto 8.4.1.10.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Deducir activos por requerimiento SEFyC",
      "properties": {
        "descripcion": "Ante requerimiento que formule la SEFyC y con efectividad a la fecha que en cada caso se indique, las entidades financieras deberán deducir los importes de los activos u otros conceptos comprendidos, cuando de los elementos puestos a disposición de los inspectores actuantes surja que las registraciones contables no reflejan en forma precisa la realidad económica y jurídica.",
        "tipo": "otra",
        "plazo": "a la fecha indicada por SEFyC"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Verificar encuadramiento normas tras requerimiento",
      "properties": {
        "descripcion": "La afectación de la RPC por aplicación de lo señalado determinará la obligación de verificar el encuadramiento de las distintas normas que utilicen como base la citada responsabilidad, desde el mes en que tenga efecto el requerimiento formulado.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Ingresar cargos dentro de 10 días hábiles",
      "properties": {
        "descripcion": "En su caso, deberán ingresarse los cargos resultantes dentro del término de 10 días hábiles, contados desde la fecha de notificación del requerimiento.",
        "tipo": "otra",
        "plazo": "10 días hábiles desde notificación"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Abonar intereses por mora si incumplimiento",
      "properties": {
        "descripcion": "En el supuesto de ingreso fuera del término fijado, deberán abonarse los pertinentes intereses por mora que surjan de la aplicación de cada norma infringida.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "r17",
      "type": "Restriccion",
      "label": "Deducción diferencias insuficiencia previsiones",
      "properties": {
        "descripcion": "Diferencias por insuficiencia de constitución de las previsiones por riesgo de incobrabilidad por la aplicación del punto 5.5.",
        "tipo": "limite_cualitativo"
      }
    }
  ],
