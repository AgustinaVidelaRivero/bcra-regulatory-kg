      "properties": {
        "descripcion": "Para financiaciones otorgadas a partir del 13/12/23, la entidad deberá contar con documentación que demuestre que la operación financiada correspondía a una importación de servicios prestada o devengada a partir del 13/12/23",
        "tipo": "presentacion_informativa",
        "plazo": "A partir del 13/12/23"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Verificación de compatibilidad de plazos",
      "properties": {
        "descripcion": "La fecha de vencimiento de la financiación otorgada debe ser compatible con los plazos previstos en el punto 13.2., considerando si el otorgamiento es anterior o posterior a la fecha de prestación o devengamiento del servicio",
        "tipo": "calculo",
        "plazo": "Según lo dispuesto en punto 13.2"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Calificación como deuda comercial requerida",
      "properties": {
        "descripcion": "El acceso al mercado de cambios está condicionado a que la línea de crédito califique como deuda comercial según lo dispuesto en el segundo párrafo del punto 13.1.2",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Plazo de prestación o devengamiento desde 13/12/23",
      "properties": {
        "descripcion": "Para financiaciones otorgadas a partir del 13/12/23, la operación financiada debe corresponder a una importación de servicios prestada o devengada a partir del 13/12/23",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Compatibilidad de plazos con punto 13.2",
      "properties": {
        "descripcion": "La fecha de vencimiento de la financiación debe ser compatible con los plazos previstos en el punto 13.2, considerando: (a) si anterior a prestación/devengamiento, computar desde fecha estimada más 15 días; (b) si posterior, computar desde última fecha mencionada",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Servicios de fletes con plazo a embargo",
      "properties": {
        "descripcion": "En el caso del concepto S30. Servicios de fletes por operaciones de importaciones de bienes encuadrado en punto 10.10.2.1., la financiación se computa hasta la fecha estimada de embarque de los bienes en origen más plazo adicional de 15 días corridos"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Conformidad previa del BCRA para incumplimiento",
      "properties": {
        "descripcion": "Los casos que no cumplan las condiciones requeridas quedarán sujetos a la conformidad previa del BCRA",
        "tipo": "limite_cualitativo"
      }
