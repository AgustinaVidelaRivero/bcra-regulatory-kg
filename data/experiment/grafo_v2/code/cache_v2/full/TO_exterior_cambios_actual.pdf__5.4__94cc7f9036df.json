      "properties": {
        "tipo": "otra",
        "description": "La identificación del cliente será efectuada mediante el uso de firmas electrónicas y/o digitales, en la medida que se cumplan las condiciones previstas por la Ley 25.506 y sus disposiciones reglamentarias"
      }
    },
    {
