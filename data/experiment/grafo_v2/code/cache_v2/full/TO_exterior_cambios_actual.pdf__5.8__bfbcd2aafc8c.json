      "label": "Transferencias de organismos oficiales o privados de jubilación",
      "properties": {
        "descripcion": "Deben corresponder a transferencias efectuadas por organismos oficiales o privados de fondos de jubilaciones y pensiones o fondos compensadores de previsión, a personas humanas residentes en el país (compras de cambio) o en el exterior (ventas de cambio) e identificar el pago a nivel de cada beneficiario del país o del exterior.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Confeccionar boleto a nombre de la entidad cursante",
      "properties": {
        "descripcion": "El boleto deberá ser confeccionado a nombre de la entidad que cursa la operación.",
        "tipo": "otra"
      }
    },
    {
