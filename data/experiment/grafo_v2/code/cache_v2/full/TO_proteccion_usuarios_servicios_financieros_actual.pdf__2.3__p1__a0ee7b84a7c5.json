    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Proporcionar ejemplar de contrato",
      "properties": {
        "descripcion": "Proporcionar o poner a disposición del usuario de servicios financieros un ejemplar del contrato con la firma autorizada del sujeto obligado, dentro de los diez (10) días hábiles de realizada la contratación o de la disponibilidad efectiva del producto o servicio, lo que suceda último",
        "tipo": "presentacion_informativa",
        "plazo": "10 días hábiles"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Utilizar documentación habitual presencial",
      "properties": {
        "descripcion": "Utilizar la documentación habitual que emplean en los contratos presenciales",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Otorgar medios técnicos para detección de errores",
      "properties": {
        "descripcion": "Otorgar al usuario los medios técnicos necesarios para que, antes de la contratación, pueda detectar y subsanar eventuales errores u omisiones en la carga de los datos",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Proporcionar mecanismo de confirmación expresa",
      "properties": {
        "descripcion": "Proporcionarle al usuario un mecanismo de confirmación expresa de la decisión de efectuar la contratación, de forma tal que su silencio no sea considerado como consentimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Asegurar términos descargables e inalterables",
      "properties": {
        "descripcion": "Asegurar que los términos de la contratación puedan ser leídos, descargados y guardados por el usuario de manera inalterable",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Entregar resumen informativo del contrato",
      "properties": {
        "descripcion": "Entregar a los usuarios antes de su formalización un resumen del contrato en el que se sinteticen, en un lenguaje llano y coloquial, los términos y alcances de las principales cuestiones que rigen la contratación con el objetivo de que el usuario comprenda qué contrata, las cuentas y operaciones que son gratuitas, los costos y riesgos para el usuario asociado a la contratación, enfatizando las cláusulas más significativas",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Comisiones y cargos con origen en costo real",
      "properties": {
        "descripcion": "Todas las comisiones, cargos, costos, gastos, seguros y/o cualquier otro concepto –excluyendo la tasa de interés– que los sujetos obligados perciban o pretendan percibir de los usuarios de servicios financieros (comisiones y cargos), deben tener origen en un costo real, directo y demostrable y estar debidamente justificados desde el punto de vista técnico y económico",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Aplicación de comisiones solo por servicios autorizados",
      "properties": {
        "descripcion": "La aplicación de comisiones y/o cargos debe quedar circunscripta a la efectiva prestación de un servicio que haya sido previamente solicitado, pactado y/o autorizado por el usuario",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e11",
      "type": "Restriccion",
      "label": "Cargos no superior a costo de terceros",
      "properties": {
        "descripcion": "El importe de los cargos que el sujeto obligado transfiera a los usuarios no podrá ser superior al que el tercero prestador perciba de particulares, sin intermediarios y en similares condiciones (servicios postales, compañía de seguros, escribanía y registros de propiedad, u otros de índole similar)",
        "tipo": "limite_cuantitativo"
      }
    },
    {
      "local_id": "e12",
      "type": "Restriccion",
      "label": "Comisiones por precancelación total condicionadas",
      "properties": {
        "descripcion": "En el caso de precancelación total, no se admitirá la aplicación de comisiones cuando al momento de efectuarla haya transcurrido al menos la cuarta parte del plazo original de la financiación o 180 días corridos desde su otorgamiento, de ambos el mayor",
        "tipo": "limite_cuantitativo",
        "umbral": "cuarta parte del plazo original o 180 días"
      }
    },
    {
      "local_id": "e13",
      "type": "Restriccion",
      "label": "Prohibición de doble cobro de comisiones",
      "properties": {
        "descripcion": "No corresponde el cobro a los usuarios de conceptos que deriven de la prestación de un servicio cuya comisión o cargo, según corresponda, ya se encuentre incluida en otros conceptos cobrados por el sujeto obligado",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e14",
      "type": "Operacion",
      "label": "Entrega de ejemplar de contrato",
      "properties": {
        "tipo": "entrega de documentación contractual"
      }
    },
    {
      "local_id": "e15",
      "type": "Operacion",
      "label": "Contratación por medios electrónicos",
      "properties": {
        "tipo": "contratación electrónica"
      }
    },
    {
      "local_id": "e16",
      "type": "Operacion",
      "label": "Cobro de comisiones y cargos",
      "properties": {
        "tipo": "cobro de comisiones y cargos"
      }
    },
