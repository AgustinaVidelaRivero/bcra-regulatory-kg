  "location": "Punto 8.4. Responsabilidades de la entidad nominada para el seguimiento del permiso.",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Exterior y Cambios",
      "properties": {
        "materia": "Seguimiento de negociaciones de divisas por exportaciones de bienes (SECOEXPO)",
        "archivo": "TO_exterior_cambios_actual.pdf",
        "version": "2a. Comunicación A 8191"
      }
    },
    {
      "local_id": "e1",
      "type": "Obligacion",
      "label": "Calcular monto de obligación",
      "properties": {
        "descripcion": "La entidad calculará el monto alcanzado por la obligación a partir de la información disponible en el sistema SECOEXPO y la documentación comercial aportada por el exportador.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e2",
      "type": "Obligacion",
      "label": "Verificar consistencia documental",
      "properties": {
        "descripcion": "Deberá verificar que la documentación comercial resulte consistente con los registros aduaneros, considerando las normas de declaración aduanera aplicables.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e3",
      "type": "Restriccion",
      "label": "Determinación del monto FOB más conceptos",
      "properties": {
        "descripcion": "El monto en divisas a ingresar y liquidar por una exportación estará determinado por el valor FOB de la mercadería registrado en la Aduana más el valor de los demás conceptos incluidos en el precio según la condición de venta pactada con el comprador de los bienes.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e4",
      "type": "Restriccion",
      "label": "Documentación y verificación como requisitos excluyentes",
      "properties": {
        "descripcion": "La presentación de documentación comercial por parte del exportador y la verificación de su consistencia con los datos en los registros aduaneros son requisitos excluyentes para que la entidad pueda otorgar una certificación de cumplido para el permiso.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Determinar plazo de ingreso y liquidación",
      "properties": {
        "descripcion": "La entidad deberá determinar el plazo aplicable a cada exportación a partir de lo dispuesto en el punto 7.1.1.",
        "tipo": "otra",
        "plazo": "según punto 7.1.1"
      }
    },
    {
      "local_id": "e6",
      "type": "Restriccion",
      "label": "Plazo para exportación con múltiples productos",
      "properties": {
        "descripcion": "En el caso de que una exportación esté compuesta por distintos productos, el plazo aplicable será aquel que representa una mayor proporción del valor FOB total de la exportación.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Determinar fecha de vencimiento",
      "properties": {
        "descripcion": "La fecha de vencimiento que le corresponde a una exportación será aquella resultante de sumar el plazo aplicable a la fecha de cumplido de embarque otorgada por la Aduana. Si la fecha resultante fuese un día no hábil, el vencimiento se trasladará al primer día hábil siguiente.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Aplicación de ampliación y reducción de plazo",
      "properties": {
        "descripcion": "En caso de ampliación del plazo, el nuevo plazo se aplica tanto a exportaciones embarcadas a partir de la vigencia como a las embarcadas previamente cuyo plazo no esté vencido. En caso de reducción del plazo, este solo rige para operaciones oficializadas a partir de la vigencia del nuevo plazo.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Registrar imputaciones al permiso",
      "properties": {
        "descripcion": "La entidad encargada del seguimiento de un permiso de embarque deberá registrar los montos imputados al mismo por alguna de las modalidades admitidas.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Contar con certificación de liquidación",
      "properties": {
        "descripcion": "En el caso de no haber dado curso a la operación en el mercado de cambios, la entidad deberá contar con una certificación de liquidación emitida por aquella que lo hizo o, en su defecto, una certificación de la utilización de las excepciones de liquidaciones.",
        "tipo": "presentacion_informativa"
      }
    },
    {
