    },
    {
      "local_id": "e3",
      "type": "Restriccion",
      "label": "Prohibición de transferencia de activos en mora",
      "properties": {
        "descripcion": "No se podrán transferir activos en situación de incumplimiento o mora u obligaciones respecto de las cuales el originante o el fiduciario o los demás participantes de la titulización con responsabilidad fiduciaria cuenten con evidencia de un incremento sustancial en las pérdidas esperadas o que se encuentran en gestión de cobranza.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e4",
      "type": "Restriccion",
      "label": "Restricción temporal: verificación de desempeño minorista",
      "properties": {
        "descripcion": "El desempeño se deberá verificar durante un período mínimo de 5 años en el caso de las exposiciones minoristas que se ajusten a la definición prevista en el punto 2.8.1.",
        "tipo": "limite_cuantitativo",
        "umbral": "5 años"
      }
    },
    {
      "local_id": "e5",
      "type": "Restriccion",
      "label": "Restricción temporal: verificación de desempeño otras exposiciones",
      "properties": {
        "descripcion": "Para el resto de las exposiciones, el desempeño deberá verificarse durante 7 años.",
        "tipo": "limite_cuantitativo",
        "umbral": "7 años"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Verificación de condiciones de activos",
      "properties": {
        "descripcion": "El originante o fiduciario deberá verificar que los activos cumplan con las siguientes condiciones: (a) el obligado al pago no ha sido sometido a un proceso de quiebra o reestructuración en los 3 años previos; (b) no cuenta con historial de crédito desfavorable; (c) no cuenta con evaluación que anticipe riesgo significativo; (d) no es objeto de litigios.",
        "tipo": "calculo",
        "plazo": "45 días previos a la fecha de transferencia"
      }
    },
    {
      "local_id": "e7",
      "type": "Restriccion",
      "label": "Restricción de quiebra o reestructuración",
      "properties": {
        "descripcion": "El obligado al pago no ha sido sometido a un proceso de quiebra o de reestructuración de deuda debido a dificultades financieras en los 3 años previos a la fecha de originación, salvo que resulte de aplicación el período de 2 años previsto en el art. 26, inciso 4, de la Ley 25.326.",
        "tipo": "limite_cuantitativo",
        "umbral": "3 años"
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Restricción: historial crediticio desfavorable",
      "properties": {
        "descripcion": "El obligado al pago no cuenta con un historial de crédito desfavorable en algún registro público de crédito.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e9",
      "type": "Restriccion",
      "label": "Restricción: evaluación riesgo incumplimiento",
      "properties": {
        "descripcion": "El obligado al pago no cuenta con una evaluación de una agencia de calificación de créditos o un credit scoring que anticipen un riesgo de incumplimiento significativo.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Prohibición: activos en litigio",
      "properties": {
        "descripcion": "El documento a cobrar o derecho de crédito transferido no es objeto de litigios entre el obligado y el acreedor original.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Registro previo de pago de activo",
      "properties": {
        "descripcion": "Al momento de la inclusión del activo en la cartera de subyacentes, deberá haberse registrado al menos un pago, excepto en el caso de las estructuras sobre activos de tipo rotativos (como tarjetas de crédito, facturas y otras exposiciones cancelables en un solo pago).",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Demostración de originación uniforme",
      "properties": {
        "descripcion": "El originante deberá demostrar al inversor que los activos transferidos han sido generados en el curso normal de su negocio bajo estándares de originación uniformes y consistentes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Comunicación de cambios en estándares",
      "properties": {
        "descripcion": "Cuando los estándares de originación se vean afectados por cambios, el originante deberá comunicar el momento y el propósito de las modificaciones.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "e14",
      "type": "Restriccion",
      "label": "Estándares no menos rigurosos",
      "properties": {
        "descripcion": "Los estándares no deberán ser menos rigurosos que aquellos aplicados a los activos retenidos por el originante.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Criterios sólidos de originación",
      "properties": {
        "descripcion": "Los documentos a cobrar o derechos de crédito titulizados deberán satisfacer criterios de originación sólidos y prudentes que incluyan una evaluación de la capacidad e intención de los obligados de cumplir puntualmente con sus obligaciones.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Revisión de estándares de terceros",
      "properties": {
        "descripcion": "Cuando los activos hayan sido adquiridos a terceros, el originante/fiduciario de la titulización deberá revisar los estándares de originación de esos terceros y constatar que el acreedor original ha examinado y evaluado la habilidad y voluntad de los obligados.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e17",
      "type": "Restriccion",
      "label": "Selección no discrecional de activos",
      "properties": {
        "descripcion": "El desempeño de la titulización no deberá depender de una selección de los subyacentes a través de la gestión activa y discrecional de la cartera. La selección de los activos deberá estar sujeta a criterios de elegibilidad claramente definidos, tales como el tamaño de la obligación, la edad del sujeto de crédito y los ratios LTV, DTI y/o DSC.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e18",
      "type": "Restriccion",
      "label": "Prohibición de gestión activa post-titulización",
      "properties": {
        "descripcion": "Los documentos a cobrar y créditos transferidos luego de la fecha en que se concreta la titulización no deberán ser seleccionados de manera discrecional ni gestionados de forma activa.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e19",
      "type": "Obligacion",
      "label": "Principio de transferencia real",
      "properties": {
        "descripcion": "A efectos de cumplir con el principio de transferencia real, deberá realizarse una cesión efectiva de derechos de forma tal que los documentos a cobrar y derechos de crédito cumplan con: (a) constituir una deuda de los respectivos obligados; (b) estar fuera del alcance del cedente y sus acreedores; (c) haber sido objeto de una cesión de créditos; (d) proporcionar un derecho efectivo contra el último obligado y no constituir una retitulización.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e20",
      "type": "Obligacion",
      "label": "Garantía de no afectación de activos",
      "properties": {
        "descripcion": "El contrato de cesión de los créditos deberá contener cláusulas por las cuales el originante garantice que los documentos a cobrar o los créditos transferidos no están afectados en garantía ni sujetos a ninguna otra condición o gravamen que afecten el cobro.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e21",
      "type": "Obligacion",
      "label": "Opinión legal independiente",
      "properties": {
        "descripcion": "La documentación que instrumente la titulización deberá incluir una opinión legal independiente que respalde que la transferencia real y la cesión de derechos se ajustan a lo indicado en los apartados anteriores.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Titulización de activos",
      "properties": {
        "tipo": "titulización"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Transferencia de activos",
      "properties": {
        "tipo": "transferencia de derechos de crédito"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Selección de subyacentes",
      "properties": {
        "tipo": "selección de activos"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Cesión de créditos",
      "properties": {
        "tipo": "cesión de derechos de crédito"
      }
    }
