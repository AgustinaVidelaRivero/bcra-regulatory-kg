  "location": "Punto 14.5. Otras disposiciones. (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Exterior y Cambios",
      "properties": {
        "materia": "Régimen de Incentivo para Grandes Inversiones (RIGI)",
        "archivo": "TO_exterior_cambios_actual.pdf",
        "version": "1a"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Prohibición de acumulación de beneficios cambiarios",
      "properties": {
        "descripcion": "Los beneficios cambiarios del RIGI no podrán ser acumulados con otros incentivos cambiarios existentes o que se creen a futuro.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Límite de mecanismos cambiarios para VPU",
      "properties": {
        "descripcion": "Cualquier mecanismo previsto en las normas cambiarias que tome en consideración el valor pendiente del endeudamiento y/o el valor de las próximas cuotas de capital o intereses sólo estará disponible para el VPU hasta la proporción de los fondos recibidos por la financiación que pueden computarse como ingresada y liquidada por el mercado de cambios.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Límite de mecanismos cambiarios para inversión directa extranjera",
      "properties": {
        "descripcion": "Cualquier mecanismo previsto en las normas cambiarias que tome en consideración el valor de los aportes de inversión directa extranjera sólo estará disponible para el VPU adherido hasta el valor que surja de la suma de los aportes contemplados en los incisos i) y ii) del punto 14.2.2.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Cómputo de financiaciones como ingresadas y liquidadas",
      "properties": {
        "tipo": "computación de financiaciones en mercado de cambios"
      }
    },
    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Verificación de condiciones para financiaciones RIGI",
      "properties": {
        "descripcion": "Las financiaciones enunciadas en los puntos 14.2.1.8. al 14.2.1.11. podrán ser computadas como ingresadas y liquidadas en el mercado de cambios por un VPU adherido al RIGI cuando una entidad financiera local seleccionada por el VPU haya verificado el cumplimiento de la totalidad de las condiciones especificadas.",
        "tipo": "otra",
        "plazo": "previo al cómputo"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Demostración de registro aduanero de bienes",
      "properties": {
        "descripcion": "El VPU haya demostrado el registro de ingreso aduanero de los bienes por un valor igual o mayor al monto total de la financiación que será computada como ingresada y liquidada en el mercado de cambios.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Cálculo del valor de bienes con concepto FOB",
      "properties": {
        "descripcion": "A los efectos del valor de los bienes podrá tomarse todo concepto que forme parte de la condición de compra pactada registrada en la factura emitida por el proveedor del exterior.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Declaración jurada sobre bienes accesorios",
      "properties": {
        "descripcion": "La entidad cuente con una declaración jurada del cliente en la cual deje constancia de que los restantes bienes son repuestos, accesorios o materiales necesarios para el funcionamiento, construcción o instalación de los bienes de capital que se están adquiriendo.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Certificación SEPAIMPO para importaciones",
      "properties": {
        "descripcion": "La entidad deberá contar con la correspondiente certificación de la entidad encargada del seguimiento de pago de importaciones de bienes (SEPAIMPO).",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig6",
      "type": "Obligacion",
      "label": "Registro de financiación ante BCRA mediante RIOC",
      "properties": {
        "descripcion": "La entidad financiera ha concretado el registro de la financiación ante el BCRA a través del régimen informativo de operaciones de cambio (RIOC), una vez verificado el registro de ingreso aduanero de los bienes, mediante la confección de dos boletos sin movimiento de fondos.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "oblig7",
      "type": "Obligacion",
      "label": "Fecha de registro de boletos sin movimiento de fondos",
      "properties": {
        "descripcion": "Los boletos deberán quedar registrados, independientemente de cuál sea el momento en que el cliente solicita su registro ante la entidad financiera, en la fecha en que se produjo el registro de ingreso aduanero de los bienes o en la fecha de aplicación del desembolso en divisas de la financiación, si ésta última fuese posterior a la anterior.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig8",
      "type": "Obligacion",
      "label": "Confección de boleto de compra con código de concepto",
      "properties": {
        "descripcion": "El boleto de compra se confeccionará por un código de concepto que identifique que se trata de una financiación comprendida en este mecanismo, debiendo dejar constancia de la identificación del acreedor.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig9",
      "type": "Obligacion",
      "label": "Registro de monto pendiente de cancelación",
      "properties": {
        "descripcion": "Si la financiación fue otorgada por el propio proveedor, el boleto se registrará por el monto pendiente de cancelación a la fecha del registro del ingreso aduanero de los bienes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig10",
      "type": "Obligacion",
      "label": "Asignación de número APX para seguimiento de exportaciones",
      "properties": {
        "descripcion": "En caso de que el VPU contemple la posibilidad de aplicar cobros de exportaciones de bienes a la cancelación del capital o intereses de la financiación, la entidad deberá asignar el correspondiente número de identificación (número APX) para el 'Seguimiento de anticipos y otras financiaciones de exportación de bienes'.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "oblig11",
      "type": "Obligacion",
      "label": "Confección de boleto de venta",
      "properties": {
        "descripcion": "El boleto de venta se confeccionará por el monto correspondiente con el código de concepto para los pagos diferidos de importaciones de bienes de capital o al pago de fletes de importaciones de los bienes, según corresponda, dejando constancia que el pago se concreta por el presente mecanismo.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig12",
      "type": "Obligacion",
      "label": "Demostración de registro aduanero de aportes en especie",
      "properties": {
        "descripcion": "El VPU haya demostrado el registro de ingreso aduanero del bien de capital por un valor consistente con el monto del aporte que será computado como ingresado y liquidado en el mercado de cambios.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "Límite de proporción mínima de bienes de capital",
      "properties": {
        "descripcion": "La operación podrá incluir bienes que no revistan la condición de bien de capital en la medida que aquellos que lo sean representen como mínimo el 90% (noventa por ciento) del valor FOB total pagado.",
        "tipo": "limite_cuantitativo",
        "umbral": "90%"
      }
    },
