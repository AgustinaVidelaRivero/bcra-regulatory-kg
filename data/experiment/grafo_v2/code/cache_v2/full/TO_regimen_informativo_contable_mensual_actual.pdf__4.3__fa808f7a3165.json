      "label": "Régimen Informativo Contable Mensual",
      "properties": {
        "materia": "Exigencia e integración de capitales mínimos por riesgo de mercado",
        "archivo": "TO_regimen_informativo_contable_mensual_actual.pdf",
        "version": "6a"
      }
    },
    {
      "local_id": "com1",
      "type": "Comunicacion",
      "label": "Com. A 6070",
      "properties": {
        "codigo": "A-6070",
        "tipo": "A",
        "numero": "6070"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Cálculo de exigencia por riesgo de tasa específico",
      "properties": {
        "tipo": "Cálculo de exigencia",
        "description": "Se calculará el total de exigencia por riesgo de tasa específico sumando los códigos 551100/xx + 551200/xx + 551300/xx + 551400/xx + 551500/xx + 551600/xx + 551700/xx, consignándose en el código 311100/xx"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Cálculo de exigencia por riesgo general de tata",
      "properties": {
        "tipo": "Cálculo de exigencia",
        "description": "Los componentes de la exigencia por riesgo general de tasa se calcularán conforme al punto 6.2.2. de las normas sobre Capitales mínimos, y se informarán utilizando los códigos previstos en el punto 4.4.2. a)"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Información sobre posiciones de instrumentos computables",
      "properties": {
        "tipo": "Presentación informativa",
        "description": "Se complementará con información relativa al total de posiciones compradas y vendidas para instrumentos computables (títulos valores y derivados) distribuidas por bandas temporales según plazo residual, conforme al Cuadro del punto 4.4.2. b)"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Reporte de posiciones netas por moneda residual",
      "properties": {
        "tipo": "Presentación informativa",
        "description": "Se determinarán las posiciones netas compradas y netas vendidas para cada moneda no significativa, informándose en las partidas 561000/xx/999/B y 562000/xx/999/B los importes correspondientes a la suma de dichas posiciones por banda"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Cálculo de exigencia por riesgo de cambio",
      "properties": {
        "tipo": "Cálculo de exigencia",
        "description": "El total de exigencia por riesgo de cambio se calculará conforme al punto 6.4.3. de las normas sobre Capitales mínimos, utilizando la fórmula: Código 313000/xx = {Mayor [Código 553200/xx ; Abs (Código 553300/xx)] + Abs (Código 553400)} * 0.08"
      }
    },
    {
      "local_id": "op6",
      "type": "Operacion",
      "label": "Cálculo de posición abierta neta por moneda",
      "properties": {
        "tipo": "Cálculo de exigencia",
        "description": "La posición abierta neta por moneda se obtendrá como la suma de sus componentes: Código 553100/xx/M = Códigos 553110/xx/M + 553120/xx/M + 553130/xx/M + 553140/xx/M + 553150/xx/M"
      }
    },
    {
      "local_id": "op7",
      "type": "Operacion",
      "label": "Cálculo de exigencia por riesgo de posiciones en opciones",
      "properties": {
        "tipo": "Cálculo de exigencia",
        "description": "Se calculará conforme al punto 6.5. de las normas sobre Capitales mínimos, aplicando método simplificado (Código 314000/xx = Código 554100/xx) o método delta plus (Código 314000/xx = Código 554210/xx + Código 554220/xx)"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Cálculo diario de posiciones e integración de exigencia",
      "properties": {
        "tipo": "calculo",
        "description": "Las posiciones en los respectivos instrumentos y los componentes de exigencia se calcularán en forma diaria; no obstante, se informarán únicamente los correspondientes al último día de cada período de información",
        "plazo": "Diario; reporte mensual"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Mantener datos en disposición de la SEFyC",
      "properties": {
        "tipo": "otra",
        "description": "El resto de los días permanecerán en una base a disposición de la SEFyC",
        "plazo": "Permanente"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Aplicar instrucciones de cómputo",
      "properties": {
        "tipo": "otra",
        "description": "Deberán tenerse en cuenta las instrucciones de cómputo del presente punto y los modelos de información previstos en el punto 4.4",
        "plazo": "Aplicable a todo reporte"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Consignar importes sin signo (con excepciones)",
      "properties": {
        "tipo": "otra",
        "description": "Los importes se consignarán sin signo, excepto para aquellos casos en que expresamente se prevea la posibilidad de que se informen con signo negativo",
        "plazo": "Aplicable a todo reporte"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Prohibición de reportar códigos de métodos simultáneamente",
      "properties": {
        "tipo": "prohibicion",
        "description": "Si la entidad informa el código 554100/xx no podrán admitirse los códigos 554210/xx y/o 554220/xx, y viceversa. La entidad podrá aplicar un sólo método de los previstos (simplificado o delta plus)"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Información únicamente del último día del período",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Se informarán únicamente los datos correspondientes al último día de cada período de información, aunque las posiciones y componentes se calculen en forma diaria"
      }
    }
  ],
