    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Conversión de partidas fuera de balance",
      "properties": {
        "tipo": "conversión de partidas fuera de balance a equivalentes crediticios",
        "description": "Las partidas fuera de balance –incluidos compromisos por financiaciones y líneas de corresponsalía a entidades del exterior, garantías otorgadas, avales otorgados, créditos documentarios y aceptaciones, documentos redescontados, otros acuerdos de crédito– se convertirán en equivalentes crediticios utilizando factores de conversión crediticia (CCF)"
      }
    },
    {
      "local_id": "obs1",
      "type": "Obligacion",
      "label": "Aplicar CCF según clasificación de partida",
      "properties": {
        "tipo": "asignacion",
        "description": "Asignar factor de conversión crediticia (CCF) a partidas fuera de balance según su clasificación: sustitutos crediticios directos (100%), partidas contingentes comerciales (50%), cartas de crédito comercial corto plazo (20%), ventas de activos con pacto de recompra (100%), compromisos de adquisición de activos (100%), líneas de emisión de títulos valores (50%), líneas de crédito comprometidas (40%), compromisos cancelables discrecional o automáticamente (10%)"
      }
    },
    {
      "local_id": "obs2",
      "type": "Obligacion",
      "label": "Aplicar ponderadores de riesgo posterior",
      "properties": {
        "tipo": "otra",
        "description": "Luego de aplicar los CCF, aplicar los ponderadores de riesgo establecidos en el punto 2.12 y tener en cuenta las disposiciones establecidas en la Sección 5"
      }
    },
    {
      "local_id": "obs3",
      "type": "Obligacion",
      "label": "Aplicar menor CCF en compromisos",
      "properties": {
        "tipo": "asignacion",
        "description": "Las partidas fuera de balance que refieran a compromisos estarán sujetas al menor de los CCF que resulten aplicables"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Ponderación según activo o contraparte",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Ventas de activos con pacto de recompra, compromisos de adquisición de activos no contabilizados en balance, se ponderarán según el activo y no en función de la contraparte"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Exclusión de títulos en garantía derivados",
      "properties": {
        "description": "Se excluye del tratamiento de ponderación según activo a los títulos entregados en garantía de las operaciones con derivados previstos en el punto 4.2"
      }
    }
  ],
