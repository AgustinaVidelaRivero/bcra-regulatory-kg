      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Ponderador de riesgo 2% para miembros compensadores",
      "properties": {
        "descripcion": "La entidad financiera que actúe en carácter de miembro compensador de una CCP por operaciones propias deberá aplicar un ponderador de riesgo del 2% a sus exposiciones con la CCP originadas en operaciones de derivados, financiación con títulos valores y liquidación diferida",
        "tipo": "limite_cuantitativo",
        "umbral": "2%"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "MPOR mínimo 10 días para derivados OTC",
      "properties": {
        "descripcion": "En todos los casos, se utilizará un MPOR mínimo de 10 días para el cálculo de las exposiciones a una CCP por operaciones de derivados OTC",
        "tipo": "limite_cuantitativo",
        "umbral": "10 días"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Horizonte temporal mínimo 10 días hábiles",
      "properties": {
        "descripcion": "Cuando la CCP reciba el margen de variación de una operación y el activo propiedad del miembro compensador no esté protegido contra la insolvencia de la CCP, el horizonte temporal de riesgo mínimo a aplicar será el menor entre 1 año y el plazo residual de la operación, con un plazo mínimo de 10 días hábiles",
        "tipo": "limite_cuantitativo",
        "umbral": "10 días hábiles"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "MPOR mínimo 5 días para clientes",
      "properties": {
        "descripcion": "Los miembros compensadores podrán calcular la exigencia por la exposición a sus clientes aplicando un período de riesgo de margen que sea, como mínimo, de 5 días",
        "tipo": "limite_cuantitativo",
        "umbral": "5 días"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Determinar exposición según tipo de CCP",
      "properties": {
        "descripcion": "Cuando la entidad financiera realice operaciones con una QCCP deberá determinar su exposición aplicando las disposiciones del punto 4.3.3., mientras que de tratarse de una CCP que no califica serán de aplicación las previsiones del punto 4.3.4",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Aplicar tratamiento derivado OTC",
      "properties": {
        "descripcion": "Cuando se trate de una operación con derivados concertada en un mercado de valores y la transacción entre el miembro compensador y la entidad financiera cliente sea realizada en el marco de un acuerdo bilateral, tanto la entidad financiera cliente como el miembro compensador deberán dar a esa transacción el tratamiento de un derivado OTC y aplicar lo previsto en el acápite ii) del punto 4.3.3.1",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Calcular exposición conforme a SACCR",
      "properties": {
        "descripcion": "La exposición debida a operaciones se calculará conforme al enfoque estandarizado para el riesgo de crédito de contraparte (SACCR) establecido en el punto 4.2 para los derivados OTC o negociados en mercados de valores y operaciones de liquidación diferida",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Transición de QCCP a CCP no calificada",
      "properties": {
        "descripcion": "En los casos en que una CCP deje de calificar como QCCP, durante los tres meses siguientes las operaciones podrán mantener el tratamiento del punto 4.3.3.; finalizado ese plazo será de aplicación el punto 4.3.4"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Exclusión de MPOR mínimo 20 días para grandes nettings",
      "properties": {
        "descripcion": "No se aplicará el plazo mínimo de veinte días hábiles para el cálculo del período de riesgo de margen (MPOR) de los conjuntos de neteo en los que se verifiquen más de 5.000 operaciones en la medida en que no existan disputas pendientes y que dicho conjunto no contenga garantías ilíquidas u operaciones exóticas"
      }
    }
  ],
