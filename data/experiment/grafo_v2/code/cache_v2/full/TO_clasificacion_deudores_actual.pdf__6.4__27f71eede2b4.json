      "type": "Excepcion",
      "label": "Modificación de criterios objetivos de clasificación",
      "properties": {
        "descripcion": "Modificación de alguno de los criterios objetivos de clasificación que surjan de estas normas (término de morosidad, situación jurídica del cliente o de sus deudas, cumplimiento de refinanciaciones y pedidos de refinanciaciones de obligaciones)"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Degradación en Central de deudores del sistema financiero",
      "properties": {
        "descripcion": "Modificación en forma negativa de la clasificación del cliente en la Central de deudores del sistema financiero, llevándola a un grado inferior al de la entidad, por al menos otra entidad financiera o fideicomiso financiero cuyas acreencias representen como mínimo el 10% del total informado por todos los acreedores"
      }
    },
    {
      "local_id": "exc3",
