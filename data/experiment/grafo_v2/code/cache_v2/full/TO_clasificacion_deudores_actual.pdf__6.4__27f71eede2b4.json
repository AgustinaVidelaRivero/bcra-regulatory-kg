      "label": "Notificación de SEFyC sobre ajuste de previsiones",
      "properties": {
        "descripcion": "Notificación de la determinación final de la SEFyC del ajuste de previsiones como consecuencia de tareas de inspección"
      }
    },
    {
      "local_id": "exc4",
      "type": "Excepcion",
      "label": "Discrepancia de más de un nivel en clasificaciones",
      "properties": {
        "descripcion": "Discrepancia de más de un nivel entre la clasificación dada por la entidad financiera y las otorgadas por al menos otras dos entidades o fideicomisos financieros en categorías inferiores, cuyas acreencias en conjunto representen por lo menos el 20% y sean inferiores al 40% del total informado por todos los acreedores"
      }
    },
