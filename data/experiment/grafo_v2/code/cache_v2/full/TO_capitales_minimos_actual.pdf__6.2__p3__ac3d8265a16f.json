        "tipo": "A",
        "numero": "5889"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Exclusión de posiciones compensadas",
      "properties": {
        "descripcion": "Las posiciones compradas y vendidas, reales o nocionales, en idénticos instrumentos se podrán excluir del cómputo del riesgo específico y del riesgo general de mercado",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Criterios de identidad de instrumentos",
      "properties": {
        "descripcion": "Se entiende que los instrumentos son idénticos si tienen igual emisor, cupón, moneda y vencimiento",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Exclusión de futuros y forwards con subyacentes",
      "properties": {
        "descripcion": "Se podrán excluir los futuros o forwards y sus subyacentes, pero sin dejar de computar el lado de la operación que representa el plazo hasta el vencimiento de la operación a término",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Identificación de título subyacente en opciones",
      "properties": {
        "descripcion": "Cuando el futuro o forward permita entregar una gama de instrumentos, la exclusión sólo será posible en la medida que la entidad pueda identificar fácilmente el título subyacente cuya entrega es más conveniente para el intermediario con la posición vendida",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Prohibición de compensación en diferentes monedas",
      "properties": {
        "descripcion": "No se permitirá la exclusión o compensación de posiciones en diferentes monedas",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest6",
      "type": "Restriccion",
      "label": "Obligación de computar swaps de monedas",
      "properties": {
        "descripcion": "Los lados de los swaps de monedas y de los contratos a término sobre monedas se deberán tratar como posiciones nocionales e incluirse en el cálculo correspondiente a cada moneda",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest7",
      "type": "Restriccion",
      "label": "Requisitos para compensación de posiciones",
      "properties": {
        "descripcion": "Para que proceda la exclusión de posiciones opuestas en la misma categoría, las posiciones se deberán referir a los mismos subyacentes, tener el mismo valor nominal y estar denominadas en la misma moneda",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest8",
      "type": "Restriccion",
      "label": "Límite temporal en vencimiento de futuros",
      "properties": {
        "descripcion": "Cuando se trate de futuros, la exclusión sólo procederá si los nocionales e instrumentos subyacentes refieren a productos idénticos y sus vencimientos no difieren en más de 7 días corridos",
        "tipo": "limite_cuantitativo",
        "umbral": "7 días corridos"
      }
    },
    {
      "local_id": "rest9",
      "type": "Restriccion",
      "label": "Correspondencia de tasas en swaps y FRAs",
      "properties": {
        "descripcion": "Cuando se trate de swaps y FRAs, la tasa de referencia de las posiciones a interés variable deberá ser idéntica y deberá haber una correspondencia cercana entre los cupones (dentro de un margen de 15 puntos básicos)",
        "tipo": "limite_cuantitativo",
        "umbral": "15 puntos básicos"
      }
    },
    {
      "local_id": "rest10",
      "type": "Restriccion",
      "label": "Discrepancia de fechas de reajuste en instrumentos derivados",
      "properties": {
        "descripcion": "En los casos de swaps, FRAs y forwards, la próxima fecha de reajuste del interés o el vencimiento se deberá producir: a menos de un mes en el mismo día; entre un mes y un año con discrepancia máxima de 7 días corridos; a un año con discrepancia máxima de 30 días corridos",
        "tipo": "limite_cuantitativo",
        "umbral": "7 y 30 días corridos según plazo"
      }
    },
    {
      "local_id": "rest11",
      "type": "Restriccion",
      "label": "Exclusión de swaps y FRAs de exigencia específica",
      "properties": {
        "descripcion": "Los swaps de monedas y tasas de interés, los FRAs, los forwards de moneda y los futuros de tasa de interés o sobre un índice de tasa de interés no estarán sujetos a exigencia por riesgo específico",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest12",
      "type": "Restriccion",
      "label": "Exigencia de riesgo específico en futuros de títulos",
      "properties": {
        "descripcion": "En el caso de futuros en los que el subyacente sea un título de deuda o un índice que represente una canasta de títulos de deuda, se aplicará la exigencia por riesgo específico acorde al riesgo de crédito del emisor",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest13",
      "type": "Restriccion",
      "label": "Alcance de exigencia de riesgo general de mercado",
      "properties": {
        "descripcion": "La exigencia de capital por el riesgo general de mercado alcanza a todas las posiciones en instrumentos derivados, con la sola excepción de las posiciones que estén compensadas con instrumentos idénticos",
        "tipo": "limite_cualitativo"
      }
    },
    {
