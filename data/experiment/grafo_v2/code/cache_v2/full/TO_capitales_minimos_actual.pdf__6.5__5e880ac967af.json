    {
      "local_id": "e1",
      "type": "Operacion",
      "label": "Mantener posiciones en productos básicos",
      "properties": {
        "tipo": "mantenimiento_de_posiciones",
        "description": "Mantener posiciones en productos básicos, incluidos metales preciosos excepto el oro"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Utilizar forwards y derivados en commodities",
      "properties": {
        "tipo": "operacion_derivados",
        "description": "Las entidades financieras que utilizan forwards y demás derivados sobre productos básicos"
      }
    },
    {
      "local_id": "e3",
      "type": "Restriccion",
      "label": "Neteamiento de posiciones cortas y largas",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Las posiciones cortas y largas podrán netearse a efectos de calcular las posiciones abiertas, siempre que se trate de un mismo producto básico. No se admite la compensación entre posiciones en diferentes productos básicos ni entre subcategorías diferentes del mismo producto básico."
      }
    },
    {
      "local_id": "e4",
      "type": "Restriccion",
      "label": "Prohibición de compensación entre productos básicos diferentes",
      "properties": {
        "tipo": "prohibicion",
        "description": "No se admite la compensación entre posiciones en diferentes productos básicos ni entre subcategorías diferentes del mismo producto básico"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Expresar posiciones en unidad estándar",
      "properties": {
        "tipo": "calculo",
        "description": "Para calcular los requerimientos de capital se deberá expresar cada posición en un producto básico (al contado y a plazo) en términos de la correspondiente unidad estándar de medida (barriles, kilos, gramos, etc.)"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Convertir posición neta a pesos",
      "properties": {
        "tipo": "calculo",
        "description": "La posición neta de cada producto básico se convertirá a pesos utilizando su precio al contado y, si estuviera expresado en moneda extranjera, convirtiéndolo al tipo de cambio de referencia del dólar estadounidense difundido por el BCRA"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Incluir posiciones en cómputos de tasa de interés y tipo de cambio",
      "properties": {
        "tipo": "calculo",
        "description": "Si para financiar sus posiciones en productos básicos la entidad financiera estuviera expuesta al riesgo de tasa de interés y/o de tipo de cambio, deberá incluir las posiciones pertinentes en los cómputos previstos en los puntos 6.2 y 6.4"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Convertir derivados a posiciones nocionales",
      "properties": {
        "tipo": "calculo",
        "description": "Los instrumentos derivados sobre productos básicos deberán convertirse en posiciones nocionales de esos productos conforme a lo establecido"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Aplicar requerimiento de capital por riesgo direccional",
      "properties": {
        "tipo": "calculo",
        "description": "Por riesgo direccional: el requerimiento de capital será el 15% de la posición neta, ya sea corta o larga, en cada producto básico"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Límite de capital por riesgo direccional 15%",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "El requerimiento de capital por riesgo direccional será el 15% de la posición neta",
        "umbral": "15%"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Aplicar requerimiento adicional por riesgos secundarios",
      "properties": {
        "tipo": "calculo",
        "description": "Por los riesgos de base, de tasa de interés y de brecha a futuro: las entidades financieras deberán observar un requerimiento de capital adicional del 3% de la posición bruta"
      }
    },
    {
      "local_id": "e12",
      "type": "Restriccion",
      "label": "Límite de capital por riesgos secundarios 3%",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "Requerimiento de capital adicional del 3% de la posición bruta (largas más cortas) en cada producto básico por riesgos de base, tasa de interés y brecha a futuro",
        "umbral": "3%"
      }
    },
