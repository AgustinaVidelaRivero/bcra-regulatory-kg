      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Reporte de códigos de consolidación",
      "properties": {
        "tipo": "presentación informativa",
        "description": "Informar códigos de consolidación 1 y 9, o código 0, según situación de consolidación de las entidades financieras"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Cambio de códigos consolidación para entidades",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Las entidades financieras que hasta el 31/03/24 informaban únicamente códigos de consolidación 1 y 3, de mantenerse esta situación de consolidación, pasarán a informar: a) códigos 1 y 9 sólo si consolidan con alguno de los entes a que refieren los incisos i), ii) y iii) del punto 6.2.; b) en caso contrario, código 0."
      }
    },
