      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La consolidación mensual (código 2) considerará las operaciones de los entes a que refieren los incisos i), ii) y iii) del primer párrafo del punto 6.2. de las normas sobre Supervisión consolidada"
      }
    }
