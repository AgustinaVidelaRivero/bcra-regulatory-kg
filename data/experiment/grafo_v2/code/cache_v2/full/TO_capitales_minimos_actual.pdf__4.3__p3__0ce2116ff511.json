    {
      "local_id": "op_calculo_capital_hipotetico",
      "type": "Operacion",
      "label": "Cálculo de requerimiento de capital hipotético",
      "properties": {
        "tipo": "cálculo de exposición de riesgo",
        "description": "Calcular el requerimiento de capital hipotético para la CCP por su exposición al riesgo de crédito de contraparte frente a todos los miembros compensadores y sus clientes mediante la fórmula: K_CCP = 20% × EAD_i"
      }
    },
    {
      "local_id": "op_calculo_ead_miembro",
      "type": "Operacion",
      "label": "Cálculo de exposición (EAD) de miembro",
      "properties": {
        "tipo": "cálculo de exposición",
        "description": "Calcular el valor de la exposición del miembro compensador, incluyendo operaciones propias, operaciones de clientes garantizadas, activos en garantía y aportes al fondo de garantía, a valores de cierre del día de cálculo"
      }
    },
    {
      "local_id": "op_calculo_ead_subcuentas",
      "type": "Operacion",
      "label": "Cálculo de EAD por subcuentas",
      "properties": {
        "tipo": "cálculo de exposición",
        "description": "Cuando miembros compensadores brindan servicios de compensación a clientes y mantienen subcuentas separadas, sumar las EAD correspondientes a subcuentas de clientes y subcuentas del miembro compensador"
      }
    },
    {
      "local_id": "op_asignacion_ead_derivados_sft",
      "type": "Operacion",
      "label": "Asignación de EAD a derivados y SFT",
      "properties": {
        "tipo": "asignación",
        "description": "Cuando activos se constituyen en garantía de cuenta con operaciones SFT y derivados, asignar margen inicial entre exposiciones SFT y derivados en proporción de las EAD específicas de esos productos"
      }
    },
    {
      "local_id": "op_asignacion_fondo_garantia",
      "type": "Operacion",
      "label": "Asignación de aportes al fondo de garantía",
      "properties": {
        "tipo": "asignación",
        "description": "Si aportes al fondo de garantía para incumplimientos no están separados por subcuentas de clientes y miembro compensador, deben ser asignados por subcuenta según porción de margen inicial de cada subcuenta"
      }
    },
    {
      "local_id": "op_calculo_ead_derivados",
      "type": "Operacion",
      "label": "Cálculo de EAD para derivados",
      "properties": {
        "tipo": "cálculo de exposición",
        "description": "Para derivados, calcular EAD aplicando enfoque SA-CCR como exposición bilateral entre CCP y miembro compensador, utilizando MPOR de 10 días para exposición potencial futura"
      }
    },
    {
      "local_id": "op_calculo_ead_sft",
      "type": "Operacion",
      "label": "Cálculo de EAD para SFT",
      "properties": {
        "tipo": "cálculo de exposición",
        "description": "Para operaciones de financiamiento de valores (SFT), calcular EAD mediante fórmula: máx. (EBRM_i – IM_i – DF_i; 0)"
      }
    },
    {
      "local_id": "op_reduccion_exposicion_garantia",
      "type": "Operacion",
      "label": "Reducción de exposición mediante garantía",
      "properties": {
        "tipo": "mitigación de riesgo",
        "description": "Todo activo en garantía al que la CCP pueda recurrir en caso de incumplimiento, incluyendo aportes al fondo de garantía, reducirá la exposición aplicando el multiplicador de EPF establecido"
      }
    },
    {
      "local_id": "op_calculo_requisito_capital_miembro",
      "type": "Operacion",
      "label": "Cálculo de requisito de capital por miembro",
      "properties": {
        "tipo": "cálculo de requerimiento",
        "description": "Calcular el requisito de capital para cada miembro compensador según parámetros de período de mantenimiento y conjuntos de neteo"
      }
    },
    {
      "local_id": "oblig_aplicar_ponderador_riesgo",
      "type": "Obligacion",
      "label": "Aplicar ponderador de riesgo",
      "properties": {
        "tipo": "calculo",
        "description": "Las entidades financieras que sean miembros compensadores aplicarán un ponderador de riesgo que se determinará considerando la cantidad y calidad de recursos de la QCCP, exposición de la CCP al riesgo de crédito de contraparte y orden de aplicación de recursos",
        "plazo": "al efecto de computar la exigencia de capital"
      }
    },
    {
      "local_id": "oblig_observar_periodos_mantenimiento",
      "type": "Obligacion",
      "label": "Observar períodos de mantenimiento mínimo",
      "properties": {
        "tipo": "calculo",
        "description": "Se aplicarán los períodos de mantenimiento mínimo del punto 5.3.2.3. para SFT y de 10 días hábiles para derivados sujetos a reposición diaria de márgenes y valuación diaria a precios de mercado",
        "plazo": "según condiciones de operación"
      }
    },
    {
      "local_id": "oblig_periodo_prolongado_derivados",
      "type": "Obligacion",
      "label": "Extender período para derivados ilíquidos",
      "properties": {
        "tipo": "calculo",
        "description": "Para conjuntos de neteo con activos en garantía ilíquidos o derivados OTC no fácilmente sustituibles, periodo mínimo será de 20 días hábiles, determinando liquidez en contexto de condiciones de estrés del mercado",
        "plazo": "20 días hábiles"
      }
    },
    {
      "local_id": "oblig_extender_periodo_concentracion",
      "type": "Obligacion",
      "label": "Extender período por concentración de operaciones",
      "properties": {
        "tipo": "calculo",
        "description": "El período mínimo se extenderá si operaciones o activos recibidos en garantía se concentran en contraparte determinada, particularmente si no pudieran ser reemplazados si esa contraparte saliese precipitadamente del mercado",
        "plazo": "según evaluación de concentración"
      }
    },
    {
      "local_id": "restrict_no_extensión_5000_operaciones",
      "type": "Restriccion",
      "label": "Exclusión de extensión por cantidad de operaciones",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La sola existencia de 5.000 operaciones o más en un conjunto de neteo no determinará, por sí misma, la extensión del período de mantenimiento mínimo"
      }
    },
    {
      "local_id": "oblig_conjuntos_neteo_entidades_financieras",
      "type": "Obligacion",
      "label": "Aplicar conjuntos de neteo",
      "properties": {
        "tipo": "otra",
        "description": "Los conjuntos de neteo aplicables a las entidades financieras que actúen como miembros compensadores serán los referidos en el inciso c) del acápite i) del punto 4.3.3.1."
      }
    },
    {
      "local_id": "oblig_neteo_otros_miembros",
      "type": "Obligacion",
      "label": "Observar normas de neteo de CCP",
      "properties": {
        "tipo": "otra",
        "description": "Los demás miembros compensadores deberán observar las normas de neteo establecidas por la CCP y que les hayan sido notificadas, salvo que la CNV exija conjuntos de neteo más atomizados"
      }
    }
