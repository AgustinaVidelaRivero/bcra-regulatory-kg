    {
      "local_id": "e1",
      "type": "Operacion",
      "label": "Operaciones sobre volatilidad de acciones",
      "properties": {
        "tipo": "derivado",
        "description": "Operaciones sobre la volatilidad de las acciones y productos básicos, tales como 'equity volatility swaps', donde el nocional ajustado será el producto de la volatilidad o la varianza referenciadas en la operación y el nocional contractual."
      }
    },
    {
      "local_id": "e2",
      "type": "Obligacion",
      "label": "Calcular nocional ajustado para volatilidad",
      "properties": {
        "tipo": "calculo",
        "description": "Para operaciones sobre volatilidad de acciones y productos básicos, el nocional ajustado será el producto de la volatilidad o la varianza referenciadas en la operación y el nocional contractual."
      }
    },
    {
      "local_id": "e3",
      "type": "Operacion",
      "label": "Operaciones con nocional no definido",
      "properties": {
        "tipo": "derivado",
        "description": "Operaciones en las que el nocional no está claramente definido o no se mantiene fijo hasta el vencimiento."
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Determinar nocional en operaciones contingentes",
      "properties": {
        "tipo": "calculo",
        "description": "Para operaciones con retribuciones múltiples y contingentes respecto de un estado o situación (tal como opciones digitales), se calculará un nocional para cada estado y se tomará el que resulte mayor."
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Aplicar valores de mercado corrientes",
      "properties": {
        "tipo": "calculo",
        "description": "Cuando el nocional sea una fórmula en base a valores de mercado, se tomarán los valores de mercado corrientes para determinar el nocional de la operación."
      }
    },
    {
      "local_id": "e6",
      "type": "Operacion",
      "label": "Derivados de tasa e interés o crédito",
      "properties": {
        "tipo": "derivado",
        "description": "Derivados de tasa de interés o crédito con nocionales variables, tales como 'swaps' de nocional variable ('amortising swaps' y 'accreting swaps')."
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Calcular promedio ponderado por tiempo de nocional",
      "properties": {
        "tipo": "calculo",
        "description": "Para derivados de tasa de interés o crédito con nocionales variables, se empleará el promedio, ponderado por el tiempo, del nocional durante la vida residual del instrumento."
      }
    },
    {
      "local_id": "e8",
      "type": "Excepcion",
      "label": "Excepción a promedio ponderado de nocional",
      "properties": {
        "description": "Esta regla no será aplicable a operaciones en las que el nocional varía debido a cambios en los precios, tales como los derivados FX y sobre acciones o 'commodities'."
      }
    },
    {
      "local_id": "e9",
      "type": "Operacion",
      "label": "Swaps apalancados",
      "properties": {
        "tipo": "derivado",
        "description": "'Swaps' apalancados que se convertirán a los nocionales de 'swaps' no apalancados equivalentes."
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Convertir swaps apalancados a equivalentes",
      "properties": {
        "tipo": "calculo",
        "description": "Los 'swaps' apalancados se convertirán a los nocionales de 'swaps' no apalancados equivalentes. Cuando todas las tasas en un 'swap' se multipliquen por un factor, el nocional establecido también se multiplicará por ese factor para determinar el nocional de la operación."
      }
    },
    {
      "local_id": "e11",
      "type": "Operacion",
      "label": "Derivados con intercambios múltiples",
      "properties": {
        "tipo": "derivado",
        "description": "Derivados con intercambios múltiples del principal."
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Multiplicar nocional por cantidad de intercambios",
      "properties": {
        "tipo": "calculo",
        "description": "En el caso de un derivado con intercambios múltiples del principal, el nocional se multiplicará por el número de intercambios previstos en el contrato."
      }
    },
    {
      "local_id": "e13",
      "type": "Operacion",
      "label": "Derivados con reformulación a valor cero",
      "properties": {
        "tipo": "derivado",
        "description": "Derivados estructurados de tal manera que en fechas predeterminadas se cancele la exposición vigente y se reformulen las condiciones de modo que el valor razonable del contrato sea cero."
      }
    },
    {
      "local_id": "e14",
      "type": "Obligacion",
      "label": "Calcular plazo residual hasta reformulación",
      "properties": {
        "tipo": "calculo",
        "description": "Para derivados estructurados con reformulación a valor cero, el plazo residual será el plazo hasta la próxima fecha de reformulación."
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Aplicar parámetro delta regulatorio",
      "properties": {
        "tipo": "calculo",
        "description": "El parámetro delta se aplicará a los correspondientes nocionales ajustados de cada operación y se calculará conforme a criterios específicos para posiciones largas, cortas, en opciones y en segmentos de CDO."
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Calcular parámetros de subyacente y ejercicio",
      "properties": {
        "tipo": "calculo",
        "description": "Las entidades calcularán los siguientes parámetros: precio del subyacente (contado, forward, promedio, etc.), precio de ejercicio y última fecha contractual para el ejercicio de la opción."
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Especificar volatilidad según factor regulatorio",
      "properties": {
        "tipo": "calculo",
        "description": "La volatilidad de la opción se especificará en base al factor regulatorio aplicable a la operación, conforme a la tabla del acápite xiii)."
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Calcular parámetros de segmentos CDO",
      "properties": {
        "tipo": "calculo",
        "description": "Las entidades calcularán los siguientes parámetros para segmentos de CDO: punto de unión del segmento CDO y punto de separación del segmento CDO."
      }
    },
    {
      "local_id": "e19",
      "type": "Obligacion",
      "label": "Aplicar factores regulatorios al nocional",
      "properties": {
        "tipo": "calculo",
        "description": "En base a la medición de la volatilidad de cada clase de activo, se aplicarán uno o más factores específicos al nocional efectivo a fin de obtener la EPE efectiva."
      }
    },
    {
      "local_id": "e20",
      "type": "Obligacion",
      "label": "Definir conjuntos de cobertura por clase activo",
      "properties": {
        "tipo": "calculo",
        "description": "Los conjuntos de cobertura en las diferentes clases de activos se definirán conforme a criterios específicos: un conjunto por moneda para derivados sobre tasas de interés, por par de monedas para FX, un único para crédito, acciones y cuatro para commodities."
      }
    },
    {
      "local_id": "e21",
      "type": "Operacion",
      "label": "Operaciones sobre base de factores de riesgo",
      "properties": {
        "tipo": "derivado",
        "description": "Derivados que referencian la base entre dos factores de riesgo y están denominados en una sola moneda (operaciones sobre base, 'basis transactions')."
      }
    },
    {
      "local_id": "e22",
      "type": "Obligacion",
      "label": "Asignar derivados de base a conjuntos específicos",
      "properties": {
        "tipo": "calculo",
        "description": "Derivados que referencian la base deben asignarse a conjuntos de cobertura específicos dentro de la clase de activo correspondiente."
      }
    },
    {
      "local_id": "e23",
      "type": "Restriccion",
      "label": "No aplicar tratamiento de base a cross-currency",
      "properties": {
        "tipo": "prohibicion",
        "description": "Este tratamiento no se aplicará a los derivados con dos lados flotantes denominados en monedas diferentes, tales como los 'cross-currency swaps', los que recibirán el tratamiento aplicable a los contratos FX ordinarios."
      }
    },
    {
      "local_id": "e24",
      "type": "Obligacion",
      "label": "Asignar derivados de volatilidad a conjuntos",
      "properties": {
        "tipo": "calculo",
        "description": "Derivados referidos a la volatilidad de un factor de riesgo se asignarán a conjuntos específicos dentro de la clase de activo correspondiente."
      }
    },
    {
      "local_id": "e25",
      "type": "Restriccion",
      "label": "Limitar factor regulatorio en operaciones base",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "0,5",
        "description": "Cuando se aplique a conjuntos de cobertura de derivados sobre bases, el SF correspondiente a la clase se multiplicará por 0,5."
      }
    },
    {
      "local_id": "e26",
      "type": "Restriccion",
      "label": "Multiplicar factor regulatorio en operaciones volatilidad",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "5",
        "description": "Cuando se aplique a conjuntos de cobertura de operaciones sobre la volatilidad, el SF correspondiente a la clase se multiplicará por 5."
      }
    },
    {
      "local_id": "e27",
      "type": "Obligacion",
      "label": "Establecer horizonte temporal mínimo",
      "properties": {
        "tipo": "calculo",
        "plazo": "10 días hábiles",
        "description": "Para operaciones sin margen de variación, su horizonte temporal mínimo será el menor entre un año y el plazo residual del contrato de derivados, con un mínimo de 10 días hábiles."
      }
    }
