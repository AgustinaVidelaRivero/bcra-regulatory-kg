    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Prohibición de crear expectativa de recompra",
      "properties": {
        "descripcion": "La entidad financiera se debe abstener de crear, en ocasión de su emisión, cualquier expectativa de que la acción será recomprada, rescatada o amortizada, y los términos contractuales no deberán contener cláusula alguna que pudiera originar tal expectativa.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Instrumentos CA totalmente suscritos e integrados",
      "properties": {
        "descripcion": "Los instrumentos incluidos en el CA deberán estar totalmente suscriptos e integrados.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Subordinación a depositantes y acreedores",
      "properties": {
        "descripcion": "Los instrumentos incluidos en el CA deberán estar subordinados a depositantes, acreedores quirografarios y a deuda subordinada de la entidad financiera.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Prohibición de seguros o garantías mejoradoras",
      "properties": {
        "descripcion": "No estar asegurados ni cubiertos por alguna garantía del emisor o de un vinculado, ni ser objeto de cualquier otro acuerdo que mejore jurídica o económicamente el orden de prelación en el cobro para el caso de quiebra de la entidad.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Prohibición de pago de capital excepto liquidación",
      "properties": {
        "descripcion": "No prever pago de ningún tipo en concepto de capital, excepto en caso de liquidación de la entidad, cuando así correspondiese.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest6",
      "type": "Restriccion",
      "label": "Prohibición de cupones escalonados y amortización anticipada",
      "properties": {
        "descripcion": "No podrán tener cláusulas de remuneración escalonada creciente ni otros incentivos para su amortización anticipada.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Obtener autorización previa para rescate",
      "properties": {
        "descripcion": "La entidad financiera deberá contar con autorización de la SEFyC en forma previa al ejercicio de la opción de compra de instrumentos CA.",
        "tipo": "otra",
        "plazo": "5 años mínimo desde emisión"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Abstención de generar expectativa de rescate",
      "properties": {
        "descripcion": "La entidad financiera se deberá abstener de generar expectativas de que ejercitará la opción de compra.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Sustitución de instrumento o demostración de RPC",
      "properties": {
        "descripcion": "La entidad financiera deberá sustituir el instrumento con capital regulatorio de igual o mayor calidad y en condiciones que sean sostenibles para su capacidad de generación de ingresos, o demostrar que –una vez ejercida la opción de compra– su RPC supera ampliamente –al menos en un 20 %– los requerimientos mínimos de capital.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Autorización previa para restitución de capital",
      "properties": {
        "descripcion": "Cualquier restitución de capital requerirá la autorización previa de la SEFyC y la entidad financiera no deberá tener la expectativa ni crearla en el mercado de que obtendrá dicha autorización.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Discrecionalidad en pago de dividendos/cupones",
      "properties": {
        "descripcion": "La entidad financiera podrá –en todo momento y a su entera discreción– cancelar pagos en concepto de dividendos o intereses.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "rest7",
      "type": "Restriccion",
      "label": "No incumplimiento por falta de pago de dividendos",
      "properties": {
        "descripcion": "Lo anterior no deberá constituir de por sí un incumplimiento, ni facultar a los tenedores a exigir la conversión en acciones ordinarias.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Pago de dividendos con cargo a partidas distribuibles",
      "properties": {
        "descripcion": "El pago de dividendos/cupones se efectuará con cargo a partidas distribuibles, en los términos de la Sección 3 de las normas sobre Distribución de resultados.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "rest8",
      "type": "Restriccion",
      "label": "Prohibición de cupón ajustable por riesgo de crédito",
      "properties": {
        "descripcion": "No incorporar un dividendo/cupón que se reajuste periódicamente en función, en todo o en parte, del riesgo de crédito de la entidad financiera.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest9",
      "type": "Restriccion",
      "label": "Prohibición de compra por la entidad emisora",
      "properties": {
        "descripcion": "No haber sido comprados por la entidad financiera –ni por alguna entidad que ella controle o sobre la que ejerza influencia significativa–.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest10",
      "type": "Restriccion",
      "label": "Prohibición de compra con financiación de emisor",
      "properties": {
        "descripcion": "No haber sido comprados con la financiación directa o indirecta de la entidad financiera.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest11",
      "type": "Restriccion",
      "label": "Prohibición de características que dificulten recapitalización",
      "properties": {
        "descripcion": "No poseer características que dificulten la recapitalización, tales como requerir que la entidad financiera compense al inversor si se emite un nuevo instrumento a un precio menor durante un período de tiempo especificado.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Absorción de pérdidas por conversión o quita",
      "properties": {
        "descripcion": "Los instrumentos que son parte del pasivo deberán absorber pérdidas cuando el coeficiente de CO sea inferior al 5,125 % de los APR –evento desencadenante prefijado–, aún en el caso de que la entidad financiera no se encuentre en alguna de las situaciones previstas en el punto 8.3.4.4., a través de: i) su conversión en acciones ordinarias; o ii) un mecanismo que asigne pérdidas en forma definitiva al instrumento.",
        "tipo": "calculo",
        "plazo": "umbral 5,125% de APR"
      }
    },
    {
      "local_id": "rest12",
      "type": "Restriccion",
      "label": "Instrumentos PNc totalmente suscritos e integrados",
      "properties": {
        "descripcion": "Los instrumentos incluidos en el PNc deberán estar totalmente suscriptos e integrados.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest13",
      "type": "Restriccion",
      "label": "PNc subordinados a depositantes y acreedores",
      "properties": {
        "descripcion": "Los instrumentos incluidos en el PNc deberán estar subordinados a depositantes y acreedores quirografarios de la entidad financiera.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest14",
      "type": "Restriccion",
      "label": "PNc no asegurados ni cubiertos",
      "properties": {
        "descripcion": "No estar asegurados ni cubiertos por alguna garantía del emisor o de un vinculado, ni ser objeto de cualquier otro acuerdo que mejore jurídica o económicamente el orden de prelación en el cobro para el caso de quiebra de la entidad.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest15",
      "type": "Restriccion",
      "label": "Vencimiento mínimo de PNc: 5 años",
      "properties": {
        "descripcion": "Plazo de vencimiento original no inferior a cinco años; no existir cláusulas de remuneración escalonada creciente u otros incentivos para su amortización anticipada.",
        "tipo": "limite_cuantitativo",
        "umbral": "5 años"
      }
    },
    {
      "local_id": "rest16",
      "type": "Restriccion",
      "label": "Disminución de computable en últimos 5 años",
      "properties": {
        "descripcion": "A partir del comienzo de cada uno de los últimos cinco años de vida de cada emisión, el importe computable será disminuido en el 20 % del valor nominal emitido.",
        "tipo": "limite_cuantitativo",
        "umbral": "20% anual en últimos 5 años"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Autorización SEFyC para rescate de PNc",
      "properties": {
        "descripcion": "La entidad financiera podrá rescatarlos –transcurridos un mínimo de cinco años desde su emisión– siempre que cuente con autorización de la SEFyC en forma previa al ejercicio de la opción de compra.",
        "tipo": "otra",
        "plazo": "5 años mínimo"
      }
    },
    {
      "local_id": "rest17",
      "type": "Restriccion",
      "label": "Sin derecho a acelerar devolución de pagos futuros",
      "properties": {
        "descripcion": "El inversor no tendrá ningún derecho a acelerar la devolución de los pagos futuros previstos (cupón de renta o amortización), excepto en caso de quiebra o liquidación.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest18",
      "type": "Restriccion",
      "label": "PNc sin cupón ajustable por riesgo crediticio",
      "properties": {
        "descripcion": "No pueden incorporar un dividendo/cupón que se reajuste periódicamente en función, en todo o en parte, del riesgo de crédito de la entidad financiera.",
        "tipo": "prohibicion"
      }
    }
