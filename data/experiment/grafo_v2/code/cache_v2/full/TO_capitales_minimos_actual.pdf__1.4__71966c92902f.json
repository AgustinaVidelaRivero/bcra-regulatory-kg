      }
    },
    {
      "local_id": "res7",
      "type": "Restriccion",
      "label": "Prohibición de distribución de dividendos en efectivo",
      "properties": {
        "descripcion": "No podrán distribuirse dividendos en efectivo, ni efectuarse pagos de honorarios, participaciones o gratificaciones provenientes de la distribución de resultados de la entidad. Esta limitación regirá en tanto los planes de regularización y saneamiento estén pendientes de presentación o, habiéndose presentado, la SEFyC los haya observado o verifique su incumplimiento.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Presentación de descargo ante SEFyC",
      "properties": {
        "descripcion": "La entidad dispondrá de 30 días corridos contados desde la notificación de la determinación efectuada por la SEFyC a fin de formular su descargo, sobre el cual deberá expedirse dentro de los 30 días corridos siguientes a la presentación.",
        "tipo": "presentacion_informativa",
        "plazo": "30 días corridos desde notificación"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Ajuste a procedimiento si incumplimiento persiste",
      "properties": {
        "descripcion": "Cuando la entidad no presente su descargo en el plazo indicado o cuando el descargo es desestimado, el incumplimiento se considerará firme o se ajustará al procedimiento establecido en punto 1.4.2.1. si persisten incumplimientos.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Aplicación de disposiciones para nuevo grupo",
      "properties": {
        "descripcion": "Las entidades financieras que presenten cambios en su calificación contarán con un plazo de 6 meses para aplicar las disposiciones específicas correspondientes al nuevo grupo al que pertenezcan.",
