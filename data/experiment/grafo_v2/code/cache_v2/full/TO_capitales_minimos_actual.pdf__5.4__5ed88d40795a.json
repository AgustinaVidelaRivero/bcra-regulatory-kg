    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Reconocimiento solo de garantías admisibles",
      "properties": {
        "descripcion": "Se reconocerán sólo las garantías emitidas –o protección provista, en el caso de derivados de crédito– por entidades listadas en el punto 5.4.1.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Ponderador inferior al de contraparte",
      "properties": {
        "descripcion": "La protección crediticia será reconocida en la medida de que su ponderador de riesgo sea inferior al de la contraparte.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Garantías directas explícitas irrevocables",
      "properties": {
        "descripcion": "Cuando las garantías o derivados de crédito sean directos, explícitos, irrevocables e incondicionales, se reconocerá la protección crediticia.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Franquicias ponderadas al 1250%",
      "properties": {
        "descripcion": "Las franquicias por debajo de las cuales no se recibirá compensación en caso de pérdida deberán ser ponderadas por riesgo al 1250%.",
        "tipo": "limite_cuantitativo",
        "umbral": "1250%"
      }
    },
    {
      "local_id": "res5",
      "type": "Restriccion",
      "label": "CRC con plazo original menor a un año no reconocida",
      "properties": {
        "descripcion": "De haber descalce de plazos de vencimiento, la CRC que tenga un plazo de vencimiento original inferior a un año o residual no mayor a tres meses no será reconocida.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res6",
      "type": "Restriccion",
      "label": "Medición conservadora de plazos",
      "properties": {
        "descripcion": "Ambos plazos de vencimiento deberán medirse en forma conservadora.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res7",
      "type": "Restriccion",
      "label": "Aforo por descalce de monedas del 8%",
      "properties": {
        "descripcion": "Aforo por descalce de monedas entre la protección crediticia y la exposición del 8% (suponiendo un período de mantenimiento de 10 días hábiles y una valuación diaria a precios de mercado).",
        "tipo": "limite_cuantitativo",
        "umbral": "8%"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Sustituir ponderador por garante",
      "properties": {
        "descripcion": "Se aplicará el método de sustitución de ponderadores. Con este método, el ponderador de riesgo de la contraparte se sustituye por el ponderador de riesgo del garante –o contragarante– o proveedor de protección crediticia.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Mantener ponderador original en parte sin cobertura",
      "properties": {
        "descripcion": "La parte de la exposición sin cobertura mantendrá el ponderador de riesgo de la contraparte original, mientras que a la parte cubierta se le asignará el ponderador de riesgo del garante o proveedor de protección crediticia.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Calcular plazo de vencimiento conservador",
      "properties": {
        "descripcion": "El plazo de vencimiento de la exposición subyacente se calculará como el mayor plazo de vencimiento restante posible antes de que la contraparte deba cumplir su obligación, teniendo en cuenta cualquier período de gracia aplicable.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Considerar opciones incorporadas en CRC",
      "properties": {
        "descripcion": "Con relación a la CRC, se deberá tener en cuenta las opciones incorporadas que puedan reducir el plazo de vencimiento, a fin de utilizar el menor plazo de vencimiento posible.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Aplicar plazo según primera fecha posible de liquidación",
      "properties": {
        "descripcion": "Cuando el proveedor de protección pueda solicitar anticipadamente la liquidación de la operación, el plazo de vencimiento será siempre el correspondiente a la primera fecha en la que pueda solicitar su liquidación.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Incrementar aforo por raíz cuadrada del tiempo",
      "properties": {
        "descripcion": "El aforo deberá incrementarse proporcionalmente utilizando la fórmula de la raíz cuadrada del tiempo –en caso de corresponder– conforme a lo establecido en el apartado iii) del punto 5.3.2.3.",
        "tipo": "calculo"
      }
    }
  ],
