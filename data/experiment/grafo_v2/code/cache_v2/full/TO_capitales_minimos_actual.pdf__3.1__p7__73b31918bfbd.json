{
  "chunk_id": "TO_capitales_minimos_actual.pdf::3.1__p7",
  "doc": "TO_capitales_minimos_actual.pdf",
  "location": "Punto 3.1. Tratamiento de las titulizaciones. (parte 8)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Capitales Mínimos",
      "properties": {
        "materia": "Capital mínimo por riesgo de crédito. Titulizaciones e inversiones en fondos",
        "archivo": "TO_capitales_minimos_actual.pdf",
        "version": "2a (Com. A 8109) y 1a (Com. A 6470)"
      }
    },
    {
      "local_id": "e1",
      "type": "Restriccion",
      "label": "Titulización simple, transparente y comparable",
      "properties": {
        "descripcion": "Una titulización se considerará simple, transparente y comparable (STC) si se trata de una titulización tradicional que no constituye un programa ABCP, involucra una transferencia real de activos y cumple con la totalidad de los criterios previstos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e2",
      "type": "Obligacion",
      "label": "Divulgar información de titulización",
      "properties": {
        "descripcion": "El originante/fiduciario deberá divulgar toda la información necesaria respecto de la transacción que permita a los inversores determinar si la titulización cumple con los criterios STC",
        "tipo": "presentacion_informativa",
        "plazo": "previo a la aplicación del enfoque estandarizado"
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Evaluación del cumplimiento de criterios STC",
      "properties": {
        "descripcion": "En base a la información provista, el inversor deberá realizar sus propias evaluaciones respecto del cumplimiento de estos criterios previo a la aplicación del enfoque estandarizado",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Determinación de cumplimiento por originante",
      "properties": {
        "descripcion": "Para las posiciones retenidas en las que el originante haya transferido el riesgo, la determinación respecto del cumplimiento de los criterios será efectuada únicamente por la entidad originante",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "e5",
      "type": "Restriccion",
      "label": "Criterios STC cumplimiento continuo",
      "properties": {
        "descripcion": "Los criterios STC deberán cumplirse en todo momento",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e6",
      "type": "Excepcion",
      "label": "Verificación solo al origen",
      "properties": {
        "descripcion": "Algunos de los criterios se deberán verificar sólo al momento de la originación o cuando se genere la posición, tal como en el caso de las garantías y las facilidades de liquidez"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Monitoreo de modificaciones por inversores",
      "properties": {
        "descripcion": "Los inversores y tenedores de las posiciones de titulización deberán tener en cuenta las modificaciones que puedan invalidar las evaluaciones de cumplimiento previas, tales como las deficiencias en la frecuencia y en el contenido de los informes a los inversores o los cambios en la documentación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Verificación de nuevos activos subyacentes",
      "properties": {
        "descripcion": "En los casos en que el conjunto de subyacentes admita la incorporación de nuevos activos, el cumplimiento estará sujeto a que se realicen verificaciones cada vez que se incorporen esos nuevos activos",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e9",
      "type": "Restriccion",
      "label": "Acción correctiva o suspensión por SEFyC",
      "properties": {
        "descripcion": "Cuando la SEFyC detecte que una titulización no cumple con alguno de los criterios, podrá exigir la implementación de acciones correctivas y/o determinar que se suspenda el tratamiento STC para una o más posiciones de titulización",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Homogeneidad de activos subyacentes",
      "properties": {
        "descripcion": "Los activos subyacentes deberán estar constituidos por documentos a cobrar o derechos de crédito de carácter homogéneo en cuanto a su tipo, jurisdicción, legislación aplicable y moneda y sus flujos de fondos deberán estar contractualmente identificados, ser periódicos y consistir exclusivamente en pagos del principal e intereses o de arrendamientos financieros",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Evaluación de homogeneidad sin diferencias sustanciales",
      "properties": {
        "descripcion": "La naturaleza de los activos deberá ser tal que los inversores, al realizar el proceso de debida diligencia, no necesiten analizar ni evaluar perfiles o factores de riesgo, crediticios o legales, sustancialmente diferentes entre sí",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Evaluación de homogeneidad por riesgo común",
      "properties": {
        "descripcion": "La homogeneidad se deberá evaluar en función de factores y perfiles de riesgo comunes al conjunto de los activos",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e13",
      "type": "Restriccion",
      "label": "Obligaciones estándares de créditos titulizados",
      "properties": {
        "descripcion": "Los documentos y créditos incluidos en la titulización deberán constituir obligaciones estándares, en términos de derechos de cobro y/o rentas de los activos y generar un flujo de pago a los inversores periódico y claramente definido",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e14",
      "type": "Restriccion",
      "label": "Reembolso de inversores de activos subyacentes",
      "properties": {
        "descripcion": "El reembolso a los inversores en la titulización deberá provenir principalmente del producido de los activos subyacentes y no deberá depender de modo sustancial de la refinanciación de los créditos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e15",
      "type": "Restriccion",
      "label": "Tasas de interés de referencia de mercado",
      "properties": {
        "descripcion": "Las tasas de interés o de descuento de referencia deberán ser tasas de interés de mercado y de fácil consulta, evitándose referencias a fórmulas complejas o derivados exóticos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Información verificable de desempeño activos",
      "properties": {
        "descripcion": "Se deberá contar con información verificable sobre pérdidas e incumplimientos respecto de activos con características de riesgo sustancialmente similares a los que integran la titulización por un período de tiempo lo suficientemente prolongado",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Disponibilidad de fuentes de información",
      "properties": {
        "descripcion": "Las fuentes de información y el acceso a los datos, así como los fundamentos que permitan aducir la similitud con los activos titulizados, deberán estar disponibles para todos los participantes del mercado",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Evaluación de antecedentes de fiduciarios",
      "properties": {
        "descripcion": "El inversor deberá poder evaluar durante su proceso de debida diligencia si el originante, fiduciario, administrador, agente de cobro u otros sujetos con responsabilidad fiduciaria en la titulización cuentan con probados antecedentes respecto de activos sustancialmente similares",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e19",
      "type": "Restriccion",
      "label": "Experiencia del originante en financiaciones",
      "properties": {
        "descripcion": "El originante de la titulización, así como el acreedor inicial de los créditos titulizados, deberán contar con experiencia suficiente en el otorgamiento de financiaciones similares a las titulizadas",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e20",
      "type": "Obligacion",
      "label": "Determinación de experiencia del originante",
      "properties": {
        "descripcion": "El inversor deberá determinar la experiencia y el historial de desempeño del originante y del acreedor inicial respecto de activos sustancialmente similares a los titulizados a través de un período convenientemente prolongado",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "com8109",
      "type": "Comunicacion",
      "label": "Com. A 8109",
      "properties": {
        "codigo": "A-8109",
        "tipo": "A",
        "numero": "8109"
      }
