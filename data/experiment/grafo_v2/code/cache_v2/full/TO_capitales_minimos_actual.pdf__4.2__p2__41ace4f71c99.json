      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Asignación de derivados a clase de activo",
      "properties": {
        "tipo": "Clasificación de derivados por factor de riesgo principal"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Identificar factor de riesgo principal de derivados",
      "properties": {
        "descripcion": "Cuando sea posible identificar claramente el factor principal, la operación se imputará a una de las siguientes clases de activos: tasa de interés, tipo de cambio, crédito, acciones y productos básicos.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Analizar sensibilidad en derivados complejos",
      "properties": {
        "descripcion": "Cuando se trate de operaciones más complejas –tales como derivados híbridos– en las que exista más de un factor de riesgo, las entidades deberán tomar en consideración la sensibilidad y volatilidad de los subyacentes para determinar el factor de riesgo principal.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Permitir reasignación de operaciones complejas",
      "properties": {
        "descripcion": "El área de Supervisión y Seguimiento de la SEFyC podrá requerir que las operaciones más complejas se asignen a más de una clase de activos, en cuyo caso se deberá asignar la posición a múltiples clases y determinar, para cada una, el signo y el ajuste delta para el factor de riesgo relevante.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Calcular nocional ajustado por operación",
      "properties": {
        "descripcion": "A partir del nocional real o del precio de cada operación se calculará un nocional ajustado. Para los derivados sobre tasas de interés y créditos, el monto nocional ajustado incorporará una medición del plazo –duration–.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Calcular factor plazo (maturity factor)",
      "properties": {
        "descripcion": "Para cada operación se calculará un factor plazo (maturity factor) MF para reflejar el horizonte temporal adecuado al tipo de la operación, de los cuales hay dos tipos: uno para operaciones con márgenes y otro para operaciones sin márgenes.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Aplicar ajuste delta al nocional",
      "properties": {
        "descripcion": "Al efecto de obtener el nocional efectivo se aplicará al nocional ajustado de cada operación un ajuste delta según el tipo de posición –larga o corta– y dependiendo de si se trata de una opción, de un segmento de una titulización estructurada de deudas o de otro tipo.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Aplicar factor de volatilidad al nocional efectivo",
      "properties": {
        "descripcion": "A cada nocional efectivo se le aplicará un factor que refleja su volatilidad.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Separar operaciones por conjunto de cobertura",
      "properties": {
        "descripcion": "Las operaciones dentro de cada clase de activo se separarán por conjunto de cobertura. Se aplicará un método para sumar los datos de las operaciones dentro de cada conjunto y, luego, los datos de cada conjunto para obtener un total por clase de activo. En este proceso se emplearán parámetros de correlación para capturar el efecto de los riesgos de base y la diversificación.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Determinar período mínimo de 10 días hábiles",
      "properties": {
        "descripcion": "El período no podrá ser menor que 10 días hábiles.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob10",
      "type": "Obligacion",
      "label": "Calcular nocional ajustado para derivados de tipo de cambio",
      "properties": {
        "descripcion": "Para los derivados de tipo de cambio, el nocional ajustado se definirá como el nocional del lado 'leg' del contrato expresado en moneda extranjera, convertido a pesos. Si ambos lados del derivado están denominados en monedas extranjeras, se tomará el mayor de ambos nocionales una vez convertidos a pesos.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob11",
      "type": "Obligacion",
      "label": "Calcular nocional ajustado para derivados de acciones y commodities",
      "properties": {
        "descripcion": "Para los derivados sobre acciones y commodities, el nocional ajustado será el producto del precio corriente de una unidad de la acción o producto por el número de unidades referenciado por la operación.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Período mínimo de 10 días hábiles",
      "properties": {
        "descripcion": "El período no podrá ser menor que 10 días hábiles.",
        "tipo": "limite_cuantitativo",
        "umbral": "10 días hábiles"
      }
    }
  ],
