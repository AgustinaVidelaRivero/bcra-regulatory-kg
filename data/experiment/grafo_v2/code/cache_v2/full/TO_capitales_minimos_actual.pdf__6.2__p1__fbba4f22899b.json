      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Calcular exigencia de capital por derivado",
      "properties": {
        "descripcion": "Las entidades deberán calcular la exigencia de capital por cada posición neta en derivados de crédito de enésimo incumplimiento independientemente de que tengan una posición comprada o vendida",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Calcular exigencia de capital por riesgo general",
      "properties": {
        "descripcion": "La exigencia de capital se obtendrá como la suma de cuatro componentes: valor absoluto de posición ponderada neta, desestimación vertical, desestimación horizontal, y cambio neto en posiciones en opciones",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Calcular exigencias por separado por moneda",
      "properties": {
        "descripcion": "Las exigencias de capital se calcularán por separado para las posiciones en pesos y en cada moneda extranjera. Para monedas extranjeras residuales, se podrá imputar las posiciones netas a bandas de una escala única",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Imputar posiciones a escalas de vencimientos",
      "properties": {
        "descripcion": "Las posiciones compradas y vendidas en títulos de deuda e instrumentos derivados se imputarán a escalas de vencimientos divididas en 15 o 13 bandas temporales, según que el cupón del instrumento sea, o no, menor a 3 %",
        "tipo": "otra"
      }
    },
