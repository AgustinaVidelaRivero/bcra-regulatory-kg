      }
    },
    {
      "local_id": "obs3",
      "type": "Obligacion",
      "label": "Reportar cumplimiento de permiso al BCRA",
      "properties": {
        "descripcion": "Cuando se considere parcial o totalmente cumplimentado el seguimiento de un permiso de embarque por aplicaciones y/o por las situaciones consideradas en el punto 8.5., la entidad deberá reportarlo al BCRA dentro de los 5 (cinco) días hábiles de convalidada la imputación por parte de ella.",
        "tipo": "presentacion_informativa",
        "plazo": "5 días hábiles"
      }
    },
    {
      "local_id": "obs4",
      "type": "Obligacion",
      "label": "Emitir certificación de cumplido",
      "properties": {
        "descripcion": "La entidad deberá emitir una certificación de cumplido para aquellas destinaciones de exportación a consumo que acumularon imputaciones admitidas hasta alcanzar el total del monto a ingresar y liquidar.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obs5",
      "type": "Obligacion",
      "label": "Realizar denuncia de incumplido",
      "properties": {
        "descripcion": "La entidad encargada del seguimiento deberá realizar la denuncia de incumplido para un permiso cuando habiéndose producido el vencimiento del plazo previsto por la normativa vigente no se hayan verificado las condiciones requeridas para la remisión de la certificación de cumplido del permiso.",
        "tipo": "presentacion_informativa",
        "plazo": "10 días hábiles"
      }
    },
    {
      "local_id": "obs6",
      "type": "Obligacion",
