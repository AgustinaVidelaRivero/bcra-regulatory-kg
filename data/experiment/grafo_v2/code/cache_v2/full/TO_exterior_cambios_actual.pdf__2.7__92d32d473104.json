        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obs7",
      "type": "Obligacion",
      "label": "Reportar cierre de incumplido",
      "properties": {
        "descripcion": "En caso de certificar el cumplido del permiso, deberá reportar también el cierre del incumplido consignando el número de cumplido asignado por la entidad al permiso, la fecha en que se completó el ingreso de las divisas y detallando todos los movimientos que han permitido a la entidad considerarlo cumplido.",
        "tipo": "presentacion_informativa",
        "plazo": "5 días hábiles"
      }
    },
    {
      "local_id": "obs8",
