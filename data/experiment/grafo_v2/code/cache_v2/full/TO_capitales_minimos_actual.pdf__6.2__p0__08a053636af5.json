    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Calcular exigencia de capital por tasa de interés",
      "properties": {
        "descripcion": "La exigencia de capital por el riesgo de tasa de interés se deberá calcular respecto de los títulos de deuda y otros instrumentos imputados a la cartera de negociación, incluidas las acciones preferidas no convertibles.",
        "tipo": "calculo",
        "plazo": "obligación permanente"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Tratar como cartera títulos recomprados a término",
      "properties": {
        "descripcion": "Un título valor vendido y recomprado a término en una operación de pase pasivo o en otro tipo de operación de financiación con títulos valores se tratará como si todavía fuese propiedad de la entidad cedente; es decir, recibirá el mismo tratamiento que un título en cartera.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Clasificar acciones preferidas convertibles",
      "properties": {
        "descripcion": "Las acciones preferidas convertibles a un precio predeterminado en acciones ordinarias de la emisora se tratarán según cómo se negocien, como títulos de deuda o como acciones.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Obtener exigencia como suma de dos exigencias",
      "properties": {
        "descripcion": "La exigencia se obtendrá como la suma de dos exigencias calculadas por separado: una por el riesgo específico de cada instrumento, ya sea que se trate de una posición vendida o comprada, y otra por el riesgo general de mercado.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig5",
      "type": "Obligacion",
      "label": "Permitir compensación de posiciones en riesgo general",
      "properties": {
        "descripcion": "En el riesgo general de mercado –vinculado al efecto de cambios en la tasa de interés sobre la cartera–, se podrán compensar las posiciones compradas y vendidas en diferentes instrumentos.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig6",
      "type": "Obligacion",
      "label": "Permitir neteamiento de posiciones opuestas",
      "properties": {
        "descripcion": "Para su cálculo, sólo se permitirá netear las posiciones opuestas respecto de una misma especie, incluidas las posiciones en derivados.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig7",
      "type": "Obligacion",
      "label": "Calcular exigencia por riesgo de emisor",
      "properties": {
        "descripcion": "Las exigencias de capital por riesgo específico en concepto de riesgo de emisor serán las siguientes: con ponderadores según categoría de emisor y plazo residual.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig8",
      "type": "Obligacion",
      "label": "Calcular exigencia por riesgo titulización",
      "properties": {
        "descripcion": "La exigencia de capital por riesgo específico de las posiciones de titulización mantenidas en la cartera de negociación será el 8% del importe ponderado por riesgo de las posiciones de titulización netas imputadas a esa cartera.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig9",
      "type": "Obligacion",
      "label": "Calcular ratio de concentración",
      "properties": {
        "descripcion": "El ratio de concentración se obtendrá de la suma de los valores nominales de todos los tramos dividida por la suma de los valores nominales de los tramos subordinados o de igual prelación.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig10",
      "type": "Obligacion",
      "label": "Aplicar ponderador de riesgo del 1250%",
      "properties": {
        "descripcion": "Cuando la entidad no pueda determinar la exigencia de capital por riesgo específico conforme a la metodología establecida o el ratio de concentración sea igual o superior a 12,5, se deberá aplicar a la posición neta un ponderador de riesgo del 1250%.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig11",
      "type": "Obligacion",
      "label": "Permitir exclusión de posiciones de riesgo general",
      "properties": {
        "descripcion": "Se podrá excluir del cómputo de la exigencia de capital por riesgo general de mercado aquellas posiciones que, conforme a lo previsto en este punto, conlleven un ponderador de riesgo del 1250%.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig12",
      "type": "Obligacion",
      "label": "Calcular máxima pérdida posible para posiciones individuales",
      "properties": {
        "descripcion": "Las entidades podrán limitar la exigencia de capital por riesgo específico de una posición individual tanto en un derivado de crédito como en una titulización a la máxima pérdida posible, que se calculará según criterios especificados para posiciones vendidas y compradas.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "oblig13",
      "type": "Obligacion",
      "label": "Permitir compensación íntegra de ambos lados de operación",
      "properties": {
        "descripcion": "Se podrá compensar en forma íntegra ambos lados de una operación (comprada y vendida) cuando: a) los instrumentos de ambos lados sean idénticos; o b) un instrumento (posición al contado comprada) se cubra con un swap de rendimiento total, o viceversa, y coincidan exactamente la obligación de referencia del swap y la posición subyacente.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Solo posiciones en misma especie se netean",
      "properties": {
        "descripcion": "Para su cálculo, sólo se permitirá netear las posiciones opuestas respecto de una misma especie, incluidas las posiciones en derivados.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Máxima pérdida cálculo individual por posición",
      "properties": {
        "descripcion": "La máxima pérdida posible se deberá calcular para cada posición individual.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Descalce permitido entre plazo de vencimiento",
      "properties": {
        "descripcion": "Se admitirá que exista un descalce entre los plazos de vencimiento de la posición subyacente y del swap de rendimiento total.",
        "tipo": "limite_cualitativo"
      }
    }
  ],
