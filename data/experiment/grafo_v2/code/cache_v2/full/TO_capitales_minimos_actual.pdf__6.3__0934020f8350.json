    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Exclusión de acciones preferidas",
      "properties": {
        "descripcion": "Las acciones preferidas no convertibles se excluyen del cálculo de capital por riesgo de posiciones en acciones y se aplica la exigencia por riesgo de tasa de interés",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Exigencia de capital 8% riesgo específico",
      "properties": {
        "descripcion": "La exigencia de capital por riesgo específico será del 8% de la posición bruta en acciones",
        "tipo": "limite_cuantitativo",
        "umbral": "8%"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Exigencia de capital 8% riesgo general mercado",
      "properties": {
        "descripcion": "La exigencia de capital por riesgo general de mercado será del 8% de la posición neta total en cada mercado nacional",
        "tipo": "limite_cuantitativo",
        "umbral": "8%"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Exigencia adicional 2% índices",
      "properties": {
        "descripcion": "Además de la exigencia por riesgo general de mercado, se aplicará una exigencia de capital adicional de 2% de la posición neta en contratos sobre índices calculados sobre carteras diversificadas de acciones",
        "tipo": "limite_cuantitativo",
        "umbral": "2%"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Exigencia 4% estrategias arbitraje canasta-futuro",
      "properties": {
        "descripcion": "Se aplicará una exigencia de capital de 4% a las posiciones que surjan de estrategias de arbitraje en que un futuro sobre un índice amplio se calce con una canasta de acciones que represente al menos el 90% del índice",
        "tipo": "limite_cuantitativo",
        "umbral": "4%"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción 2% compensación índices arbitraje",
      "properties": {
        "descripcion": "La exigencia de capital adicional de 2% se podrá aplicar sólo a uno de los índices cuando la entidad asuma posición contraria en exactamente el mismo índice a distintos vencimientos o mercados, quedando exenta la posición contraria"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción compensación índices similares arbitraje",
      "properties": {
        "descripcion": "La exigencia de 2% se aplica sólo a uno de los índices cuando la entidad mantenga posición opuesta en contratos a idéntica fecha pero en índices diferentes aunque similares con componentes comunes suficientes"
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Excepción compensación posiciones contrarias",
      "properties": {
        "descripcion": "Se podrán compensar posiciones contrarias, incluso en mercados diferentes o certificados de depósito de acciones, considerando todos los costos de conversión"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Incluir derivados en cómputo exigencia",
      "properties": {
        "descripcion": "A excepción de opciones sobre acciones e índices bursátiles, los restantes derivados sobre acciones y posiciones fuera de balance sensibles a cambios en precios deberán incluirse en el cómputo de la exigencia",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Convertir derivados a nocionales",
      "properties": {
        "descripcion": "Para el cálculo de exigencias por riesgo específico y riesgo general, las posiciones en derivados deberán convertirse en nocionales: futuros y forwards al precio de mercado, futuros sobre índices al valor nocional, swaps como dos posiciones nocionales",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Neteación de posiciones compensadas",
      "properties": {
        "descripcion": "Las posiciones compradas y vendidas en la misma especie podrán computarse en términos netos. Cada posición compensada con una acción o índice idéntico podrá ser neteada en su totalidad",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Vigilancia y gestión arbitraje",
      "properties": {
        "descripcion": "La estrategia de arbitraje futuro-canasta deberá haber sido adoptada en forma deliberada y se vigile y gestione en forma particularizada",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Computar riesgo tipo cambio derivados",
      "properties": {
        "descripcion": "Todo riesgo de tipo de cambio que surja de posiciones contrarias compensadas deberá computarse según lo establecido en el punto 6.4",
        "tipo": "calculo"
      }
    }
  ],
