    {
      "local_id": "obs1",
      "type": "Obligacion",
      "label": "Establecer procedimientos de valuación",
      "properties": {
        "descripcion": "Las entidades deberán establecer procedimientos para considerar la necesidad de realizar ajustes de valuación, a mercado o a modelo, particularmente en aquellos casos en que empleen valuaciones provistas por terceros.",
        "tipo": "otra",
        "plazo": "previo a la valuación"
      }
    },
    {
      "local_id": "obs2",
      "type": "Obligacion",
      "label": "Evaluar ajustes de valuación por márgenes y costos",
      "properties": {
        "descripcion": "Las entidades deberán evaluar si corresponde efectuar ajustes por márgenes de crédito no percibidos, costos de liquidación, riesgos operacionales, rescisión anticipada, costos de inversión y de financiación, costos administrativos futuros y, cuando proceda, el riesgo asociado a la utilización de modelos.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obs3",
      "type": "Obligacion",
      "label": "Establecer procedimientos para ajuste de posiciones menos líquidas",
      "properties": {
        "descripcion": "Las entidades deben establecer procedimientos para determinar la necesidad de realizar ajustes a los valores corrientes de las posiciones menos líquidas a los efectos del capital regulatorio.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Ajuste debe reflejar iliquidez de posición",
      "properties": {
        "descripcion": "El ajuste debe reflejar la iliquidez de la posición y puede ser incluso mayor que el ajuste requerido por las normas contables.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "obs4",
      "type": "Obligacion",
      "label": "Evaluación de ajuste a todas posiciones a mercado",
      "properties": {
        "descripcion": "La evaluación de la necesidad de efectuar ajustes debe alcanzar a todas las posiciones valuadas a mercado, ya sea que se empleen precios u otros datos observables, valuaciones de terceros o valuaciones a modelo.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obs5",
      "type": "Obligacion",
      "label": "Ajustar valor corriente y vigilar suficiencia",
      "properties": {
        "descripcion": "Se deberá ajustar el valor corriente de estas posiciones y vigilar en forma permanente la suficiencia del ajuste.",
        "tipo": "otra",
        "frecuencia": "permanente"
      }
    },
    {
      "local_id": "obs6",
      "type": "Obligacion",
      "label": "Computar precios para liquidación de posiciones",
      "properties": {
        "descripcion": "Para el cálculo del ajuste las entidades deben computar los precios a los que podrían liquidar las posiciones concentradas o vencidas y considerar factores como el tiempo necesario para cubrir la posición, riesgos, volatilidad promedio, cotizaciones independientes, volúmenes negociados, concentraciones de mercado, antigüedad de posiciones y dependencia de modelos.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obs7",
      "type": "Obligacion",
      "label": "Evaluar ajustes de valuación para productos complejos",
      "properties": {
        "descripcion": "Para productos complejos, por ejemplo titulizaciones y derivados crediticios de enésimo incumplimiento, las entidades deberán evaluar explícitamente la necesidad de ajustar la valuación para reflejar el riesgo de modelo: uso de metodología incorrecta y parámetros de calibración no observables.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Deducción de ajustes del capital ordinario nivel 1",
      "properties": {
        "descripcion": "Los ajustes al valor corriente de las posiciones menos líquidas se deben deducir del capital ordinario de nivel 1, incluso si exceden a los ajustes del punto 6.10.1.3 y a los originados en las normas contables.",
        "tipo": "limite_cualitativo"
      }
    },
