      "label": "Liquidación rápida de activos garantía",
      "properties": {
        "descripcion": "Los acuerdos de compensación deberán permitir la rápida liquidación o compensación de los activos admitidos en garantía ante un evento de incumplimiento",
        "tipo": "otra"
      }
    },
