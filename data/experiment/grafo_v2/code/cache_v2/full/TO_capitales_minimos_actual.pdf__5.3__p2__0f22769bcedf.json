      "type": "Restriccion",
      "label": "Restricción de activos garantía para compensación",
      "properties": {
        "descripcion": "Los activos que garanticen las operaciones compensadas deberán ser activos admitidos como garantía en la cartera de inversión",
        "tipo": "limite_cualitativo"
      }
