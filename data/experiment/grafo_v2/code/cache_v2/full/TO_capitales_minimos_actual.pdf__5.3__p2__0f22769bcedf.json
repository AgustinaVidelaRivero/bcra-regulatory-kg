      "label": "Validez legal de acuerdos de neteo",
      "properties": {
        "descripcion": "Los acuerdos de neteo bilateral que alcancen a operaciones de financiación con títulos valores deberán tener validez legal en toda jurisdicción en la que deban producir efectos en caso de ocurrir un evento de incumplimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Derecho a terminar y liquidar operaciones",
      "properties": {
        "descripcion": "Los acuerdos de compensación deberán proporcionar a la parte que no se encuentra en situación de incumplimiento el derecho a terminar y liquidar de manera oportuna todas las operaciones alcanzadas por el acuerdo ante un evento de incumplimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Compensación de pérdidas y ganancias",
      "properties": {
        "descripcion": "Los acuerdos de compensación deberán permitir la compensación de las pérdidas y ganancias resultantes de las operaciones terminadas y liquidadas bajo el alcance del acuerdo marco",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl4",
