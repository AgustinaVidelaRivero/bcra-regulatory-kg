    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Prohibición de nuevas financiaciones para cancelación de preexistentes",
      "properties": {
        "descripcion": "No se recurra a nuevas financiaciones o refinanciaciones destinadas a cancelar obligaciones preexistentes, cualquiera sea la modalidad (prórrogas, esperas, ampliaciones de plazo, disminuciones en importes de cuotas, renovaciones, reestructuraciones)",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Limitación de mejora clasificación por atraso mayor a 31 días",
      "properties": {
        "descripcion": "No se podrán efectuar mejoras en las clasificaciones de los clientes si los mismos registran un atraso mayor a 31 días en el pago de sus obligaciones refinanciadas",
        "tipo": "limite_cualitativo",
        "umbral": "31 días de atraso"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Exclusión de mejora clasificación por aplicación previos cobros y quitas",
      "properties": {
        "descripcion": "Los cobros no aplicados y quitas concedidas con anterioridad a la refinanciación no son computables para la mejora de clasificación",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Limitación de facilidades adicionales a 10% del cupo",
      "properties": {
        "descripcion": "Las facilidades adicionales respecto de márgenes vigentes no deben superar el 10% del cupo asignado en la última evaluación crediticia",
        "tipo": "limite_cuantitativo",
        "umbral": "10%"
      }
    },
    {
      "local_id": "res5",
      "type": "Restriccion",
      "label": "Prohibición de mejoría clasificación en contexto de Emergencia Agropecuaria",
      "properties": {
        "descripcion": "El tratamiento bajo Ley de Emergencia Agropecuaria no podrá implicar mejoramiento de clasificación asignada al cliente en función de su situación individual preexistente, ni extenderse más allá de la vigencia de la emergencia",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción de refinanciaciones bajo Ley de Emergencia Agropecuaria",
      "properties": {
        "descripcion": "No se considerarán como nuevas financiaciones las refinanciaciones otorgadas a productores cuando resulten de aplicación de disposiciones de la Ley de Emergencia Agropecuaria"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción de facilidades para expansión de actividades",
      "properties": {
        "descripcion": "No se considerarán refinanciaciones las renovaciones periódicas de crédito para capital de trabajo ni nuevas financiaciones asociadas a mayor inversión derivada de expansión de actividades, en la medida que sean consistentes con el curso normal de los negocios"
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Excepción de excedencia de márgenes dentro de asistencia máxima",
      "properties": {
        "descripcion": "Los excesos de márgenes de crédito no serán considerados refinanciaciones si no se supera el límite de asistencia máxima acordada por todo concepto en función de capacidad de pago"
      }
    },
    {
      "local_id": "exc4",
      "type": "Excepcion",
      "label": "Excepción de evaluación de capacidad en préstamos con métodos específicos",
      "properties": {
        "descripcion": "No es obligatoria la evaluación de capacidad de pago en función de ingresos cuando se utilicen métodos específicos de evaluación o se trate de deudores por préstamos de monto reducido"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Análisis previo considerando capacidad de pago",
      "properties": {
        "descripcion": "Los análisis previos al otorgamiento de financiaciones y refinanciaciones deben guardar relación con la capacidad de pago de los deudores, evaluando la afectación de sus ingresos periódicos por la totalidad de compromisos de crédito asumidos",
        "tipo": "calculo",
        "plazo": "Al momento previo al otorgamiento"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Clasificación mensual con pautas objetivas",
      "properties": {
        "descripcion": "La clasificación de clientes se efectuará considerando al cabo de cada mes exclusivamente pautas objetivas vinculadas al grado de cumplimiento de obligaciones, situación jurídica, informaciones de Central de deudores del sistema financiero, base de Deudores en situación irregular de ex entidades financieras y situación de aplicación de pautas de refinanciación",
        "tipo": "asignacion",
        "frecuencia": "mensual"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Consideración de mayor riesgo de incobrabilidad",
      "properties": {
        "descripcion": "En caso de discrepancias entre criterios de clasificación, se deberá considerar la pauta que indique el mayor nivel de riesgo de incobrabilidad",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Evaluación específica para mejora en refinanciaciones",
      "properties": {
        "descripcion": "A fin de determinar una mejora en la clasificación del deudor en caso de refinanciaciones, corresponderá tener en cuenta las pautas específicas previstas en cada una de las categorías",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Consideración de mora en Emergencia Agropecuaria",
      "properties": {
        "descripcion": "A los fines de clasificación bajo Emergencia Agropecuaria, deberá tenerse en cuenta la mora en el atraso de obligaciones para el momento en que concluya la vigencia de la emergencia declarada",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Consideración de cancelación de cuotas para mejora clasificación",
      "properties": {
        "descripcion": "Para determinar mejora de clasificación de deudor recategorizado en niveles inferiores, corresponderá considerar cancelación de cuotas mínimas (financiaciones periódicas) o porcentaje de cancelación de saldo por capital (financiaciones de pago único o irregular)",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Imputación de pagos según criterio de la entidad",
      "properties": {
        "descripcion": "La forma en que se imputen cobros no aplicados y quitas concedidas previas a refinanciación a la cancelación de deuda dependerá del criterio que opte por emplear cada entidad, sin perjuicio de otras disposiciones aplicables",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Cómputo de pagos anticipados en refinanciación",
      "properties": {
        "descripcion": "Los pagos por adelantado y/o anticipos en oportunidad de refinanciación se computarán en términos de cuotas o porcentaje de amortización de capital según modalidad de pago, en relación al saldo de capital de obligación refinanciada",
        "tipo": "calculo"
      }
    }
  ],
