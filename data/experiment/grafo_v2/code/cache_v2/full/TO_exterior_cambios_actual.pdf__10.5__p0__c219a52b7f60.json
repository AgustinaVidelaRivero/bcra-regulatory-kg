  "location": "Punto 10.5. Seguimiento de pagos de importaciones con registro de ingreso aduanero pendiente (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Exterior y Cambios",
      "properties": {
        "materia": "Operaciones de cambios y comercio exterior",
        "archivo": "TO_exterior_cambios_actual.pdf",
        "version": "8a. COMUNICACIÓN A 8307"
      }
    },
    {
      "local_id": "e1",
      "type": "Operacion",
      "label": "Seguimiento de pagos de importaciones",
      "properties": {
        "tipo": "seguimiento_de_pagos_de_importaciones",
        "description": "Seguimiento desde la fecha de acceso al mercado de cambios hasta la fecha en que se produzca su regularización de pagos de importaciones con registro de ingreso aduanero pendiente efectuado a partir del 02/09/19"
      }
    },
    {
      "local_id": "e2",
      "type": "Operacion",
      "label": "Regularización de pagos aduaneros",
      "properties": {
        "tipo": "regularizacion_de_pagos",
        "description": "Se considerará regularizada la situación de estos pagos a los efectos cambiarios cuando se demuestre ante la entidad encargada del seguimiento del pago, y por hasta el monto girado, la existencia de registro de ingreso aduanero, liquidación en mercado de cambios, otras formas de regularización o conformidad del BCRA"
      }
    },
    {
      "local_id": "e3",
      "type": "Obligacion",
      "label": "Demostración de ingreso aduanero",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se deberá demostrar ante la entidad encargada del seguimiento de ese pago la existencia del registro de ingreso aduanero a su nombre o a nombre de un tercero en la medida que se cumplan las condiciones establecidas en la presente normativa",
        "plazo": "hasta que se produzca la regularización"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Certificación de cumplimiento de requisitos",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad encargada del seguimiento del pago podrá afectar el registro de ingreso aduanero de una oficialización de importación a la regularización de una operación a su cargo, en la medida que certifique que se cumplen los requisitos enunciados en el punto 10.3.2.1.",
        "plazo": ""
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Incorporación en SEPAIMPO de afectaciones",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Las afectaciones con imputación a un pago deberán ser incorporadas en el SEPAIMPO por la entidad a cargo del seguimiento del pago",
        "frecuencia": "conforme se realicen las afectaciones"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Intervención de documentación aduanera",
      "properties": {
        "tipo": "otra",
        "description": "La entidad deberá intervenir la documentación aduanera, dejando constancia de la fecha, la identificación del pago con ingreso aduanero pendiente y monto afectado al mismo"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Verificación de condiciones de regularización",
      "properties": {
        "tipo": "otra",
        "description": "En el caso de una devolución de fondos del exterior asociada a un pago con registro aduanero pendiente, la entidad deberá contar con la certificación emitida por la entidad que dio curso a la liquidación en el mercado de cambios. Para los mecanismos previstos en los puntos 10.5.4., 10.5.5.1. y 10.5.5.2., la entidad deberá verificar el cumplimiento de las condiciones previstas en cada caso"
      }
    },
    {
      "local_id": "e8",
      "type": "Excepcion",
      "label": "Excepción a demostración de ingreso de fondos",
      "properties": {
        "descripcion": "El importador podrá optar en casos de saldos pendientes de entrega, diferencias por tipos de pase, incumplimientos de entrega por parte del proveedor externo, para que se dé por cumplida su obligación de demostrar la oficialización del ingreso"
      }
    },
    {
      "local_id": "e9",
      "type": "Restriccion",
      "label": "Límite de uso de excepción de demostración",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "USD 10.000",
        "descripcion": "El importador no habrá hecho uso de esta alternativa por un monto mayor al equivalente de USD 10.000 (dólares estadounidenses diez mil) en el año calendario por fecha de pago"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Exigencia de declaración jurada de importador",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad deberá exigir una declaración jurada sobre el carácter genuino de los motivos declarados, firmada por el importador o quien ejerza su representación legal o un apoderado con facultades suficientes"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Incorporación en SEPAIMPO de registros de excepción",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad a cargo del seguimiento deberá incorporar en el SEPAIMPO los registros correspondientes a la aplicación de la excepción"
      }
    },
    {
      "local_id": "e12",
      "type": "Operacion",
      "label": "Otorgamiento de prórrogas de plazo",
      "properties": {
        "tipo": "otorgamiento_de_prorrogas",
        "description": "Las prórrogas del plazo para la demostración del registro de ingreso aduanero de importación"
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Registro de prórrogas en SEPAIMPO",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Estas prórrogas deberán ser registradas por la entidad encargada del seguimiento del pago en el sistema SEPAIMPO",
        "frecuencia": "conforme se otorguen las prórrogas"
      }
    },
    {
      "local_id": "e14",
      "type": "Restriccion",
      "label": "Límite de prórrogas por siniestro",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "5 prórrogas sucesivas de 180 días corridos",
        "descripcion": "La entidad a cargo del seguimiento podrá otorgar hasta cinco prórrogas sucesivas de 180 (ciento ochenta) días corridos de plazo hasta la fecha de la liquidación del seguro, cuando se cumpla con los requisitos de siniestro"
      }
    },
    {
      "local_id": "e15",
      "type": "Obligacion",
      "label": "Requisitos para prórroga por siniestro",
      "properties": {
        "tipo": "otra",
        "description": "Para otorgar prórroga por siniestro debe cumplirse que: i) la falta total o parcial de la oficialización de la documentación aduanera se justifica en un siniestro; ii) el embarque cuenta con un seguro por la cobertura del siniestro; iii) se cuenta con factura del exportador, póliza del seguro, documentación de transporte, denuncia del siniestro"
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Liquidación de divisas del seguro en mercado",
      "properties": {
        "tipo": "otra",
        "description": "De haberse realizado el pago en moneda extranjera, el monto percibido en moneda extranjera por el cobro del seguro deberá ser ingresado y liquidado en el mercado de cambios dentro de los 20 (veinte) días hábiles siguientes a la fecha de efectiva percepción",
        "plazo": "20 días hábiles"
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Exigencia de declaración jurada por siniestro",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "En todos los casos de siniestro, la entidad deberá exigir una declaración jurada sobre el carácter genuino de lo declarado, firmada por el importador o quien ejerza su representación legal o un apoderado con facultades suficientes"
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Registro de no recupero en SEPAIMPO",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Utilizados los plazos máximos con sus sucesivas renovaciones, la entidad registrará la condición de no recupero total o parcial de los fondos en el SEPAIMPO, dando por finalizado su seguimiento del pago"
      }
    },
