        "plazo": "mensual"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Consignar importe total Patrimonio Neto",
      "properties": {
        "descripcion": "Se consignará el importe total del Patrimonio Neto (rubro 400000 del balance), excluyendo las acciones con preferencia patrimonial y la reserva especial para instrumentos de deuda.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Integrar partidas según período informado",
      "properties": {
        "descripcion": "Se integrarán las partidas que corresponda, según el período informado.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Consignar otros resultados integrales computables",
      "properties": {
        "descripcion": "Se consignarán los otros resultados integrales provenientes de revaluación de propiedad, planta y equipo e intangibles y de ganancias o pérdidas por instrumentos financieros a valor razonable con cambios en ORI que resulten computables conforme lo establecido en el punto 8.2.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Consignar saldo deudor otros resultados integrales",
      "properties": {
        "descripcion": "Se consignará el saldo deudor proveniente del resto de los conceptos componentes de otros resultados integrales, excepto los contemplados en la partida 28100000.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Incluir acciones ordinarias subsidiarias en consolidación",
      "properties": {
        "descripcion": "En los casos de consolidación se incluirán las acciones ordinarias emitidas por subsidiarias sujetas a supervisión consolidada y en poder de terceros, que cumplan con los criterios establecidos en el punto 8.3.5.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl7",
      "type": "Obligacion",
      "label": "Informar diferencia previsión NIIF 9 regulatoria",
      "properties": {
        "descripcion": "Diferencia –positiva o negativa, según corresponda- entre la previsión contable según el punto 5.5. de la NIIF 9 y la previsión regulatoria según las normas sobre Previsiones mínimas por riesgo de incobrabilidad.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl8",
      "type": "Obligacion",
      "label": "Informar existencias de títulos valores no poseídos",
      "properties": {
        "descripcion": "Se informarán las existencias de títulos valores, certificados de depósitos a plazo fijo, otros títulos de crédito, etc., que no se encuentren físicamente en poder de la entidad.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl9",
      "type": "Obligacion",
      "label": "Incluir mayor saldo instrumentos subordinados",
      "properties": {
        "descripcion": "Se incluirá el mayor saldo registrado durante el mes a que corresponde la determinación de la responsabilidad patrimonial computable, de la tenencia de títulos valores y otros instrumentos de deuda, contractualmente subordinados.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl10",
      "type": "Obligacion",
      "label": "Consignar mayor saldo corresponsalía entidades extranjeras",
      "properties": {
        "descripcion": "Se consignará el mayor saldo registrado durante el mes a que corresponde la determinación de la responsabilidad patrimonial computable, de las cuentas de corresponsalía con entidades financieras del exterior que no cuenten con calificación investment grade.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl11",
      "type": "Obligacion",
      "label": "Incluir mayor saldo títulos gobiernos extranjeros no investment grade",
      "properties": {
        "descripcion": "Se incluirá el mayor saldo registrado durante el mes a que corresponde la determinación del capital ordinario de nivel 1, de los títulos emitidos por gobiernos de países extranjeros, cuya calificación internacional sea inferior a la asignada a títulos públicos nacionales.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl12",
      "type": "Obligacion",
      "label": "Detallar bienes inmuebles para uso propio",
      "properties": {
        "descripcion": "Se detallará el 100% del valor -neto de la depreciación acumulada- de los bienes inmuebles para uso propio y diversos, cuya registración contable no se encuentre respaldada con la pertinente escritura traslativa de dominio debidamente inscripta.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl13",
      "type": "Obligacion",
      "label": "Incluir activos intangibles netos",
      "properties": {
        "descripcion": "Se incluirán los activos intangibles netos de sus respectivas amortizaciones acumuladas. Comprende la llave de negocio que cumpla los requisitos establecidos.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl14",
      "type": "Obligacion",
      "label": "Informar diferencias insuficiencia previsiones",
      "properties": {
        "descripcion": "Comprende las diferencias por insuficiencia de constitución de las previsiones mínimas por riesgo de incobrabilidad determinada por la Superintendencia de Entidades Financieras y Cambiarias.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl15",
      "type": "Obligacion",
      "label": "Registrar llave negativa adquisiciones participaciones",
      "properties": {
        "descripcion": "Comprende el valor -neto de desafectaciones- de la llave negativa registrada en adquisiciones de participaciones por un costo inferior a su valor patrimonial proporcional.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl16",
      "type": "Obligacion",
      "label": "Informar saldo impuesto ganancia mínima presunta",
      "properties": {
        "descripcion": "Comprende el saldo a favor por aplicación del impuesto a la ganancia mínima presunta -neto de las previsiones- que exceda el 10% del patrimonio neto básico correspondiente al mes anterior.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl17",
      "type": "Obligacion",
      "label": "Informar aportes no capitalizados autorizados",
      "properties": {
        "descripcion": "Se informarán los aportes registrados contablemente como tales cuya capitalización aún no haya sido autorizada por la SEFyC.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "obl18",
      "type": "Obligacion",
      "label": "Consignar excesos límites afectación activos",
      "properties": {
        "descripcion": "Se consignarán los excesos a los límites para la afectación de activos en garantía, según lo dispuesto en la Sección 3.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Exclusión acciones preferencia patrimonial",
      "properties": {
        "descripcion": "No se considerarán las acciones con preferencia patrimonial y la reserva especial para instrumentos de deuda en el cálculo del Patrimonio Neto.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Exclusión otros resultados integrales no especificados",
      "properties": {
        "descripcion": "No se considerarán los otros resultados integrales acumulados, cuya parte computable se informará en las partidas 28100000 y 28200000.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Límite saldo favor impuesto ganancia mínima presunta",
      "properties": {
        "descripcion": "El saldo a favor por aplicación del impuesto a la ganancia mínima presunta se incluirá solamente si excede el 10% del patrimonio neto básico.",
        "tipo": "limite_cuantitativo",
        "umbral": "10%"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Titulos gobiernos extranjeros sin mercados habituales",
      "properties": {
        "descripcion": "Los títulos emitidos por gobiernos de países extranjeros, cuya calificación internacional sea inferior a la asignada a títulos públicos nacionales de la República Argentina, y que no cuenten con mercados donde se transen en forma habitual por valores relevantes.",
        "tipo": "limite_cualitativo"
      }
    }
