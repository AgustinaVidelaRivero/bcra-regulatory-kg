    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Asignación de instrumentos a tasa fija",
      "properties": {
        "tipo": "asignacion_de_instrumentos",
        "description": "Los instrumentos a tasa fija se asignarán según su plazo residual"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Asignación de instrumentos a tasa variable",
      "properties": {
        "tipo": "asignacion_de_instrumentos",
        "description": "Los instrumentos a tasa variable según el plazo que resta hasta el siguiente ajuste del interés"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Determinación del ponderador de riesgo",
      "properties": {
        "tipo": "calculo",
        "description": "El ponderador de riesgo de los instrumentos a tasa variable dependerá de que el cupón de renta del período en curso represente o no un rendimiento menor a 3% anual"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Exclusión de posiciones opuestas",
      "properties": {
        "tipo": "exclusion",
        "description": "Se podrán excluir las posiciones opuestas por el mismo importe en una misma especie, como así también los derivados (swaps, forwards, futuros y FRAs) estrechamente relacionados"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Ponderación de posiciones por factor de sensibilidad",
      "properties": {
        "tipo": "calculo",
        "description": "Las posiciones imputadas a cada banda temporal deberán ponderarse por un factor que refleje su sensibilidad a los cambios en las tasas de interés"
      }
    },
    {
      "local_id": "op6",
      "type": "Operacion",
      "label": "Compensación de posiciones dentro de bandas",
      "properties": {
        "tipo": "compensacion",
        "description": "Las posiciones ponderadas deberán compensarse (compradas/vendidas) dentro de cada banda temporal, para obtener así una posición neta"
      }
    },
    {
      "local_id": "op7",
      "type": "Operacion",
      "label": "Aplicación de desestimación vertical",
      "properties": {
        "tipo": "calculo",
        "description": "Se aplicará una exigencia adicional equivalente al 10% de la menor de las posiciones compensadas (en valor absoluto) - desestimación vertical"
      }
    },
    {
      "local_id": "op8",
      "type": "Operacion",
      "label": "Compensaciones horizontales entre zonas",
      "properties": {
        "tipo": "compensacion",
        "description": "Las entidades podrán realizar dos series de compensaciones horizontales: primero, entre las posiciones netas dentro de cada una de las tres zonas y luego entre las posiciones netas de las tres zonas"
      }
    },
    {
      "local_id": "op9",
      "type": "Operacion",
      "label": "Conversión de derivados a posiciones subyacentes",
      "properties": {
        "tipo": "conversion",
        "description": "Los derivados se deberán convertir a posiciones en el correspondiente subyacente y se les aplicarán las exigencias de capital por riesgo"
      }
    },
    {
      "local_id": "op10",
      "type": "Operacion",
      "label": "Tratamiento de posiciones en monedas residuales",
      "properties": {
        "tipo": "aplicacion_ponderador",
        "description": "Las posiciones brutas en cada banda temporal estarán sujetas a los ponderadores de riesgo, sin compensación"
      }
    },
    {
      "local_id": "op11",
      "type": "Operacion",
      "label": "Cálculo de posiciones en futuros y FRAs",
      "properties": {
        "tipo": "calculo",
        "description": "Los futuros y contratos a término se considerarán como una combinación de una posición comprada y otra vendida en un título público"
      }
    },
    {
      "local_id": "op12",
      "type": "Operacion",
      "label": "Tratamiento de swaps de tasas",
      "properties": {
        "tipo": "calculo",
        "description": "Los swaps se considerarán como dos posiciones nocionales en títulos públicos con los vencimientos que correspondan"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Imputar posiciones a banda temporal según proximidad",
      "properties": {
        "tipo": "calculo",
        "description": "Al efecto de imputar una posición a la escala de vencimientos cuando el plazo residual es igual al límite entre dos bandas, corresponderá realizar la imputación a la banda temporal más próxima a la fecha de cálculo",
        "plazo": "En cada cálculo"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Aplicar escala de desestimaciones horizontales",
      "properties": {
        "tipo": "calculo",
        "description": "Las compensaciones estarán sujetas a la escala de desestimaciones horizontales expresadas como porcentajes de las posiciones que se compensan (40% dentro de zona, 30%-40% entre zonas adyacentes, 100% entre zonas 1 y 3)",
        "plazo": "En cada compensación"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Abarcar derivados de tasas en sistema de medición",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "El sistema de medición deberá abarcar a todos los derivados de tasas de interés e instrumentos fuera de balance de la cartera de negociación sensibles a cambios en tasas (FRAs, futuros, swaps, cross-currency swaps, posiciones de divisas a término)"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Seguir disposiciones para valuación de nocional",
      "properties": {
        "tipo": "calculo",
        "description": "Para determinar el valor de mercado del nocional subyacente se seguirán las disposiciones del punto 6.10 para una valuación prudente"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Seleccionar título a entregar en futuros",
      "properties": {
        "tipo": "otra",
        "description": "En los casos en que se pueda entregar una gama de instrumentos para cumplir con el contrato, la entidad podrá elegir qué título, entre los que pueden ser entregados, insertará en la escala de vencimientos, tomando en consideración los factores de conversión aplicables"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Imputar componentes de swaps a bandas",
      "properties": {
        "tipo": "calculo",
        "description": "En los swaps que pagan o reciben una tasa de interés a cambio de otro precio de referencia, el componente tasa de interés se imputará a la banda correspondiente y el componente accionario dará lugar a exigencia por posiciones en acciones. Cada lado de un swap de moneda se deberá imputar a la escala de vencimientos de la moneda correspondiente"
      }
    }
  ],
