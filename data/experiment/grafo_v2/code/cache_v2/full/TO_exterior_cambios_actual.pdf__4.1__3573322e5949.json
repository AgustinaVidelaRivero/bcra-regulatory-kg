    {
      "local_id": "ob_seleccionar_cuenta",
      "type": "Obligacion",
      "label": "Ofrecer selección remota de cuenta",
      "properties": {
        "descripcion": "Las entidades financieras deberán ofrecer a sus clientes la posibilidad de seleccionar y modificar, en forma remota, la cuenta asociada a su tarjeta de débito sobre la cual se efectuarán los débitos, debiendo tomar por defecto como cuenta primaria en estos casos, la cuenta en moneda extranjera del cliente, en caso de que fuera titular de una cuenta en moneda extranjera.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "res_extraccion_pesos",
      "type": "Restriccion",
      "label": "Extracción en pesos como formación activos externos",
      "properties": {
        "descripcion": "Una extracción con una tarjeta de débito o cualquier modalidad que implique un débito inmediato en una cuenta en pesos en una entidad financiera local o con una tarjeta prepaga emitida en el país con saldo en pesos será considerada una formación de activos externos en billetes encuadrada en el punto 3.8., debiendo cumplirse con los requisitos aplicables.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "ob_registracion_pesos",
      "type": "Obligacion",
      "label": "Registración e informe de extracción en pesos",
      "properties": {
        "descripcion": "La entidad deberá realizar previamente la correspondiente registración o constatación, según corresponda, en el sistema online e informar la operación como una compra de billetes de moneda extranjera (código de concepto A09).",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "res_limite_adelanto_50",
      "type": "Restriccion",
      "label": "Límite adelanto efectivo USD 50 por operación",
      "properties": {
        "descripcion": "Las entidades financieras y otras emisoras de tarjetas locales de crédito y/o compra podrán otorgar como adelanto en efectivo a los tarjetahabientes en el exterior, un monto máximo de USD 50 (dólares estadounidenses cincuenta) por operación.",
        "tipo": "limite_cuantitativo",
        "umbral": "USD 50"
      }
    },
    {
      "local_id": "res_limite_adelanto_200",
      "type": "Restriccion",
      "label": "Límite adelanto efectivo USD 200 países no limítrofes",
      "properties": {
        "descripcion": "Dicho límite se incrementa a USD 200 (dólares estadounidenses doscientos) por operación por los retiros de efectivo que se realicen en países no limítrofes.",
        "tipo": "limite_cuantitativo",
        "umbral": "USD 200"
      }
    },
    {
      "local_id": "exc_limite_200",
      "type": "Excepcion",
      "label": "Excepción límite adelanto en países no limítrofes",
      "properties": {
        "descripcion": "El límite de USD 50 se incrementa a USD 200 por operación para retiros de efectivo que se realicen en países no limítrofes."
      }
    },
    {
      "local_id": "op_consumo_exterior",
      "type": "Operacion",
      "label": "Consumo en exterior con tarjeta",
      "properties": {
        "tipo": "Consumo en exterior"
      }
    },
    {
      "local_id": "ob_seleccionar_cuenta_consumo",
      "type": "Obligacion",
      "label": "Ofrecer selección cuenta para consumos",
      "properties": {
        "descripcion": "Las entidades financieras deberán ofrecer a sus clientes la posibilidad de seleccionar y modificar la cuenta sobre la cual se efectuarán los débitos, debiendo tomar por defecto como cuenta primaria en estos casos a la cuenta en moneda extranjera del cliente en caso de que la tuviera.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "op_cancelacion_consumos_extranjera",
