    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Límite de prórroga en gestión de cobro",
      "properties": {
        "descripcion": "La entidad otorgará hasta cinco prórrogas sucesivas de hasta 180 (ciento ochenta) días corridos en operaciones de gestión de cobro por incumplimiento del proveedor.",
        "tipo": "limite_cuantitativo",
        "umbral": "5 prórrogas de 180 días máximo"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Límite de plazo para ampliación por causales ajenas",
      "properties": {
        "descripcion": "Para pagos anticipados de bienes de capital, la extensión de plazos no podrá superar los 545 (quinientos cuarenta y cinco) días corridos. Para los restantes pagos, no podrá superar los 365 (trescientos sesenta y cinco) días corridos, contándose desde la fecha de acceso al mercado de cambios.",
        "tipo": "limite_cuantitativo",
        "umbral": "545 días (bienes capital) / 365 días (otros)"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Exclusión de demoras por decisiones financieras del importador",
      "properties": {
        "descripcion": "La demora en efectuar la oficialización por decisiones del importador motivadas en cuestiones financieras o de mercado no está comprendida entre las causales admitidas para ampliación de plazo.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Límite de monto para gestión de cobro por deudor moroso",
      "properties": {
        "descripcion": "La alternativa de demostrar gestión de cobro a través de compañías de seguro de crédito o agencias de recupero solo será válida en la medida que el valor adeudado no supere el equivalente de USD 100.000 (dólares estadounidenses cien mil).",
        "tipo": "limite_cuantitativo",
        "umbral": "USD 100.000"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Obligación de ingreso de moneda extranjera al mercado de cambios",
      "properties": {
        "descripcion": "Si el importador percibiera un monto en moneda extranjera, el mismo deberá ser ingresado y liquidado en el mercado de cambios dentro de los 20 (veinte) días hábiles siguientes a la fecha de efectiva percepción.",
        "tipo": "limite_cuantitativo",
        "umbral": "20 días hábiles"
      }
    },
    {
      "local_id": "oblig1",
      "type": "Obligacion",
      "label": "Denuncia de incumplimiento de regularización",
      "properties": {
        "descripcion": "La entidad a cargo del seguimiento de los pagos con registro de ingreso aduanero pendiente deberá, dentro de los 5 (cinco) días hábiles siguientes a la fecha de vencimiento de los plazos establecidos en la presente norma, informar en el SEPAIMPO las operaciones de los importadores que no hubieran regularizado su situación.",
        "tipo": "presentacion_informativa",
        "plazo": "5 días hábiles"
      }
    },
    {
      "local_id": "oblig2",
      "type": "Obligacion",
      "label": "Exigencia de declaración jurada al importador",
      "properties": {
        "descripcion": "La entidad deberá exigir una declaración jurada sobre el carácter genuino de lo declarado, firmada por el importador o quien ejerza su representación legal o un apoderado con facultades suficientes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig3",
      "type": "Obligacion",
      "label": "Archivo de documentación de causales de demora",
      "properties": {
        "descripcion": "La documentación que avale la causal de la demora que respalda la ampliación del plazo otorgada por la entidad, deberá quedar archivada en la entidad a disposición del BCRA.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "oblig4",
      "type": "Obligacion",
      "label": "Consideración de tipos de pase para monedas distintas",
      "properties": {
        "descripcion": "A los efectos de determinar los montos pendientes en los casos de facturaciones en monedas distintas a las monedas de transferencia, la entidad encargada del seguimiento del pago deberá considerar los tipos de pase correspondientes a la fecha de transferencia al beneficiario de los fondos.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Ampliación de plazo para causales ajenas al importador",
      "properties": {
        "descripcion": "En los casos de demoras en el registro de ingreso aduanero por causales ajenas a la voluntad de decisión del importador que afecten a la mayor parte del monto pendiente, la entidad interviniente podrá otorgar una extensión de los plazos establecidos."
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Ampliación mayor de plazo con conformidad del BCRA",
      "properties": {
        "descripcion": "Agotados los plazos que puede otorgar la entidad a cargo del seguimiento, esta última podrá solicitar la conformidad del BCRA para una ampliación mayor en la medida que subsistan causales de demora ajenas al importador."
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Prórroga por demostración de reclamo vigente",
      "properties": {
        "descripcion": "La operación podrá permanecer en 'gestión de cobro' mientras se demuestre la vigencia del reclamo y de las condiciones que explican la demora en la ejecución de la transferencia."
      }
    },
