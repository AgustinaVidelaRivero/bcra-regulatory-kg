  "location": "Punto 6.10. Tratamiento para las posiciones de menor liquidez. (parte 1)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Capitales Mínimos",
      "properties": {
        "materia": "Capital mínimo por riesgo de mercado",
        "archivo": "TO_capitales_minimos_actual.pdf",
        "version": "2a"
      }
    },
    {
      "local_id": "c1",
      "type": "Comunicacion",
      "label": "Com. A 6690",
      "properties": {
        "codigo": "A-6690",
        "tipo": "A",
        "numero": "6690"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Valuación prudente de posiciones menos líquidas",
      "properties": {
        "descripcion": "Se establecen lineamientos para la valuación prudente de las posiciones contabilizadas a valor razonable (fair value), especialmente importante para posiciones sin precios de mercado observables o menos líquidas que exigen mayores recaudos",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Valuación de posiciones a valor razonable",
      "properties": {
        "tipo": "Valuación de posiciones de negociación e inversión"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Marco de valuación prudente",
      "properties": {
        "descripcion": "Un marco de valuación prudente deberá incluir, como mínimo: sistemas y controles, metodologías de valuación",
        "tipo": "otra",
        "plazo": "Permanente"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Sistemas y controles de valuación",
      "properties": {
        "descripcion": "Los sistemas y controles deben garantizar a los directores y/o gerentes de la entidad y a la SEFyC que los valores estimados sean prudentes y fiables. Estos sistemas deberán estar integrados a los demás sistemas de gestión de riesgos y deberán incluir políticas y procedimientos documentados, líneas claras de reporte independientes del front office hasta el directorio",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Valuación a mercado cuando sea posible",
      "properties": {
        "descripcion": "La valuación se deberá hacer a mercado siempre que sea posible. Se deberá utilizar el valor más prudente del intervalo precio de compra/precio de venta, a menos que la entidad sea un importante creador de mercado",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Maximizar uso de datos observables",
      "properties": {
        "descripcion": "Las entidades deberán maximizar el uso de los datos observables cuando éstos sean relevantes para la estimación del valor razonable mediante técnicas de valuación",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Valuación a modelo con prudencia",
      "properties": {
        "descripcion": "Se podrá valuar a modelo sólo cuando no sea posible valuar a mercado y siempre que se pueda demostrar que con ello se arriba a una valuación prudente. Cuando se valúe a modelo, se deberán aplicar criterios aún más conservadores",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Alta Gerencia conocerá elementos valuados a modelo",
      "properties": {
        "descripcion": "La Alta Gerencia deberá conocer qué elementos de las carteras de negociación o de inversión se valúan a modelo y comprender la significatividad de la incertidumbre que ello crea",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Datos de mercado de fuentes adecuadas",
      "properties": {
        "descripcion": "Los datos de mercado deberán proceder, en la medida de lo posible, de las mismas fuentes que los precios de mercado. Se deberá comprobar periódicamente que los datos de mercado son adecuados para valuar cada posición",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Utilizar metodologías de valuación generalmente aceptadas",
      "properties": {
        "descripcion": "Siempre que se disponga de ellas, y en la medida de lo posible, deberán utilizarse metodologías de valuación generalmente aceptadas para cada producto concreto",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Modelos propios con supuestos evaluados independientemente",
      "properties": {
        "descripcion": "Cuando la entidad desarrolle modelos propios, éstos se deberán basar en supuestos adecuados, evaluados y probados por personal calificado que no participe en el desarrollo. El modelo deberá ser desarrollado o aprobado con independencia del front office",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob10",
      "type": "Obligacion",
      "label": "Validación independiente de modelos",
      "properties": {
        "descripcion": "Se deberán validar de forma independiente las fórmulas matemáticas, los supuestos utilizados y la implementación del software",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob11",
      "type": "Obligacion",
      "label": "Control de modificaciones y copia del modelo",
      "properties": {
        "descripcion": "Se deberán implementar procedimientos formales de control de las modificaciones y guardar copia del modelo con el objeto de verificar periódicamente las valuaciones",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob12",
      "type": "Obligacion",
      "label": "Gestión de riesgos conocerá debilidades de modelos",
      "properties": {
        "descripcion": "Los responsables de la gestión de riesgos deberán conocer las debilidades de los modelos utilizados y el mejor modo de reflejarlas en los resultados de la valuación",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob13",
      "type": "Obligacion",
      "label": "Exámenes periódicos de fiabilidad del modelo",
      "properties": {
        "descripcion": "Deberá someterse el modelo a exámenes periódicos a fin de determinar la fiabilidad de sus resultados, por ejemplo, probando que los supuestos continúan siendo válidos, analizando pérdidas y ganancias en relación con factores de riesgo y comparando resultados del modelo con valores de liquidación",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob14",
      "type": "Obligacion",
      "label": "Ajustes a valuación cuando sea necesario",
      "properties": {
        "descripcion": "Cuando sea necesario se deberán hacer ajustes a la valuación observando lo dispuesto en los puntos 6.10.1.3. y 6.10.2.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob15",
      "type": "Obligacion",
      "label": "Verificación independiente de precios",
      "properties": {
        "descripcion": "Se trata de un proceso en el que se verifica periódicamente la exactitud de los precios o de los datos de un modelo. La verificación de los precios de mercado o de los datos del modelo debe estar a cargo de una unidad independiente de la unidad responsable de las operaciones (dealing room). Dicha verificación se debe llevar a cabo al menos con periodicidad mensual, o de forma más frecuente, en función de la naturaleza del mercado o la actividad de negociación",
        "tipo": "otra",
        "plazo": "Mensual o más frecuente según naturaleza del mercado"
      }
    }
  ],
