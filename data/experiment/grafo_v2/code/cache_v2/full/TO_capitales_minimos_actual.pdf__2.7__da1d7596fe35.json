      "label": "Considerar definiciones para ponderadores",
      "properties": {
        "tipo": "otra",
        "description": "Las entidades financieras deberán considerar las siguientes definiciones a los fines de asignar los ponderadores de riesgo previstos en el punto 2.12: empresas con grado de inversión, financiación especializada de grandes proyectos de infraestructura y MiPyMEs"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Evaluación de grado de inversión",
      "properties": {
        "tipo": "clasificacion_riesgo",
        "description": "Evaluación de si una empresa tiene grado de inversión considerando la complejidad del modelo de negocios, desempeño en relación con su industria y riesgos de su entorno operativo"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Requisito emisión de títulos valores",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La empresa con grado de inversión (o su controlante) deberá haber emitido títulos valores que coticen en bolsas o mercados de valores reconocidos"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Financiación especializada de proyectos de infraestructura",
      "properties": {
        "tipo": "financiacion_especializada",
        "description": "Financiación en la que la entidad financiera prestamista considera exclusivamente los ingresos generados por un único proyecto como fuente de repago y respaldo del crédito, sin considerar los ingresos generales del deudor"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Exclusión de proyectos inmobiliarios",
      "properties": {
        "description": "La financiación especializada de grandes proyectos de infraestructura no incluye proyectos relacionados con la actividad inmobiliaria"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Límite cualitativo de financiación a SPE",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La financiación especializada de grandes proyectos de infraestructura debe otorgarse a un ente, tal como un ente de propósito especial (SPE), creado al solo efecto de financiar o gestionar el proyecto"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Restricción de activos significativos del prestatario",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "El ente prestatario no debe contar con otros activos o actividades significativas, por lo que carece de medios para el repago de la financiación que no sean los ingresos provenientes del proyecto objeto de esa financiación"
      }
    },
    {
      "local_id": "res4",
      "type": "Restriccion",
      "label": "Control sobre ingresos y activos del proyecto",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Los términos contractuales de la financiación deben conceder a la entidad financiera prestamista un alto grado de control sobre los ingresos y/o activos asociados al proyecto"
      }
    },
    {
      "local_id": "res5",
      "type": "Restriccion",
      "label": "Requisitos de etapa preoperativa",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Un proyecto se encuentra en etapa preoperativa si el ente creado para gestionarlo aún no cuenta con un flujo de fondos positivo suficiente como para cubrir las obligaciones contractuales y la deuda de largo plazo no es decreciente"
      }
    }
  ],
