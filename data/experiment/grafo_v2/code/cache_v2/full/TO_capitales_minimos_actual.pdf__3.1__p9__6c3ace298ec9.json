      "label": "Com. A 6470",
      "properties": {
        "codigo": "A-6470",
        "tipo": "A",
        "numero": "6470"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Pago sin dependencia de refinanciación",
      "properties": {
        "descripcion": "El pago de los compromisos de una titulización no deberá depender de la venta o refinanciación de los activos subyacentes, excepto que la cartera subyacente esté lo suficientemente atomizada y su perfil de repago esté suficientemente distribuido.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Cobertura de riesgos de tasa y moneda",
      "properties": {
        "descripcion": "Los riesgos de tasa de interés y de moneda extranjera deberán mitigarse en forma adecuada. Los únicos derivados admisibles son los que se toman para la genuina cobertura de los descalces de tasa y de moneda de los activos y pasivos de la titulización.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Coberturas no derivadas con riesgo único",
      "properties": {
        "descripcion": "Las coberturas que no se realicen a través de derivados sólo serán admisibles si han sido especialmente creadas y usadas para cubrir un riesgo específico individual y no múltiples riesgos simultáneamente, además deberán estar disponibles y haber sido íntegramente fondeadas.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "Subordinados sin preferencia de pago",
      "properties": {
        "descripcion": "Los títulos valores subordinados no deberán tener preferencia de pago sobre los títulos valores exigibles con mayor prelación. La titulización no debe ser estructurada como una cascada inversa.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "o1",
      "type": "Operacion",
      "label": "Refinanciación de activos subyacentes",
      "properties": {
        "tipo": "refinanciación de activos"
      }
    },
    {
      "local_id": "o2",
      "type": "Operacion",
      "label": "Cobertura de riesgos de tasa y moneda",
      "properties": {
        "tipo": "cobertura mediante derivados"
      }
    },
    {
      "local_id": "o3",
      "type": "Operacion",
      "label": "Pago de títulos subordinados",
      "properties": {
        "tipo": "pago de instrumentos de deuda"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Demostrar mitigación de riesgos",
      "properties": {
        "descripcion": "Se deberá demostrar que los riesgos de tasa e interés y de moneda son adecuadamente mitigados a través de información cuantitativa disponible para potenciales inversores.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Información inicial y periódica a inversores",
      "properties": {
        "descripcion": "Se deberá contar con suficiente información a nivel de cada préstamo y suministrar al menos trimestralmente durante la vida de la titulización datos a nivel de préstamos así como informes estandarizados dirigidos al inversor.",
        "tipo": "presentacion_informativa",
        "plazo": "trimestral"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Revisión de cartera por contador independiente",
      "properties": {
        "descripcion": "La cartera inicial deberá ser revisada por un contador público independiente a efectos de generar confianza respecto de la exactitud de lo informado sobre los activos subyacentes.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Explicar y divulgar cobertura a inversores",
      "properties": {
        "descripcion": "El alcance y adecuación de la cobertura deberán ser explicados y divulgados a los inversores durante toda la vida de la titulización.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Definir orden de prelación de pagos",
      "properties": {
        "descripcion": "El orden de prelación en el pago de todos los compromisos deberá estar claramente definido desde el inicio y contar con apropiado respaldo jurídico en lo relativo a su validez legal.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Establecer eventos desencadenantes de pago",
      "properties": {
        "descripcion": "Todos los eventos desencadenantes que puedan afectar el orden de prelación en los pagos deberán estar claramente establecidos en los documentos de oferta. Los reportes deberán contener información que identifique incumplimientos y su capacidad de reversión.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Establecer eventos de amortización anticipada",
      "properties": {
        "descripcion": "Las titulizaciones con períodos rotativos deberán establecer eventos de amortización anticipada y eventos desencadenantes de terminación del período rotativo que incluyan deterioro de calidad crediticia, imposibilidad de adquirir exposiciones nuevas, e insolvencia del originante o fiduciario.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Demostrar obstáculos en legislación aplicable",
      "properties": {
        "descripcion": "En caso de que la legislación aplicable a la titulización no se ajuste a lo previsto, se deberá demostrar la existencia de los obstáculos que así lo impiden y especificar el método del que disponen los inversores para ejercer sus derechos.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Informar condiciones que retrasen transferencia",
      "properties": {
        "descripcion": "Deberá informarse toda condición o evento que pueda retrasar o impedir la transferencia de los activos subyacentes a la titulización así como cualquier factor que pueda afectar el perfeccionamiento oportuno de los reclamos.",
        "tipo": "presentacion_informativa"
      }
    }
  ],
