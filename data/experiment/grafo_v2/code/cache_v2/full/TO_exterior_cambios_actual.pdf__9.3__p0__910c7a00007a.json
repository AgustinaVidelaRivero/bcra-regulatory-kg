      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Registro de certificaciones emitidas",
      "properties": {
        "tipo": "Registro de operación",
        "description": "La entidad deberá dejar registradas las certificaciones de aplicación emitidas para cada una de las operaciones bajo su seguimiento"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Cancelación de capital e intereses",
      "properties": {
        "tipo": "Pago",
        "description": "Cancelación del capital e intereses de financiaciones del exterior liquidadas en el mercado de cambios"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Monto a certificar no debe exceder saldo pendiente",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "saldo liquidado pendiente de aplicación",
        "description": "El monto a certificar por una aplicación a la cancelación del capital sea menor o igual al saldo liquidado pendiente de aplicación que registra la entidad para la operación en cuestión"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Monto certificación de intereses debe ser consistente",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "El monto de la certificación por una aplicación de intereses u otros conceptos admitidos sea consistente con los pactados para la operación y que reflejen condiciones de mercado"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Límite acumulado de aplicaciones al 75%",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "75%",
        "description": "El monto acumulado de aplicaciones de capital e intereses emitidas por las operaciones del exportador no supera el 75% del valor de las nuevas liquidaciones de anticipos y prefinanciaciones del exterior liquidadas por el exportador en el mercado de cambios a partir del 02/09/19"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Exportador debe estar liberado de obligaciones contingentes",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Las certificaciones sólo podrán emitirse en la medida que la entidad tenga constancia que el exportador ha sido liberado de sus obligaciones contingentes con el exterior"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Verificar documentación sobre operación de financiamiento",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad cuente con documentación que le permita verificar: i) el carácter genuino de la operación de financiamiento y su concordancia con el tipo de operación declarado; ii) que el exportador ha cancelado al acreedor con posterioridad al 02/09/19 un monto equivalente; iii) que, en caso de corresponder, por la operación cancelada se ha dado cumplimiento al 'Relevamiento de activos y pasivos externos'"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Solicitar declaración jurada del exportador",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad deberá requerir una declaración jurada del exportador detallando el monto pendiente de la deuda al 31/08/19 y las cancelaciones realizadas"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Obtener certificación de auditor externo",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "En el caso de que el monto adeudado fuera superior a USD 25.000, la entidad deberá contar adicionalmente con una certificación de auditor externo en la cual se deje constancia que lo declarado por el exportador resulta consistente con la información que surge de la revisión de los registros contables, extracontables y toda otra documentación adicional aportada"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Registrar certificaciones emitidas",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "La entidad deberá dejar registradas las certificaciones de aplicación emitidas para cada una de las operaciones bajo su seguimiento"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Verificar ingreso de divisas en cuenta",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Se podrán emitir las certificaciones de aplicación de las divisas a la cancelación del capital y/o intereses que correspondan proporcionalmente al monto liquidado, en la medida que en la cuenta de la entidad se hayan acreditado ingresos de divisas que correspondan a: el efectivo cobro de divisas del embarque, la cesión sin recurso de la operación, o el descuento de la operación en entidad del exterior"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción: operación liquidada parcialmente durante vigencia de Decretos",
      "properties": {
        "descripcion": "Se podrá emitir certificaciones por la porción no liquidada en la medida que se verifique lo previsto en el punto 7.3.11, en caso de tratarse de una operación del exterior liquidada parcialmente durante las respectivas vigencias de los Decretos 492/23, 549/23, 597/23 y 28/23"
      }
    },
    {
      "local_id": "exc2",
      "type": "Excepcion",
      "label": "Excepción: cesión de deuda a otro acreedor externo",
      "properties": {
        "descripcion": "La entidad también podrá emitir certificaciones de aplicación con imputación a una operación bajo su seguimiento, en la medida que el exportador demuestre fehacientemente que las divisas del permiso se utilizaron para cancelar la deuda original que fue cedida a otro acreedor externo por el acreedor originalmente declarado, o una renovación de la operación original con el mismo acreedor"
      }
    },
    {
      "local_id": "exc3",
      "type": "Excepcion",
      "label": "Excepción: conformidad previa del BCRA",
      "properties": {
        "descripcion": "Se cuente con la conformidad previa del BCRA para emitir certificación de aplicación de las divisas a la cancelación del capital e intereses"
      }
    },
    {
      "local_id": "exc4",
      "type": "Excepcion",
      "label": "Excepción: cesión sin recurso de operación",
      "properties": {
        "descripcion": "En los casos de cesión sin recurso de la operación en una entidad del exterior o descuento de la operación en una entidad del exterior, habiendo quedado la entidad local y el exportador liberados de sus obligaciones contingentes, se computará el monto del documento descontado o cedido"
      }
    },
    {
