      "type": "Obligacion",
      "label": "Mantener responsabilidad por clasificación",
      "properties": {
        "descripcion": "La intervención de terceros no releva a la entidad de su responsabilidad por la clasificación finalmente asignada",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Conservar legajos con información requerida",
      "properties": {
        "descripcion": "La entidad tiene obligación de conservar los legajos con toda la información requerida, aun cuando la intervención sea encomendada a terceros",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
