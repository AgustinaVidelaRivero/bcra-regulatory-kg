      "properties": {
        "descripcion": "La revisión de clasificaciones deberá comprender obligatoriamente a los clientes cuyo endeudamiento total supere el 1% de la responsabilidad patrimonial computable o el equivalente al importe de referencia del punto 3.7, y alcanzar como mínimo el 20% de la cartera activa total",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Completar revisión con clientes de menor endeudamiento",
      "properties": {
        "descripcion": "La revisión se completará incorporando a clientes cuyo endeudamiento total sea inferior a los márgenes establecidos, en orden decreciente, hasta alcanzar el 20% de la cartera activa total",
