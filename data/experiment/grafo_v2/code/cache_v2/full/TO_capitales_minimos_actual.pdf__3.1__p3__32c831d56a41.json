  "doc": "TO_capitales_minimos_actual.pdf",
  "location": "Punto 3.1. Tratamiento de las titulizaciones. (parte 4)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Capitales Mínimos",
      "properties": {
        "materia": "Capitales mínimos de entidades financieras",
        "archivo": "TO_capitales_minimos_actual.pdf",
        "version": "4a"
      }
    },
    {
      "local_id": "e1",
      "type": "Restriccion",
      "label": "Límites ponderador titulización máxima preferencia",
      "properties": {
        "descripcion": "Se podrán aplicar los límites para el ponderador de una posición de titulización de máxima preferencia",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e2",
      "type": "Restriccion",
      "label": "Límite máximo exigencia capital originantes",
      "properties": {
        "descripcion": "Se podrá aplicar el límite máximo para la exigencia de capital de entidades financieras originantes, de conformidad con lo previsto en los puntos 3.1.11.3. y 3.1.12.",
        "tipo": "limite_cuantitativo"
      }
    },
    {
      "local_id": "e3",
      "type": "Operacion",
      "label": "Ponderación posiciones superpuestas",
      "properties": {
        "tipo": "cálculo de ponderadores"
      }
    },
    {
      "local_id": "e4",
      "type": "Obligacion",
      "label": "Considerar realidad económica operación",
      "properties": {
        "descripcion": "A efectos de determinar qué posición recibe el tratamiento de máxima preferencia podrá, si así correspondiera por la realidad o finalidad económica de la operación, no considerarse ciertas operaciones o derechos que, en sentido técnico, se adelantan en el orden de prelación",
        "tipo": "otra",
        "plazo": "A efectos de determinar"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Tratamiento tramo máxima preferencia estratificado",
      "properties": {
        "descripcion": "Si un tramo de máxima preferencia fuera a su vez estratificado en tramos o cubierto parcialmente, solamente la nueva parte de máxima preferencia deberá ser tratada como tal",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Determinación facilidad liquidez posición máxima",
      "properties": {
        "descripcion": "Una facilidad de liquidez que respalde un programa ABCP no será la posición de máxima preferencia en el programa, sino que lo será el título valor que cuenta con el respaldo de la liquidez. En cambio, la facilidad será la posición de máxima preferencia si no se pueden transferir los fondos",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Aplicar transparencia look-through titulización tradicional",
      "properties": {
        "descripcion": "La entidad que posea o garantice una posición de máxima preferencia en una titulización tradicional podrá aplicar el tratamiento de transparencia (look-through) para determinar el ponderador de riesgo, siempre que en todo momento se conozca la composición del conjunto subyacente de exposiciones y que no se trate de una retitulización",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "e8",
      "type": "Obligacion",
      "label": "Cumplir requisitos coberturas riesgo crédito",
      "properties": {
        "descripcion": "El empleo de técnicas de coberturas del riesgo de crédito (CRC) para cubrir la posición subyacente se podrá reconocer a efectos de determinar la exigencia de capital correspondiente a titulizaciones sintéticas sólo si se satisfacen ciertas condiciones, incluyendo que las coberturas del riesgo de crédito cumplen los requisitos establecidos en la Sección 5",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e9",
      "type": "Restriccion",
      "label": "Limitación activos garantía técnicas CRC",
      "properties": {
        "descripcion": "Los activos admitidos como garantía se limitan a los especificados en los puntos 5.3.1.2. y 5.3.2.2",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e10",
      "type": "Obligacion",
      "label": "Reconocer activos SPE garantía",
      "properties": {
        "descripcion": "Podrán reconocerse los activos admisibles dados en garantía por 'entes de propósito especial' (SPE)",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "e11",
      "type": "Restriccion",
      "label": "Limitación garantes admisibles CRC",
      "properties": {
        "descripcion": "Los garantes admisibles se limitan a los estipulados en el punto 5.4.1. Los SPE no son garantes admisibles",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e12",
      "type": "Obligacion",
      "label": "Transferencia riesgo crédito terceros",
      "properties": {
        "descripcion": "La entidad transfiere a terceros el riesgo de crédito asociado a las exposiciones subyacentes",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e13",
      "type": "Restriccion",
      "label": "Prohibición cláusulas limitantes protección crediticia",
      "properties": {
        "descripcion": "Los instrumentos utilizados para transferir el riesgo de crédito no contienen cláusulas o condiciones que limiten la cantidad del riesgo de crédito transferido, tales como cláusulas de amortización anticipada, umbrales por debajo de los cuales no se active la protección crediticia, o cláusulas que permitan la extinción de la protección",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e14",
      "type": "Restriccion",
      "label": "Prohibición cláusula alteración exposiciones subyacentes",
      "properties": {
        "descripcion": "Cláusulas que obliguen a la entidad originante a alterar las exposiciones subyacentes para mejorar la calidad crediticia promedio del conjunto de activos subyacente",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e15",
      "type": "Restriccion",
      "label": "Prohibición incremento costo protección crediticia",
      "properties": {
        "descripcion": "Cláusulas que incrementen el costo de la protección crediticia para la entidad en respuesta al deterioro en la calidad crediticia del conjunto de activos subyacente",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e16",
      "type": "Restriccion",
      "label": "Prohibición incremento rendimiento por deterioro crediticio",
      "properties": {
        "descripcion": "Cláusulas que incrementen el rendimiento pagadero a partes distintas de la entidad originante en respuesta al deterioro en la calidad crediticia del conjunto de activos subyacente",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e17",
      "type": "Restriccion",
      "label": "Prohibición aumentos primera pérdida post-inicio",
      "properties": {
        "descripcion": "Cláusulas que contemplen aumentos de la posición a primera pérdida retenida o de las mejoras crediticias provistas por la entidad originante después del inicio de la operación",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Obtener dictamen jurídico exigibilidad contrato",
      "properties": {
        "descripcion": "Se cuente con dictamen jurídico competente que confirme la exigibilidad del contrato",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e19",
      "type": "Restriccion",
      "label": "Prohibición exclusión exposiciones con amortización anticipada",
      "properties": {
        "descripcion": "La entidad financiera originante no podrá excluir las exposiciones objeto de titulización ni podrá reconocer el empleo de técnicas de CRC si la titulización contiene cláusulas de amortización anticipada",
        "tipo": "prohibicion"
      }
    },
