    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Registrar aportes a valor de mercado",
      "properties": {
        "descripcion": "Los aportes en títulos valores públicos nacionales e instrumentos de regulación monetaria del BCRA deberán registrarse a su valor de mercado",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "e7",
      "type": "Obligacion",
      "label": "Registrar aportes al precio de autoridad competente",
      "properties": {
        "descripcion": "Para depósitos y obligaciones de entidades financieras con oferta pública de acciones, los aportes deberán registrarse al precio que fije la autoridad de contralor competente del correspondiente mercado",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "e8",
      "type": "Restriccion",
      "label": "Prohibición de aportes sin cumplimiento de condiciones",
      "properties": {
        "descripcion": "No se admitirán aportes cuando no se verifique el cumplimiento de las condiciones relativas a valor de mercado o precio de autoridad competente",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e9",
      "type": "Obligacion",
      "label": "Registrar aportes de deuda sin negociación a valor contable",
      "properties": {
        "descripcion": "Cuando se trate de depósitos y obligaciones que no cuenten con autorización para negociación en mercados secundarios, los aportes se admitirán a su valor contable conforme a las normas del BCRA",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "e10",
      "type": "Restriccion",
      "label": "Capitalización de deuda no limita derecho de preferencia",
      "properties": {
        "descripcion": "La capitalización de deuda no podrá implicar una limitación o suspensión al derecho de preferencia establecido en el artículo 194 de la Ley General de Sociedades",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e11",
      "type": "Obligacion",
      "label": "Capitalización ad referéndum de aprobación SEFyC o BCRA",
      "properties": {
        "descripcion": "La decisión de capitalización será ad referéndum de su aprobación por parte de la SEFyC o, en su caso, del BCRA, y deberá ser expuesta en nota a los estados contables",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "e12",
      "type": "Restriccion",
      "label": "Deducción de aportes no aprobados de RPC",
      "properties": {
        "descripcion": "Hasta tanto se le haya notificado la aprobación de los aportes, estos se deducirán del respectivo componente de la RPC",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e13",
      "type": "Obligacion",
      "label": "Mantener tratamiento de deuda subordinada capitalizada",
      "properties": {
        "descripcion": "Cuando los aportes capitalicen deuda subordinada o instrumentos representativos de deuda que formen parte de la RPC, se mantendrá el tratamiento que corresponda como si hubieran permanecido como pasivos",
        "tipo": "otra"
      }
    },
