      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Cálculo de nocional ajustado con factor de plazo",
      "properties": {
        "tipo": "calculo_de_exposicion_crediticia",
        "description": "El nocional ajustado a nivel de operación se multiplicará por un factor de plazo (maturity factor), donde el numerador es el horizonte temporal mínimo y M es el plazo residual de la operación i con un mínimo de 10 días hábiles"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Operaciones con margen de variación",
      "properties": {
        "tipo": "gestion_de_margenes",
        "description": "Operaciones de derivados con acuerdos de márgenes diarios, donde el período de riesgo de margen (MPOR) mínimo varía según si se liquidan en forma centralizada o no"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Mínimo 10 días para derivados no centralizados",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "Al menos 10 días hábiles para las operaciones de derivados que no se liquidan en forma centralizada y están sujetas a acuerdos de márgenes diarios",
        "umbral": "10 días hábiles"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Mínimo 5 días para derivados centralizados",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "5 días hábiles para las operaciones de derivados que se liquidan en forma centralizada y están sujetas a acuerdos de márgenes diarios entre el miembro compensador y sus clientes",
        "umbral": "5 días hábiles"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Mínimo 20 días para conjuntos neteo grande",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "20 días hábiles para los conjuntos de neteo –excepto aquellos con una contraparte central– cuyo número de operaciones supere las 5.000 en cualquier momento del trimestre calendario anterior",
        "umbral": "20 días hábiles"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Duplicación de período por disputas",
      "properties": {
        "tipo": "limite_cuantitativo",
        "description": "El doble del período de riesgo de margen para los conjuntos de neteo con disputas pendientes",
        "umbral": "2x MPOR"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción: contraparte central",
      "properties": {
        "descripcion": "Los conjuntos de neteo con una contraparte central están exceptuados del requisito de 20 días hábiles"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Reflejar disputas en período de margen",
      "properties": {
        "tipo": "calculo",
        "description": "Si la entidad ha experimentado más de dos disputas sobre requerimientos de márgenes respecto de algún conjunto de neteo durante los dos trimestres calendario anteriores que se hayan prolongado durante períodos más extensos que el período de riesgo de margen, deberá reflejar este antecedente mediante el uso de un período de riesgo de margen que sea por lo menos el doble",
        "plazo": "dos trimestres calendario posteriores"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Incrementar MPOR por reposición no diaria",
      "properties": {
        "tipo": "calculo",
        "description": "Los mínimos referidos se deberán incrementar cuando la frecuencia de reposición de márgenes no sea diaria: MPOR = mínimo + N - 1, donde N es la cantidad de días entre reposiciones"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Usar parámetros de correlación regulatorios",
      "properties": {
        "tipo": "calculo",
        "description": "Se utilizan parámetros de correlación regulatorios en el cálculo de la EPF de los derivados sobre acciones, créditos y commodities –no se aplican a los derivados de tasa de interés o tipo de cambio– para ponderar los componentes sistemáticos e idiosincráticos"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Aplicar adicional para derivados de tasa",
      "properties": {
        "tipo": "calculo",
        "description": "Para los derivados de tasa de interés, se debe dividir en tres categorías de plazo (bandas temporales o buckets) sobre la base de la fecha de finalización: menos de un año, entre uno y cinco años y más de cinco años. Se permitirá compensación total dentro de cada categoría y compensación parcial entre categorías"
      }
    }
  ],
