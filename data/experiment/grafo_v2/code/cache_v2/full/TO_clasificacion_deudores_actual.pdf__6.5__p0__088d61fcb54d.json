    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Límite de adicionales sin considerar como refinanciación",
      "properties": {
        "descripcion": "Las facilidades adicionales que se otorguen respecto de los márgenes vigentes acordados no se considerarán refinanciaciones si el nuevo apoyo crediticio no supera el 10% del cupo asignado en oportunidad de la última evaluación crediticia del cliente, siempre que sean consistentes con el curso normal de los negocios y exista capacidad para atender el resto de las obligaciones financieras",
        "tipo": "limite_cuantitativo",
        "umbral": "10%"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Prohibición de mejoramiento de clasificación en situación de emergencia",
      "properties": {
        "descripcion": "El tratamiento que se dispense en el marco de la Ley de Emergencia Agropecuaria no podrá implicar mejoramiento de la clasificación asignada al cliente en función de su situación individual, preexistente a la emergencia, ni su aplicación extenderse más allá de la vigencia fijada para ella",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Verificar cumplimiento sin nueva financiación",
      "properties": {
        "descripcion": "A fin de verificar el cumplimiento de las obligaciones sin recurrir a nueva financiación directa o indirecta o a refinanciaciones",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Considerar flujo de fondos proyectado en refinanciaciones agropecuarias",
      "properties": {
        "descripcion": "A los fines de la clasificación, deberá tenerse en cuenta el flujo de fondos proyectado para el momento en que concluya la vigencia de la emergencia declarada",
        "tipo": "calculo",
        "plazo": "hasta conclusión de emergencia"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Considerar situación del grupo de contrapartes conectadas",
      "properties": {
        "descripcion": "En el análisis que se lleve a cabo deberá tenerse en cuenta, de corresponder, la eventual incidencia que en su capacidad de pago pueda tener la situación en la que se encuentran los demás integrantes del grupo de contrapartes conectadas al cual pertenece",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Mantener información consistente y actualizada",
      "properties": {
        "descripcion": "Contar con un adecuado sistema de información que permita conocer en forma permanente la situación financiera y económica de la empresa. La información es consistente y está actualizada",
        "tipo": "otra",
        "frecuencia": "permanente"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Requerir información con periodicidad mínima establecida",
      "properties": {
        "descripcion": "Cuando las financiaciones cuenten con garantías preferidas B, la entidad podrá requerir esa información con la frecuencia que le permita efectuar la evaluación del deudor observando la periodicidad mínima establecida en el punto 6.3",
        "tipo": "presentacion_informativa",
        "frecuencia": "según periodicidad mínima en 6.3"
      }
