      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Aplicar factor 1,5 a exposición contraparte derivados",
      "properties": {
        "descripcion": "Se deberá multiplicar la exposición al riesgo de crédito de contraparte por un factor de 1,5 antes de aplicar el ponderador",
