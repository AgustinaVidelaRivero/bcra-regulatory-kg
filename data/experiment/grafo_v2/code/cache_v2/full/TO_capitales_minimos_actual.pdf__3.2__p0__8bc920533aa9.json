        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Aplicar factor 1,2 a ponderador en cálculos terceros",
      "properties": {
        "descripcion": "Cuando las entidades financieras carecen de información necesaria para realizar un cálculo propio de ponderadores, el ponderador a aplicar será 1,2 veces el ponderador que correspondería aplicar",
