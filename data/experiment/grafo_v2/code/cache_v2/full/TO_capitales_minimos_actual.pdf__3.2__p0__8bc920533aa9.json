        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Tratar posiciones en fondos según enfoques",
      "properties": {
        "descripcion": "Las participaciones en fondos se deberán tratar de acuerdo con uno o más de los siguientes enfoques: de transparencia (LTA), reglamentario (MBA) y residual (FBA)",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Usar enfoque de transparencia cuando se reúnan condiciones",
      "properties": {
        "descripcion": "Este enfoque deberá utilizarse cuando se verifiquen las siguientes condiciones en forma concurrente: recepción de información suficiente con adecuada frecuencia e información verificada por tercero independiente",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
