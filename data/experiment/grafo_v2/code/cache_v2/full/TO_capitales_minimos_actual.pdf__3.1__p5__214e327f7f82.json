      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Cálculo de variable KSA",
      "properties": {
        "tipo": "Cálculo de exigencia de capital promedio de exposiciones subyacentes"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Cálculo de variable W",
      "properties": {
        "tipo": "Cálculo del ratio de exposiciones subyacentes en mora"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Cálculo de variable KA",
      "properties": {
        "tipo": "Cálculo del cargo de capital ajustado por mora"
      }
    },
    {
      "local_id": "op5",
      "type": "Operacion",
      "label": "Cálculo del ponderador de riesgo RW",
      "properties": {
        "tipo": "Determinación del ponderador de riesgo para posiciones de titulización"
      }
    },
    {
      "local_id": "op6",
      "type": "Operacion",
      "label": "Aplicación de cobertura de riesgo crediticio",
      "properties": {
        "tipo": "Aplicación de coberturas del riesgo de crédito a exposiciones subyacentes"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Reconocer sobrecolateralización",
      "properties": {
        "descripcion": "La sobrecolateralización y los fondos integrados en concepto de reserva deberán ser reconocidos como tramos y los activos que conforman estas reservas deberán ser reconocidos como activos subyacentes.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Reconocer parte de reservas con absorción",
      "properties": {
        "descripcion": "Sólo la parte de las reservas que esté sujeta a la absorción de pérdidas y proporcione una mejora crediticia podrá ser reconocida como tramo y activo subyacente.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Exclusión de reservas de ingresos futuros",
      "properties": {
        "descripcion": "Las reservas a integrar con ingresos futuros provenientes de los activos subyacentes –tal como el margen financiero futuro no realizado– no deberán ser incluidos en los cálculos de A y D.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Exclusión de activos sin mejora crediticia",
      "properties": {
        "descripcion": "Los activos que no proporcionen mejoras crediticitas –tales como los respaldos estrictamente referidos a la liquidez, los swaps de moneda o de tasa de interés y las cuentas de efectivo en garantía relativas a estos instrumentos– no deberán ser incluidos en los cálculos de A y D.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Considerar realidad económica de transacción",
      "properties": {
        "descripcion": "Las entidades deberán considerar la realidad o finalidad económica de la transacción y aplicar estas definiciones de manera prudente en función de las características de la estructura.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Reflejar efectos de cobertura de riesgo",
      "properties": {
        "descripcion": "El cálculo deberá reflejar los efectos de cualquier cobertura del riesgo de crédito que corresponda aplicar a las exposiciones subyacentes (individualmente o al conjunto).",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Incluir exposiciones de SPE",
      "properties": {
        "descripcion": "Cuando la estructura involucre a un SPE, se considerará que todas las exposiciones del SPE vinculadas a la titulización integran el conjunto de activos subyacentes. Esto incluye a los activos en los que ha invertido el SPE, las reservas, las cuentas de efectivo en garantía y los derechos frente a las contrapartes por swaps.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ex1",
      "type": "Excepcion",
      "label": "Exclusión de exposiciones de SPE",
      "properties": {
        "descripcion": "A los fines del cálculo de la exigencia de capital, la entidad podrá excluir del conjunto de activos subyacentes a las exposiciones del SPE si puede demostrar que el riesgo no afecta a su posición de titulización o que el riesgo es insignificante."
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Computar fondos en titulizaciones sintéticas",
      "properties": {
        "descripcion": "En el caso de las titulizaciones sintéticas a las que se aporten fondos, se deberán computar para el cálculo del KSA los montos recibidos por los instrumentos con vinculación crediticia u otros pasivos suscriptos por el SPE, cuando dichos importes sirvan como garantía del repago de la exposición titulizada.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ex2",
      "type": "Excepcion",
      "label": "Exclusión de fondos con riesgo insignificante",
      "properties": {
        "descripcion": "Ello a menos que la entidad pueda demostrar que el riesgo de incumplimiento es insignificante."
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Usar monto bruto en cálculo de KSA",
      "properties": {
        "descripcion": "En los casos en los que la entidad haya constituido una provisión específica o tenga un descuento no reembolsable en el precio de compra de su exposición al conjunto de activos subyacentes, el cálculo de KSA deberá efectuarse usando el monto bruto de la exposición –es decir, sin deducir la provisión específica y/o el descuento.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Clasificar exposiciones en mora",
      "properties": {
        "descripcion": "Se consideran en mora a las exposiciones subyacentes cuando se verifiquen atrasos en los pagos de 90 días o más, estén sujetas a procedimientos de quiebra o concurso o en proceso de ejecución o consistan en bienes inmuebles adquiridos en defensa del crédito o se trate de exposiciones que se encuentren en situación de incumplimiento en los términos definidos en los contratos de titulización.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Ajustar KA para retitulizaciones mixtas",
      "properties": {
        "descripcion": "En caso de retitulizaciones cuya cartera subyacente consista en tramos de titulización y en otros activos, se deberá calcular por separado el KA correspondiente a cada subconjunto aplicando W por separado, y KA para la exposición será equivalente al promedio ponderado por la exposición nominal de los KA correspondientes a cada subconjunto.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob10",
      "type": "Obligacion",
      "label": "Ajustar KA por desconocimiento hasta 5%",
      "properties": {
        "descripcion": "En caso de que se desconozca la situación de cumplimiento correspondiente al 5% o menos de las exposiciones subyacentes, se deberá ajustar el cálculo de KA de conformidad con la fórmula indicada.",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "res3",
      "type": "Restriccion",
      "label": "Ponderación al 1250% por desconocimiento",
      "properties": {
        "descripcion": "Si la entidad no conociera la situación de cumplimiento para más del 5% de la posición de titulización, ésta deberá ponderarse al 1250%.",
        "tipo": "limite_cuantitativo",
        "umbral": "1250%"
      }
    },
    {
      "local_id": "ob11",
      "type": "Obligacion",
      "label": "Calcular RW según condiciones",
      "properties": {
        "descripcion": "El ponderador de riesgo RW a asignar a una posición de titulización se calculará conforme a: Si D ≤ KA, RW = 1250%. Si KA ≤ A, RW = 12,5 × K_SSFA(KA). Si KA > A y A > D, RW será un promedio ponderado entre 1250% y 12,5 × K_SSFA(KA).",
        "tipo": "calculo"
      }
    },
    {
      "local_id": "ob12",
      "type": "Obligacion",
      "label": "Inferir ponderador para coberturas",
      "properties": {
        "descripcion": "El ponderador para coberturas del riesgo de mercado, tales como swaps de moneda o de tasa de interés, se inferirá a partir de una posición de titulización de igual prelación con los swaps o, si tal posición no existiera, a partir del tramo subordinado más próximo.",
        "tipo": "calculo"
      }
    }
  ],
