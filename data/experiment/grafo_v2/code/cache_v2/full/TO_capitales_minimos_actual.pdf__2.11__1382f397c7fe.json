        "plazo": "continuo"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Encuadrar contrapartes en grados",
      "properties": {
        "tipo": "asignacion",
        "description": "Las contrapartes se deberán encuadrar en alguno de los siguientes grados: A, B o C"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Asignar grados B o C por incumplimiento",
      "properties": {
        "tipo": "asignacion",
        "description": "Las exposiciones deberán asignarse a los grados B o C, si se verifica que la entidad prestataria no observa los requisitos regulatorios mínimos o no facilita la información requerida, o si en la debida diligencia no cumple con requisitos del grado A"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Asignar grado C por incumplimiento regulatorio",
      "properties": {
        "tipo": "asignacion",
        "description": "Las exposiciones deberán asignarse al grado C cuando se verifique que la entidad financiera prestataria no cumple con requisitos regulatorios mínimos o no facilita información"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Asignar ponderadores grupo 2",
      "properties": {
        "tipo": "asignacion",
        "description": "Las entidades financieras del grupo 2 deberán asignar a las exposiciones a sus contrapartes los ponderadores de riesgo previstos en el punto 2.12"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Grado A: requisitos mínimos obligatorios",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Para asignación de grado A, la entidad financiera prestataria debe evidenciar adecuada capacidad de cumplimiento en tiempo y forma con compromisos financieros durante la vida de las exposiciones, independientemente de coyuntura económica y condiciones de negocios"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Grado A: cumplimiento de requisitos regulatorios",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "La entidad financiera prestataria debe observar los requisitos regulatorios mínimos sujetos a divulgación, incluyendo margen contracíclico y de conservación de capital, o equivalentes para entidades del exterior"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Grado B: riesgo de crédito sustancial",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Grado B: la entidad financiera prestataria evidencia riesgo de crédito sustancial y su capacidad de pago se encuentra supeditada a coyuntura económica o condiciones de negocio favorables o perspectiva estable"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Grado B: requisitos regulatorios mínimos",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Grado B: la entidad debe observar requisitos regulatorios mínimos sujetos a divulgación sin considerar margen contracíclico y conservación de capital, o equivalentes para entidades del exterior"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Grado C: incumplimiento material",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Grado C: la entidad prestataria evidencia riesgo de incumplimiento material y es probable que no sea capaz de cumplir obligaciones ante coyuntura económica o condiciones desfavorables"
      }
    },
    {
      "local_id": "rest6",
      "type": "Restriccion",
      "label": "Grado C: no cumple requisitos mínimos",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Grado C: la entidad no cumple requisitos regulatorios mínimos o no facilita información requerida"
      }
    },
    {
      "local_id": "rest7",
      "type": "Restriccion",
