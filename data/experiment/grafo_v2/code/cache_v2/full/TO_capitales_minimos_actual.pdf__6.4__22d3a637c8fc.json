    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Cálculo de posición abierta neta",
      "properties": {
        "tipo": "cálculo de exposición cambiaria",
        "description": "Cálculo de la posición abierta neta en cada moneda como suma de: posición neta al contado, posición neta a plazo, garantías otorgadas, ingresos y egresos futuros netos, y equivalente delta neto de opciones sobre divisas"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Conversión de posiciones a pesos",
      "properties": {
        "tipo": "conversión cambiaria",
        "description": "Conversión del importe nominal o valor actual neto de la posición neta en cada moneda y en oro a pesos al tipo de cambio de contado"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Valoración de posiciones a término",
      "properties": {
        "tipo": "valoración de instrumentos",
        "description": "Valoración de posiciones a término en moneda extranjera y en oro a los tipos de cambio de contado corrientes en el mercado o utilizando valor actual neto"
      }
    },
    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Calcular exigencia capital tipo de cambio",
      "properties": {
        "tipo": "calculo",
        "description": "El cálculo de la exigencia de capital por riesgo de tipo de cambio requiere cuantificar la exposición en cada moneda y luego estimar los riesgos inherentes a la combinación de posiciones compradas y vendidas en diferentes monedas",
        "plazo": "conforme al procedimiento establecido"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Incluir intereses devengados en posición",
      "properties": {
        "tipo": "calculo",
        "description": "Los intereses y otros ingresos devengados a cobrar y a pagar se incluirán en la posición, ya sea que correspondan a instrumentos de la cartera de negociación o de inversión"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Aplicar decisión consistente de flujos futuros",
      "properties": {
        "tipo": "otra",
        "description": "La decisión de incluir ingresos y egresos futuros se deberá adoptar de modo consistente, ya que no se permitirá seleccionar sólo los flujos futuros esperados que reduzcan la posición"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Proveer evidencia vigilancia límites",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Las entidades deberán proveer evidencia de que permanentemente vigilan la correspondencia entre los límites y las posiciones reales"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Sumar posiciones no significativas sucursales",
      "properties": {
        "tipo": "calculo",
        "description": "A los efectos de la consolidación, las posiciones no significativas de las sucursales y subsidiarias en el exterior podrán sustituirse por el límite que la entidad haya fijado internamente para cada moneda; en estos casos, los límites se deberán sumar, sin importar su signo, a la posición abierta neta"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Capital mínimo riesgo cambio 8%",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "8%",
        "description": "La exigencia de capital será el 8% de la posición neta total"
      }
    },
    {
      "local_id": "res2",
      "type": "Restriccion",
      "label": "Exclusión posiciones deducibles patrimonio",
      "properties": {
        "tipo": "limite_cualitativo",
        "description": "Para determinar el importe de la posición abierta neta en cada moneda extranjera las entidades podrán excluir las posiciones comprendidas en las partidas deducibles para determinar la responsabilidad patrimonial computable"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción inclusión flujos futuros",
      "properties": {
        "description": "Las entidades podrán excluir los ingresos y egresos futuros esperados pero aún no devengados salvo que las cantidades sean ciertas y las hayan cubierto"
      }
    }
  ],
