    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Designar Directivo Responsable de Protección",
      "properties": {
        "descripcion": "Las entidades financieras, las empresas no financieras emisoras de tarjetas de crédito y/o compra y los otros proveedores no financieros de crédito deberán designar a un miembro del Directorio o autoridad equivalente como 'Directivo Responsable de Protección de los Usuarios de Servicios Financieros' ante el BCRA.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Vigilar adecuado funcionamiento protección usuarios",
      "properties": {
        "descripcion": "Vigilar el adecuado funcionamiento de los procesos relacionados con la protección de los usuarios de los servicios financieros según las disposiciones establecidas en estas normas.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Contribuir a mejora procesos protección",
      "properties": {
        "descripcion": "Contribuir a la mejora de los mencionados procesos, los controles relacionados y el esquema de gestión de riesgo asociado con la protección de los usuarios de servicios financieros.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Proponer funcionarios responsables atención usuario",
      "properties": {
        "descripcion": "Proponer al Directorio o autoridad equivalente a los funcionarios para el desempeño de la función de Responsable de atención al usuario de servicios financieros.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Participar definición aprobación nuevos productos",
      "properties": {
        "descripcion": "Participar en el proceso de definición y aprobación de nuevos productos y servicios y en la modificación de los existentes, vigilando que se hayan considerado adecuadamente los derechos de los usuarios.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Verificar funcionamiento análisis reclamos",
      "properties": {
        "descripcion": "Verificar el adecuado funcionamiento del proceso de análisis de las causas generadoras de los eventos de reclamos.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Evaluar reportes Responsable atención usuario",
      "properties": {
        "descripcion": "Evaluar los reportes trimestrales que genere el Responsable de atención al usuario de servicios financieros, aprobar las propuestas correctivas y efectuar el seguimiento de su implementación.",
        "tipo": "presentacion_informativa",
        "plazo": "trimestral"
      }
    },
    {
      "local_id": "ob8",
      "type": "Obligacion",
      "label": "Evaluar informes auditoría sobre protección",
      "properties": {
        "descripcion": "Evaluar los informes emitidos por la auditoría interna, la auditoría externa y las observaciones comunicadas por la SEFyC con relación al proceso de protección de usuarios, y velar por la ejecución de acciones.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob9",
      "type": "Obligacion",
      "label": "Velar cumplimiento requerimientos informativos BCRA",
      "properties": {
        "descripcion": "Velar por el cumplimiento de los requerimientos informativos del BCRA que son materia de su incumbencia.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob10",
      "type": "Obligacion",
      "label": "Elevar reporte trimestral al Directorio",
      "properties": {
        "descripcion": "Elevar al Directorio o autoridad equivalente, como mínimo trimestralmente, un reporte de análisis con las acciones realizadas y el resultado de la evaluación sobre el informe del Responsable de atención al usuario.",
        "tipo": "presentacion_informativa",
        "plazo": "trimestral"
      }
    },
    {
      "local_id": "ob11",
      "type": "Obligacion",
      "label": "Opción conformación Comité de Protección",
      "properties": {
        "descripcion": "Los sujetos obligados podrán optar por la conformación de un Comité integrado por al menos un miembro del Directorio y por los responsables de las áreas de cumplimiento normativo, gestión de riesgo operativo y asuntos legales, teniendo las mismas funciones del Directivo Responsable.",
        "tipo": "asignacion"
      }
    },
    {
      "local_id": "ob12",
      "type": "Obligacion",
      "label": "Directorio evaluar reportes responsable atención",
      "properties": {
        "descripcion": "Para sujetos obligados no alcanzados por la obligación de designar Directivo Responsable, el Directorio o autoridad equivalente deberá evaluar los reportes que eleve el responsable de atención al usuario de servicios financieros.",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "ob13",
      "type": "Obligacion",
      "label": "Auditoría interna evalúe servicio atención usuario",
      "properties": {
        "descripcion": "Como mínimo una vez al año, el Servicio de Atención al Usuario de Servicios Financieros y los procesos implementados deberán ser objeto de evaluación integral y reporte escrito por parte de la auditoría interna.",
        "tipo": "presentacion_informativa",
        "plazo": "anual"
      }
    },
    {
      "local_id": "ob14",
      "type": "Obligacion",
      "label": "Verificar proporcionar copia formularios contratos",
      "properties": {
        "descripcion": "La auditoría interna debe verificar que se proporciona a los usuarios de servicios financieros copia de los formularios que firman y ejemplares de los contratos formalizados, en tiempo y forma previstos.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob15",
      "type": "Obligacion",
      "label": "Notificar comisiones cargos en contrato",
      "properties": {
        "descripcion": "Se debe notificar en el cuerpo del contrato cuáles son los conceptos sobre los cuales se aplicarán comisiones y cargos, los respectivos importes o porcentajes, así como derechos y obligaciones emergentes de la contratación, incluida la facultad de revocación.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob16",
      "type": "Obligacion",
      "label": "Notificar condiciones modificables en contrato",
      "properties": {
        "descripcion": "Se debe notificar en el contrato a los usuarios sobre las condiciones que pueden ser objeto de modificación, así como de la facultad de rescisión tanto del usuario como del sujeto obligado.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob17",
      "type": "Obligacion",
      "label": "Ajustar comisiones cargos normas vigentes",
      "properties": {
        "descripcion": "Las comisiones y cargos aplicados a los usuarios de servicios financieros se ajusten a las disposiciones del punto 2.3.2.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob18",
      "type": "Obligacion",
      "label": "Administrar registros consultas reclamos",
      "properties": {
        "descripcion": "Los Registros Centralizados de Consultas y Reclamos (RCCR), de Reintegros de Importes (RRI) y de Denuncias ante Instancias Judiciales/Administrativas de Defensa del Consumidor (RDJA) sean adecuadamente administrados y actualizados.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob19",
      "type": "Obligacion",
      "label": "Informar estado seguimiento presentación usuario",
      "properties": {
        "descripcion": "Se le deberá informar al usuario de servicios financieros el estado del trámite cada vez que lo requiera, para efectuar el seguimiento de su presentación.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob20",
      "type": "Obligacion",
      "label": "Extender constancia consulta reclamo usuario",
      "properties": {
        "descripcion": "El sujeto obligado deberá, ante la solicitud del usuario de servicios financieros, extender una constancia con la identificación de su consulta o reclamo y el estado actualizado de su trámite.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "der1",
      "type": "Restriccion",
      "label": "Derecho usuario seguimiento presentación",
      "properties": {
        "descripcion": "El usuario de servicios financieros tiene derecho a efectuar el seguimiento de su presentación.",
        "tipo": "limite_cualitativo"
      }
    }
  ],
