  "location": "Punto 2.3. Recaudos mínimos de la relación de consumo. (parte 3)",
  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Protección de Usuarios de Servicios Financieros",
      "properties": {
        "materia": "Protección de los usuarios de servicios financieros",
        "archivo": "TO_proteccion_usuarios_servicios_financieros_actual.pdf",
        "version": "13a"
      }
    },
    {
      "local_id": "e1",
      "type": "Restriccion",
      "label": "Prohibición de comisiones no solicitadas",
      "properties": {
        "descripcion": "En ningún caso podrán aplicarse comisiones y/o cargos al usuario por servicios financieros que no hayan sido solicitados, pactados y/o autorizados por él y, aun cuando habiendo sido solicitados, pactados y/o autorizados por éste e informados por el sujeto obligado al usuario, no se hayan prestado de manera efectiva.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e2",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por operaciones en ventanilla",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por operaciones efectuadas por ventanilla por los usuarios de servicios financieros que sean personas humanas. Esta limitación también alcanza, en las casas operativas distintas a aquella en la cual esté abierta la cuenta, a los movimientos de fondos en efectivo en pesos (depósitos y/o extracciones) y a la recepción de depósitos de cheques efectuados por cuenta propia y/o de terceros.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e3",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por depósitos de efectivo en pesos a MiPyMEs",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por depósitos de efectivo en pesos en cuentas cuyos titulares sean personas humanas o jurídicas que revistan el carácter de micro, pequeñas o medianas empresas (Mipyme).",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e4",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por contratación de seguros",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por contratación y/o administración de seguros.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e5",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por resúmenes de cuenta",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por generación de resúmenes de cuenta y envío de resúmenes de cuenta virtual (esos servicios deben estar incluidos en la comisión por mantenimiento de cuenta).",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e6",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por evaluación de financiaciones",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por evaluación, otorgamiento y/o administración de financiaciones.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e7",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por gastos de tasación y escribanía",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por gastos de tasación, notariales o de escribanía que se originen en ocasión del otorgamiento o cancelación de financiaciones –tales como de constitución de prenda o hipoteca–.",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "e8",
      "type": "Operacion",
      "label": "Aplicación de comisiones y cargos",
      "properties": {
        "tipo": "cobro de comisiones y cargos por servicios financieros"
      }
    },
    {
      "local_id": "e9",
      "type": "Operacion",
      "label": "Operaciones por ventanilla",
      "properties": {
        "tipo": "operación financiera realizada por ventanilla"
      }
    },
    {
      "local_id": "e10",
      "type": "Operacion",
      "label": "Depósitos de efectivo en pesos",
      "properties": {
        "tipo": "depósito de efectivo en pesos en cuentas"
      }
    },
    {
      "local_id": "e11",
      "type": "Operacion",
      "label": "Contratación de seguros",
      "properties": {
        "tipo": "contratación y/o administración de seguros"
      }
    },
    {
      "local_id": "e12",
      "type": "Operacion",
      "label": "Envío de resúmenes de cuenta",
      "properties": {
        "tipo": "generación y envío de resúmenes de cuenta"
      }
    },
    {
      "local_id": "e13",
      "type": "Operacion",
      "label": "Evaluación de financiaciones",
      "properties": {
        "tipo": "evaluación, otorgamiento y/o administración de financiaciones"
      }
    },
    {
      "local_id": "e14",
      "type": "Restriccion",
      "label": "Límite de CFT en ausencia de tasa pactada",
      "properties": {
        "descripcion": "La falta de inclusión en los documentos de la tasa de interés y/o del costo financiero total determinará que el sujeto obligado podrá aplicar al usuario, como máximo CFT, la tasa promedio que surja de la encuesta de tasas de interés de depósitos a plazo fijo de 30 a 59 días.",
        "tipo": "limite_cuantitativo",
        "umbral": "tasa promedio de encuesta de tasas de depósitos a plazo fijo 30-59 días"
      }
    },
    {
      "local_id": "e15",
      "type": "Operacion",
      "label": "Cálculo de costo financiero total",
      "properties": {
        "tipo": "cálculo del costo financiero total para operaciones de financiación"
      }
    },
    {
      "local_id": "e16",
      "type": "Obligacion",
      "label": "Inclusión de tasa de interés y CFT en documentos",
      "properties": {
        "descripcion": "Para las operaciones de financiación debe aplicarse lo dispuesto en el punto 3.2. del TO sobre Tasas de Interés en las Operaciones de Crédito. Debe incluirse en los documentos la tasa de interés y/o del costo financiero total.",
        "tipo": "presentacion_informativa",
        "plazo": "al momento de la contratación"
      }
    },
    {
      "local_id": "e17",
      "type": "Obligacion",
      "label": "Especificación de condiciones modificables en contrato",
      "properties": {
        "descripcion": "En el contrato deberán encontrarse taxativamente especificadas las condiciones que pueden ser objeto de modificación, así como los parámetros o criterios objetivos para su concreción.",
        "tipo": "otra"
      }
    },
    {
      "local_id": "e18",
      "type": "Obligacion",
      "label": "Obtención de consentimiento para nuevas comisiones",
      "properties": {
        "descripcion": "En el caso de que el sujeto obligado pretenda incorporar nuevos conceptos en calidad de comisiones y/o cargos que no hubiesen sido previstos en el contrato o reducir prestaciones contempladas en él, deberá previamente obtener el consentimiento expreso del usuario de servicios financieros.",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "e19",
      "type": "Obligacion",
      "label": "Notificación anticipada de cambios de condiciones",
      "properties": {
        "descripcion": "El usuario de servicios financieros debe ser notificado de las modificaciones que aplicará el sujeto obligado con una antelación mínima de sesenta (60) días corridos a su entrada en vigencia.",
        "tipo": "comunicacion_a_cliente",
        "plazo": "60 días corridos antes de la entrada en vigencia"
      }
    },
    {
      "local_id": "e20",
      "type": "Restriccion",
      "label": "Restricción en modificación de objeto del contrato",
      "properties": {
        "descripcion": "La modificación no debe alterar el objeto del contrato ni importar un desmedro respecto de los productos o servicios contratados.",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "e21",
      "type": "Restriccion",
      "label": "Gratuidad de notificaciones de cambios",
      "properties": {
        "descripcion": "Las notificaciones por cambios de condiciones pactadas (nuevos conceptos y/o valores o reducción de prestaciones del servicio) serán en todos los casos gratuitas para el usuario de servicios financieros.",
        "tipo": "prohibicion"
      }
    },
