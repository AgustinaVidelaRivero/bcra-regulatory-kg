        "numero": "6458"
      }
    },
    {
      "local_id": "op1",
      "type": "Operacion",
      "label": "Presentación de consultas o reclamos",
      "properties": {
        "tipo": "Presentación de consultas o reclamos por usuario de servicios financieros",
        "description": "Las consultas y/o reclamos que deben ser asentados en el RCCR son aquellos que requieren del análisis de documentación y/o pedido de información a otros sujetos u organismos, o aquellos que representan queja por presunto incumplimiento, prestación defectuosa o falta de prestación de un producto o servicio"
      }
    },
    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Registrar consultas y reclamos en RCCR",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Deberán consignarse como mínimo: número de consulta o reclamo; fecha, canal y motivo de la presentación; tipo y número de documento de identidad del presentante; casa receptora y afectada/s; otra/s entidad/es involucrada/s y el estado del trámite, el cual deberá mantenerse actualizado",
        "plazo": "Actualización continua del estado del trámite"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Otorgar número de consulta o reclamo",
      "properties": {
        "tipo": "comunicacion_a_cliente",
        "description": "Cuando la consulta o reclamo sea iniciada/o por línea telefónica o página de Internet, el número de consulta o reclamo deberá ser provisto en el acto al presentante, respetando la correlatividad",
        "plazo": "En el acto de presentación"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Notificar número de consulta o reclamo",
      "properties": {
        "tipo": "comunicacion_a_cliente",
        "description": "Para los casos en que el presentante no reciba automáticamente el número de su consulta o reclamo, se deberá establecer un procedimiento que prevea la notificación del número o código que le sea asignado dentro de los tres (3) días hábiles de iniciada la presentación",
        "plazo": "Tres (3) días hábiles"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Conservar información en base de datos",
      "properties": {
        "tipo": "otra",
        "description": "La información incorporada a esta base de datos deberá conservarse por el término de diez (10) años",
        "plazo": "Diez (10) años"
      }
    },
    {
      "local_id": "op2",
      "type": "Operacion",
      "label": "Registro de Reintegros de Importes",
      "properties": {
        "tipo": "Asentamiento de montos reintegrados a usuarios en RRI",
        "description": "En este registro se deberán asentar los montos reintegrados a los usuarios, identificando en cada caso al usuario afectado, la causal generadora del evento, los productos y casas involucradas"
      }
    },
    {
      "local_id": "op3",
      "type": "Operacion",
      "label": "Registro de Denuncias ante Instancias Judiciales",
      "properties": {
        "tipo": "Asentamiento de denuncias ante instancias judiciales y administrativas",
        "description": "En este registro se asentarán todas las intervenciones originadas en denuncias efectuadas ante instancias judiciales y/o administrativas de defensa del consumidor, identificando al usuario afectado, importe involucrado, causal generadora del evento, productos y casas involucradas"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Habilitar múltiples canales de presentación",
      "properties": {
        "tipo": "otra",
        "description": "Las presentaciones de los usuarios de servicios financieros deberán poder realizarse por teléfono, Internet, por escrito, fax, correo postal y electrónico (e-mail), etc. y los datos para su direccionamiento deberán encontrarse disponibles"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Brindar atención personalizada",
      "properties": {
        "tipo": "otra",
        "description": "Se deberá contemplar un procedimiento de atención personalizado para aquellos clientes que lo soliciten"
      }
    },
    {
      "local_id": "res1",
      "type": "Restriccion",
      "label": "Plazo máximo de resolución de consultas",
      "properties": {
        "tipo": "limite_cuantitativo",
        "umbral": "10 días hábiles",
        "description": "Toda consulta o reclamo deberá ser definitivamente resuelta/o dentro del plazo máximo de diez (10) días hábiles, excepto para la situación prevista en el punto 2.3.5. o cuando reglamentariamente se hayan otorgado mayores plazos o cuando medien causas ajenas debidamente justificadas"
      }
    },
    {
      "local_id": "exc1",
      "type": "Excepcion",
      "label": "Excepción por causas ajenas al sujeto",
      "properties": {
        "descripcion": "No aplica el plazo máximo de 10 días hábiles cuando medien causas ajenas al sujeto obligado debidamente justificadas"
      }
    },
    {
      "local_id": "ob7",
      "type": "Obligacion",
      "label": "Notificar resolución por escrito",
      "properties": {
        "tipo": "comunicacion_a_cliente",
        "description": "La resolución de la presentación deberá ser notificada por escrito al usuario de servicios financieros, admitiéndose la utilización del correo electrónico cuando el presentante haya aceptado dicho canal de respuesta"
      }
    },
    {
      "local_id": "op4",
      "type": "Operacion",
      "label": "Números correlativos de presentaciones",
      "properties": {
        "tipo": "Asignación de números correlativos a consultas y reclamos",
        "description": "Los números asignados a las presentaciones deberán ser correlativos y la base de datos sólo podrá ser modificada para la incorporación de nuevas consultas o reclamos, o para el agregado de nueva información sobre el estado actualizado de los trámites"
      }
    }
  ],
