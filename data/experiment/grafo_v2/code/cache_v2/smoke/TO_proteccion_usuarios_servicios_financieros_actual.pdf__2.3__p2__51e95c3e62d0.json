    {
      "local_id": "ob1",
      "type": "Obligacion",
      "label": "Especificar condiciones modificables en contrato",
      "properties": {
        "descripcion": "En el contrato deberán encontrarse taxativamente especificadas las condiciones que pueden ser objeto de modificación, así como los parámetros o criterios objetivos para su concreción",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob2",
      "type": "Obligacion",
      "label": "Justificar incrementos de tasas y comisiones",
      "properties": {
        "descripcion": "Los incrementos en las tasas de interés, comisiones y/o cargos deben ser justificados desde el punto de vista técnico y económico",
        "tipo": "otra"
      }
    },
    {
      "local_id": "ob3",
      "type": "Obligacion",
      "label": "Obtener consentimiento expreso del usuario",
      "properties": {
        "descripcion": "El sujeto obligado deberá obtener el consentimiento expreso del usuario de servicios financieros para incorporar nuevos conceptos en calidad de comisiones y/o cargos o reducir prestaciones",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob4",
      "type": "Obligacion",
      "label": "Notificar cambios con antelación mínima",
      "properties": {
        "descripcion": "El usuario debe ser notificado de las modificaciones con una antelación mínima de sesenta (60) días corridos a su entrada en vigencia",
        "tipo": "comunicacion_a_cliente",
        "plazo": "60 días"
      }
    },
    {
      "local_id": "ob5",
      "type": "Obligacion",
      "label": "Notificación debe ser gratuita y separada",
      "properties": {
        "descripcion": "Las notificaciones por cambios de condiciones serán gratuitas y deberán efectuarse mediante documento escrito dirigido al domicilio real o por vía electrónica, en forma separada de cualquier otra información",
        "tipo": "comunicacion_a_cliente"
      }
    },
    {
      "local_id": "ob6",
      "type": "Obligacion",
      "label": "Incluir leyendas en notificaciones de cambios",
      "properties": {
        "descripcion": "En el cuerpo de las notificaciones debe incluirse la leyenda: 'Usted podrá optar por rescindir el contrato en cualquier momento antes de la entrada en vigencia del cambio y sin cargo alguno'",
        "tipo": "comunicacion_a_cliente"
      }
