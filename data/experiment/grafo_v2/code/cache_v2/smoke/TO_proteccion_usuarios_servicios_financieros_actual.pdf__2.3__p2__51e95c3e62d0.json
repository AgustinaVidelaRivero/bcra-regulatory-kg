  "entities": [
    {
      "local_id": "to",
      "type": "TextoOrdenado",
      "label": "Protección de usuarios de servicios financieros",
      "properties": {
        "materia": "Protección de usuarios",
        "archivo": "TO_proteccion_usuarios_servicios_financieros_actual.pdf",
        "version": "13a"
      }
    },
    {
      "local_id": "com1",
      "type": "Comunicacion",
      "label": "Com. A 8203",
      "properties": {
        "codigo": "A-8203",
        "tipo": "A",
        "numero": "8203"
      }
    },
    {
      "local_id": "r1",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por servicios no solicitados",
      "properties": {
        "descripcion": "No se podrán aplicar comisiones y/o cargos al usuario por servicios financieros que no hayan sido solicitados, pactados y/o autorizados por él",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r2",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por servicios no prestados",
      "properties": {
        "descripcion": "No se podrán aplicar comisiones y/o cargos aun cuando habiendo sido solicitados, pactados y/o autorizados e informados por el sujeto obligado al usuario, no se hayan prestado de manera efectiva",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r3",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por operaciones de ventanilla",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por operaciones efectuadas por ventanilla por los usuarios de servicios financieros que sean personas humanas",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r4",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por depósitos de efectivo MiPyMEs",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por depósitos de efectivo en pesos en cuentas cuyos titulares sean MiPyMEs",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r5",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por contratación de seguros",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por contratación y/o administración de seguros",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r6",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por resúmenes de cuenta",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por generación de resúmenes de cuenta y envío de resúmenes de cuenta virtual (esos servicios deben estar incluidos en la comisión por mantenimiento de cuenta)",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r7",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por evaluación de financiaciones",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por evaluación, otorgamiento y/o administración de financiaciones",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r8",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por gastos de tasación y notariales",
      "properties": {
        "descripcion": "No podrán aplicarse comisiones ni cargos por gastos de tasación, notariales o de escribanía que se originen en ocasión del otorgamiento o cancelación de financiaciones",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r9",
      "type": "Restriccion",
      "label": "Límite en tasa de interés y CFT por falta de inclusión",
      "properties": {
        "descripcion": "La falta de inclusión en los documentos de la tasa de interés y/o del costo financiero total determinará que el sujeto obligado podrá aplicar al usuario, como máximo CFT, la tasa promedio que surja de la encuesta de tasas de interés de depósitos a plazo fijo de 30 a 59 días",
        "tipo": "limite_cuantitativo",
        "umbral": "tasa promedio encuesta"
      }
    },
    {
      "local_id": "r10",
      "type": "Restriccion",
      "label": "Restricción de cambios en condiciones pactadas",
      "properties": {
        "descripcion": "A fin de modificar las condiciones pactadas debe darse la totalidad de las siguientes condiciones: especificación taxativa en el contrato, justificación técnica y económica, no alterar el objeto del contrato, obtener consentimiento expreso",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "r11",
      "type": "Restriccion",
      "label": "Prohibición de nuevas comisiones sin consentimiento",
      "properties": {
        "descripcion": "En el caso de que el sujeto obligado pretenda incorporar nuevos conceptos en calidad de comisiones y/o cargos que no hubiesen sido previstos en el contrato o reducir prestaciones contempladas en él, deberá previamente obtener el consentimiento expreso del usuario",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "r12",
      "type": "Restriccion",
      "label": "Límite de plazo para notificación de cambios",
      "properties": {
        "descripcion": "El usuario debe ser notificado de las modificaciones que aplicará el sujeto obligado con una antelación mínima de sesenta (60) días corridos a su entrada en vigencia",
        "tipo": "limite_cuantitativo",
        "umbral": "60 días"
      }
    },
    {
      "local_id": "r13",
      "type": "Restriccion",
      "label": "Prohibición de comisiones por notificación de cambios",
      "properties": {
        "descripcion": "Las notificaciones por cambios de condiciones pactadas serán en todos los casos gratuitas para el usuario de servicios financieros",
        "tipo": "prohibicion"
      }
    },
    {
