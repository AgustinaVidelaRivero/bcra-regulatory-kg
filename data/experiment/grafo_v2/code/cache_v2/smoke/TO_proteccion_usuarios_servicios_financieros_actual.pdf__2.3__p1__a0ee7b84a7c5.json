    {
      "local_id": "obl1",
      "type": "Obligacion",
      "label": "Proporcionar ejemplar de contrato firmado",
      "properties": {
        "descripcion": "Los sujetos obligados deberán proporcionar o poner a disposición del usuario de servicios financieros un ejemplar del contrato con la firma autorizada del sujeto obligado, dentro de los diez (10) días hábiles de realizada la contratación o de la disponibilidad efectiva del producto o servicio, lo que suceda último",
        "tipo": "presentacion_informativa",
        "plazo": "10 días hábiles"
      }
    },
    {
      "local_id": "obl2",
      "type": "Obligacion",
      "label": "Utilizar documentación habitual de contratos",
      "properties": {
        "descripcion": "Los sujetos obligados deberán utilizar la documentación habitual que emplean en los contratos presenciales",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl3",
      "type": "Obligacion",
      "label": "Otorgar medios técnicos para detectar errores",
      "properties": {
        "descripcion": "Cuando la contratación se efectúe por medios electrónicos, los sujetos obligados deberán otorgar al usuario los medios técnicos necesarios para que, antes de la contratación, pueda detectar y subsanar eventuales errores u omisiones en la carga de los datos",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl4",
      "type": "Obligacion",
      "label": "Proporcionar mecanismo de confirmación expresa",
      "properties": {
        "descripcion": "Los sujetos obligados deberán proporcionarle al usuario un mecanismo de confirmación expresa de la decisión de efectuar la contratación, de forma tal que su silencio no sea considerado como consentimiento",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl5",
      "type": "Obligacion",
      "label": "Asegurar lectura inalterable de términos",
      "properties": {
        "descripcion": "Los sujetos obligados deberán asegurar que los términos de la contratación puedan ser leídos, descargados y guardados por el usuario de manera inalterable",
        "tipo": "otra"
      }
    },
    {
      "local_id": "obl6",
      "type": "Obligacion",
      "label": "Entregar resumen informativo del contrato",
      "properties": {
        "descripcion": "Los sujetos obligados deberán entregar a los usuarios antes de su formalización un resumen del contrato en el que se sinteticen, en un lenguaje llano y coloquial, los términos y alcances de las principales cuestiones que rigen la contratación",
        "tipo": "presentacion_informativa"
      }
    },
    {
      "local_id": "rest1",
      "type": "Restriccion",
      "label": "Prohibición de cobro sin servicio solicitado",
      "properties": {
        "descripcion": "La aplicación de comisiones y/o cargos debe quedar circunscripta a la efectiva prestación de un servicio que haya sido previamente solicitado, pactado y/o autorizado por el usuario",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest2",
      "type": "Restriccion",
      "label": "Límite de cargos transferidos al costo",
      "properties": {
        "descripcion": "El importe de los cargos que el sujeto obligado transfiera a los usuarios no podrá ser superior al que el tercero prestador perciba de particulares, sin intermediarios y en similares condiciones",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest3",
      "type": "Restriccion",
      "label": "Comisiones deben tener origen en costo real",
      "properties": {
        "descripcion": "Todas las comisiones, cargos, costos, gastos, seguros y/o cualquier otro concepto –excluyendo la tasa de interés– que los sujetos obligados perciban o pretendan percibir de los usuarios de servicios financieros deben tener origen en un costo real, directo y demostrable y estar debidamente justificados desde el punto de vista técnico y económico",
        "tipo": "limite_cualitativo"
      }
    },
    {
      "local_id": "rest4",
      "type": "Restriccion",
      "label": "Prohibición de comisiones en precancelación total",
      "properties": {
        "descripcion": "En el caso de precancelación total, no se admitirá la aplicación de comisiones cuando al momento de efectuarla haya transcurrido al menos la cuarta parte del plazo original de la financiación o 180 días corridos desde su otorgamiento, de ambos el mayor",
        "tipo": "prohibicion"
      }
    },
    {
      "local_id": "rest5",
      "type": "Restriccion",
      "label": "Prohibición de cobro sin condiciones",
      "properties": {
        "descripcion": "No corresponde el cobro a los usuarios de conceptos que no observen las condiciones enunciadas en el punto 2.3.2.1. y/o que deriven de la prestación de un servicio cuya comisión o cargo, según corresponda, ya se encuentre incluida en otros conceptos cobrados",
        "tipo": "prohibicion"
      }
    }
  ],
