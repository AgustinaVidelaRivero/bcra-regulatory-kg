      "label": "Información del usuario en presentación",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Indicar nombre, apellido, número de documento de identificación válido, número de identificación fiscal, domicilio real y constituido del usuario y su representante o apoderado, teléfono y dirección de correo electrónico de contacto"
      }
    },
    {
      "local_id": "e5",
      "type": "Obligacion",
      "label": "Documentación de identificación",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Adjuntar copia simple o imagen del documento de identificación del presentante y, si corresponde, del instrumento que acredite la condición de representante legal o apoderado"
      }
    },
    {
      "local_id": "e6",
      "type": "Obligacion",
      "label": "Relato claro del reclamo",
      "properties": {
        "tipo": "presentacion_informativa",
        "description": "Relatar en forma clara y precisa los hechos y el reclamo efectuado a la entidad"
      }
    },
    {
