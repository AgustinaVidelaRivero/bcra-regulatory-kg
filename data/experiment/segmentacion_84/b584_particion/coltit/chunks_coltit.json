 {
  "id": "coltit::2.1",
  "to": "coltit",
  "archivo": "coltit.pdf",
  "unidad": "2.1",
  "titulo": "Autorización general.",
  "tipo": "punto_terminal",
  "paginas": [
   8
  ],
  "texto": "2.1. Autorización general.\nLos bancos hipotecarios, las compañías financieras, las sociedades de ahorro y préstamo para\nla vivienda u otros inmuebles y las cajas de crédito se encuentran autorizados a obtener líneas\nde crédito de exterior.\nLos bancos comerciales realizan esas operaciones en virtud de lo establecido en el artículo 21\nde la Ley de Entidades Financieras.",
  "chars_propio": 370,
  "chars_completo": 413,
  "herencia": [
   {
    "tipo": "encabezado",
    "unidad_origen": "S2",
