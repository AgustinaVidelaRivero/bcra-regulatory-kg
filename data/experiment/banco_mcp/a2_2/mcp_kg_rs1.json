{
  "mcpServers": {
    "kg": {
      "type": "stdio",
      "command": "${BANCO_PYTHON_KG}",
      "args": ["-B", "${BANCO_REPO}/data/experiment/banco_mcp/mcp_kg/servidor_mcp_kg.py",
               "--config", "${BANCO_REPO}/data/experiment/banco_mcp/mcp_kg/config_mcp_kg_a2_desarrollo_r2b_rs1.json"],
      "env": {
        "BANCO_LOG_R1": "${BANCO_LOG_R1}",
        "BANCO_SESION_TAG": "${BANCO_SESION_TAG:-sin_tag}",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
