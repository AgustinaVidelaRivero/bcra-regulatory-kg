 },
 "implementacion": {
  "el_archivo_de_anclas": "por pregunta, las unidades de todas sus anclas, en el orden de sus anclas y sin repetir",
  "el_control_del_rearmado": "en cada sesión, el rearmado tiene que dar el indicador 3 y la cuenta de unidades con cita del instrumento; en las preguntas sin rango, además, su columna informativa. Si alguna no da, la columna informativa se declara sin calcular para las preguntas con un rango, y se informa la del instrumento para las demás",
  "el_instrumento": "analizar_b63.exactitud_de_cita del código sellado, llamada tal cual con las preguntas de la regla y sin las sesiones de las que salen",
  "la_columna_informativa": "por sesión: sin JSON final o sin citas, el valor del instrumento; si no, «si» si cada ancla original tiene alguna cita parseable (partir_cita) que da en alguna de sus unidades (U2.es_ancla_o_descendiente sobre las unidades leídas por parsear_anclas), y «no» si no; los agregados, con agregar del instrumento",
  "las_que_salen": "una pregunta con alguna unidad que el instrumento no lee sale entera, con todas sus sesiones; se declara por su posición en ids_en_orden de la entrada (desde 1) y por brazo (sus sesiones)",
  "rango": "una pregunta tiene un rango si alguna de sus anclas trae «..» en su unidad",
  "unidades": "cada ancla, por analizar_b63.expandir sobre analizar_b63.arbol_e0 de la estructura de su TO (su sha256, el del armado de la E0); cada unidad que resulta va como «to::unidad» y se controla con parsear_anclas del instrumento, de a una"
 },
