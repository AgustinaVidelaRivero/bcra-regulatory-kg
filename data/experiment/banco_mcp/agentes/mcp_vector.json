{
  "mcpServers": {
    "vector": {
      "type": "stdio",
      "timeout": 600000,
      "command": "${BANCO_VENV_VECTOR}/bin/python",
      "args": ["-B", "${BANCO_REPO}/data/experiment/banco_mcp/mcp_vector/servidor_mcp_vector.py",
               "--config", "${BANCO_REPO}/data/experiment/banco_mcp/mcp_vector/config_mcp_vector.json"],
      "env": {
        "BANCO_LOG_R1": "${BANCO_LOG_R1}",
        "BANCO_SESION_TAG": "${BANCO_SESION_TAG:-sin_tag}",
        "HF_HUB_OFFLINE": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
