{
  "mcpServers": {
    "kg": {
      "type": "stdio",
      "timeout": 600000,
      "command": "${BANCO_VENV_VECTOR}/bin/python",
      "args": ["-B", "${BANCO_REPO}/data/experiment/banco_mcp/b63/seco/servidor_mcp_juguete.py",
               "--tipo", "kg", "--config", "${BANCO_REPO}/data/experiment/banco_mcp/b64/v1/seco/config_servidor_juguete_kg_n7.json"],
      "env": {
        "BANCO_LOG_R1": "${BANCO_LOG_R1}",
        "BANCO_SESION_TAG": "${BANCO_SESION_TAG:-sin_tag}",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
