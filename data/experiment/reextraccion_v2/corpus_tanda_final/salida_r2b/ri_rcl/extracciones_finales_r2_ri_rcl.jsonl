xacta"}, "properties": {"tipo": "limite_cualitativo", "descripcion": "Los valores diarios resultantes del cálculo del RCL se consignarán con dos decimales", "umbrales": [{"tramo": "con dos decimales", "comparacion": "no_determinada", "regla_comparacion": "limite_relativo:sin_marcador", "origen": "e1", "tramo_verificado": "exacta"}]}, "umbrales_tramos": ["con dos decimales"], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e10", "type": "Obligacion", "label": "Reiteración valor día anterior sin novedades", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "En los días en que no se registren novedades se reiterará el valor del día inmediato anterior.", "tramo_verificado": "exacta"}, "properties": {"tipo": "presentacion_informativa", "descripcion": "En los días sin novedades se reitera el valor del día inmediato anterior"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e11", "type": "Obligacion", "label": "Observancia normas RCL punto 1.5.2", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "Sin perjuicio del cumplimiento de este régimen informativo, deberá observarse lo prescripto en el punto 1.5.2. de las normas sobre Ratio de cobertura de liquidez en cuanto a su empleo en forma continua para contribuir con el seguimiento y control del riesgo de liquidez", "tramo_verificado": "exacta"}, "properties": {"tipo": "otra", "descripcion": "Deber de observar lo prescripto en el punto 1.5.2 de las normas sobre Ratio de cobertura de liquidez en cuanto a su empleo en forma continua para contribuir con el seguimiento y co