{"chunk_id": "ri_rcl::1.2", "to": "ri_rcl", "archivo": "ri_rcl.pdf", "e0_sha256_completo": "9b41fcda81922e7a8508f9b3d66086212a6f46842fc39d4b3e3d7c1b8c22c627", "error": null, "estado_e3": "completo_ok_directo", "validacion": {"chunk_id": "ri_rcl::1.2", "perfil": "r2", "forma_entrada": "r2", "politica_sha256": "82e8752aea1d6ad869d6023d303c0af45182dd9333753681787d7a581ef6d00b", "entidades": [{"local_id": "to", "type": "TextoOrdenado", "label": "Ratio de Cobertura de Liquidez", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio"}, "properties": {}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e1", "type": "Operacion", "label": "Cálculo RCL pesos y moneda extranjera", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "Se informarán los valores que se determinen en cada uno de los días del mes al que corresponda la información tanto en pesos como en moneda extranjera, calculados de acuerdo con las disposiciones contenidas en las Normas sobre Ratio de Cobertura de Liquidez.", "tramo_verificado": "exacta"}, "properties": {"tipo": "cálculo de ratio de cobertura de liquidez", "descripcion": "Cálculo diario del Ratio de Cobertura de Liquidez (RCL) en pesos y moneda extranjera conforme a las Normas sobre Ratio de Cobertura de Liquidez"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e2", "type": "Obligacion", "label": "Informar RCL valores diarios", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "Se informarán los valores que se determinen en cada uno de los días del mes al que corresponda la información tanto en pesos como en moneda extranjera", "tramo_verificado": "exacta"}, "properties": {"tipo": "presentacion_informativa", "descripcion": "Deber de informar los valores del RCL determinados en cada día del mes, tanto en pesos como en moneda extranjera", "frecuencia": "diaria"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e3", "type": "Obligacion", "label": "Conversión diaria moneda extranjera a pesos", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "Los importes en moneda extranjera se convertirán diariamente a pesos utilizando el tipo de cambio de referencia publicado por el BCRA para el dólar estadounidense, previa aplicación del tipo de pase correspondiente para las otras monedas comunicado por la Mesa de Operaciones de esta Institución.", "tramo_verificado": "exacta"}, "properties": {"tipo": "calculo", "descripcion": "Conversión diaria de importes en moneda extranjera a pesos usando el tipo de cambio de referencia del BCRA para USD y el tipo de pase de la Mesa de Operaciones para otras monedas", "frecuencia": "diaria"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {"frecuencia": "diariamente"}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e4", "type": "Obligacion", "label": "Cálculo base individual", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "El cálculo se efectuará sobre: - Base individual (entidad financiera y sucursales en el país únicamente, conforme lo establecido en el punto 8.1. de las normas sobre Ratio de cobertura de liquidez)", "tramo_verificado": "exacta"}, "properties": {"tipo": "calculo", "descripcion": "Cálculo del RCL sobre base individual considerando la entidad financiera y sus sucursales en el país únicamente, conforme al punto 8.1 de las normas sobre Ratio de cobertura de liquidez"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e5", "type": "Obligacion", "label": "Cálculo base consolidada mensual", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "El cálculo se efectuará sobre: - Base consolidada mensual, considerando las disposiciones específicas en materia de subsidiarias significativas contenidas en el punto 8.2. de las citadas normas.", "tramo_verificado": "no"}, "properties": {"tipo": "calculo", "descripcion": "Cálculo del RCL sobre base consolidada mensual considerando las disposiciones específicas sobre subsidiarias significativas del punto 8.2 de las normas sobre Ratio de cobertura de liquidez"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"local_id": "e6", "type": "Definicion", "label": "Nivel consolidación 0", "punto": "1.2", "provenance": {"to": "ri_rcl", "archivo": "ri_rcl.pdf", "punto": "1.2", "rol_documental": "punto_propio", "tramo": "Nivel de consolidación: 0 = Casa central y sucursales en el país", "tramo_verificado": "exacta", "termino_verificado": "exacta"}, "properties": {"termino": "Nivel de consolidación 0", "descripcion": "Casa central y sucursales en el país"}, "umbrales_tramos": [], "fuera_de_lista": [], "originales": {}, "properties_no_definidas": {}, "campos_heredados_v3": {}, "valores_no_tipados": {}, "campos_no_definidos": {}, "paso_por_e3": true}, {"loca